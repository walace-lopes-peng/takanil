PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Schema do PostgreSQL para isolamento de dados:
# - 'public' para ambiente local e preview (desenvolvimento/testes)
# - 'piloto' para ambiente de produção (dados reais da ONG)
PUBLIC_SUPABASE_SCHEMA=public
