---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hub Takanil - Moderação e Aprovações">
  <div class="space-y-6 pb-20">
    <!-- Header -->
    <div class="bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200/80 rounded-2xl p-5 sm:p-6 shadow-sm mt-4">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-2xl">🛎️</span>
        <h1 class="text-lg sm:text-xl font-bold text-amber-900">Moderação de Cadastros</h1>
      </div>
      <p class="text-xs sm:text-sm text-amber-800">
        Analise os cadastros sugeridos pela comunidade. Aprove para publicar no mural público ou gerencie a lixeira para manter o aplicativo organizado.
      </p>
    </div>

    <!-- Navegação por Abas (Pendentes vs Rejeitados) -->
    <div class="flex border-b border-gray-200 gap-2">
      <button
        id="abaPendentesBtn"
        type="button"
        class="flex items-center gap-2 px-4 py-3 font-semibold text-sm border-b-2 border-taka-green-600 text-taka-green-700 transition-colors min-h-[44px]"
        aria-label="Ver cadastros pendentes de aprovação"
      >
        <span>⏳ Pendentes</span>
        <span id="badgeContadorPendentes" class="bg-amber-100 text-amber-800 text-xs font-bold px-2.5 py-0.5 rounded-full">0</span>
      </button>

      <button
        id="abaRejeitadosBtn"
        type="button"
        class="flex items-center gap-2 px-4 py-3 font-semibold text-sm border-b-2 border-transparent text-gray-500 hover:text-gray-800 transition-colors min-h-[44px]"
        aria-label="Ver cadastros rejeitados na lixeira"
      >
        <span>🗑️ Rejeitados</span>
        <span id="badgeContadorRejeitados" class="bg-gray-200 text-gray-700 text-xs font-bold px-2.5 py-0.5 rounded-full">0</span>
      </button>
    </div>

    <!-- Seção: Pendentes -->
    <div id="secaoPendentes" class="space-y-4">
      <div class="flex justify-between items-center">
        <h2 class="text-sm font-bold text-gray-800">Aguardando Revisão</h2>
        <span class="text-xs text-gray-500" id="subtituloPendentes">0 pendências</span>
      </div>

      <div id="listaPendentes" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="col-span-full text-center py-8 text-gray-400 text-sm" id="loadingStatePendentes">
          <svg class="animate-spin mx-auto h-8 w-8 text-taka-green-500 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Carregando cadastros...
        </div>
      </div>
    </div>

    <!-- Seção: Rejeitados / Lixeira -->
    <div id="secaoRejeitados" class="space-y-4 hidden">
      <!-- Banner de Limpeza em Lote -->
      <div id="bannerLoteRejeitados" class="bg-red-50 border border-red-200 rounded-2xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-xs">
        <div>
          <h3 class="text-sm font-bold text-red-900 flex items-center gap-1.5">
            <span>🗑️</span> Lixeira de Cadastros
          </h3>
          <p class="text-xs text-red-700 mt-0.5" id="infoRejeitadosTexto">
            Existem cadastros na lixeira. Você pode restaurá-los a qualquer momento ou esvaziar tudo para liberar espaço no aplicativo.
          </p>
        </div>
        <button
          id="btnEsvaziarRejeitados"
          type="button"
          class="shrink-0 w-full sm:w-auto bg-red-600 hover:bg-red-700 active:scale-95 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition-all shadow-sm flex items-center justify-center gap-1.5 min-h-[44px]"
          aria-label="Apagar permanentemente todos os cadastros da lixeira"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          <span>Esvaziar Toda a Lixeira</span>
        </button>
      </div>

      <div class="flex justify-between items-center">
        <h2 class="text-sm font-bold text-gray-800">Cadastros na Lixeira</h2>
        <span class="text-xs text-gray-500" id="subtituloRejeitados">0 cadastros</span>
      </div>

      <div id="listaRejeitados" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Inserido via JS -->
      </div>
    </div>
  </div>

  <!-- Modal Nativo de Imagem em Tela Cheia -->
  <div
    id="imageModal"
    class="fixed inset-0 z-50 bg-black/90 hidden flex flex-col items-center justify-center p-4 cursor-zoom-out transition-opacity"
  >
    <button
      id="fecharImageModalBtn"
      aria-label="Fechar foto ampliada"
      class="absolute top-4 right-4 text-white/80 hover:text-white p-2 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-full bg-black/40 backdrop-blur-md"
    >
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <img id="modalImage" src="" class="max-w-full max-h-[85vh] object-contain rounded-2xl shadow-2xl" alt="Foto ampliada">
  </div>
</Layout>

<script>
  import { supabase, getUserRole } from '../lib/supabaseClient';

  // Elementos do DOM
  const abaPendentesBtn = document.getElementById('abaPendentesBtn');
  const abaRejeitadosBtn = document.getElementById('abaRejeitadosBtn');
  const secaoPendentes = document.getElementById('secaoPendentes');
  const secaoRejeitados = document.getElementById('secaoRejeitados');
  const badgeContadorPendentes = document.getElementById('badgeContadorPendentes');
  const badgeContadorRejeitados = document.getElementById('badgeContadorRejeitados');
  const subtituloPendentes = document.getElementById('subtituloPendentes');
  const subtituloRejeitados = document.getElementById('subtituloRejeitados');
  const listaPendentes = document.getElementById('listaPendentes');
  const listaRejeitados = document.getElementById('listaRejeitados');
  const loadingStatePendentes = document.getElementById('loadingStatePendentes');
  const bannerLoteRejeitados = document.getElementById('bannerLoteRejeitados');
  const infoRejeitadosTexto = document.getElementById('infoRejeitadosTexto');
  const btnEsvaziarRejeitados = document.getElementById('btnEsvaziarRejeitados');

  // Modal de imagem
  const imageModal = document.getElementById('imageModal');
  const modalImage = document.getElementById('modalImage') as HTMLImageElement;
  const fecharImageModalBtn = document.getElementById('fecharImageModalBtn');

  // Estado das listas
  let listaAnimaisPendentes: any[] = [];
  let listaAnimaisRejeitados: any[] = [];

  // Proteção de rota
  async function checkAuth() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = '/login';
      return false;
    }
    const role = await getUserRole();
    if (role !== 'adm' && role !== 'dev') {
      window.location.href = '/';
      return false;
    }
    return true;
  }

  // Alternar abas
  function alternarAba(aba: 'pendentes' | 'rejeitados') {
    if (aba === 'pendentes') {
      secaoPendentes?.classList.remove('hidden');
      secaoRejeitados?.classList.add('hidden');

      abaPendentesBtn?.classList.remove('border-transparent', 'text-gray-500');
      abaPendentesBtn?.classList.add('border-taka-green-600', 'text-taka-green-700');

      abaRejeitadosBtn?.classList.remove('border-red-600', 'text-red-700');
      abaRejeitadosBtn?.classList.add('border-transparent', 'text-gray-500');
    } else {
      secaoPendentes?.classList.add('hidden');
      secaoRejeitados?.classList.remove('hidden');

      abaRejeitadosBtn?.classList.remove('border-transparent', 'text-gray-500');
      abaRejeitadosBtn?.classList.add('border-red-600', 'text-red-700');

      abaPendentesBtn?.classList.remove('border-taka-green-600', 'text-taka-green-700');
      abaPendentesBtn?.classList.add('border-transparent', 'text-gray-500');
    }
  }

  abaPendentesBtn?.addEventListener('click', () => alternarAba('pendentes'));
  abaRejeitadosBtn?.addEventListener('click', () => alternarAba('rejeitados'));

  // Ampliar foto
  (window as any).ampliarFoto = (src: string) => {
    if (!src || !imageModal || !modalImage) return;
    modalImage.src = src;
    imageModal.classList.remove('hidden');
  };

  function fecharModalFoto() {
    imageModal?.classList.add('hidden');
  }

  fecharImageModalBtn?.addEventListener('click', fecharModalFoto);
  imageModal?.addEventListener('click', (e) => {
    if (e.target === imageModal) fecharModalFoto();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') fecharModalFoto();
  });

  // Extrai nome do arquivo para deletar imagem do storage
  function extrairNomeArquivoStorage(url: string): string | null {
    if (!url) return null;
    try {
      const parts = url.split('/');
      const lastPart = parts[parts.length - 1];
      return lastPart ? decodeURIComponent(lastPart.split('?')[0]) : null;
    } catch {
      return null;
    }
  }

  // Ação: Aprovar
  (window as any).aprovarAnimal = async (id: string, nome: string) => {
    const confirmou = await (window as any).confirmarAcao({
      titulo: 'Aprovar cadastro?',
      mensagem: `Deseja aprovar o cadastro de "${nome}"? O animal ficará visível publicamente na página inicial.`,
      textoConfirmar: 'Sim, Aprovar',
      tipo: 'padrao'
    });
    if (!confirmou) return;

    try {
      const { error } = await supabase
        .from('animais')
        .update({ status_moderacao: 'aprovado' })
        .eq('id', id);

      if (error) throw error;
      await carregarDados();
      (window as any).mostrarToast(`Cadastro de "${nome}" aprovado com sucesso!`, 'sucesso');
    } catch (err) {
      console.error(err);
      (window as any).mostrarToast('Não foi possível aprovar o cadastro no momento.', 'erro');
    }
  };

  // Ação: Descartar (Mover para Rejeitados)
  (window as any).descartarAnimal = async (id: string, nome: string) => {
    const confirmou = await (window as any).confirmarAcao({
      titulo: 'Mover para a lixeira?',
      mensagem: `Deseja mover o cadastro de "${nome}" para a lixeira?`,
      textoConfirmar: 'Mover para Lixeira',
      tipo: 'perigo'
    });
    if (!confirmou) return;

    try {
      const { error } = await supabase
        .from('animais')
        .update({ status_moderacao: 'rejeitado' })
        .eq('id', id);

      if (error) throw error;
      await carregarDados();
      (window as any).mostrarToast(`Cadastro de "${nome}" movido para a lixeira.`, 'info');
    } catch (err) {
      console.error(err);
      (window as any).mostrarToast('Não foi possível mover o cadastro para a lixeira.', 'erro');
    }
  };

  // Ação: Restaurar (volta para Pendente)
  (window as any).restaurarAnimal = async (id: string, nome: string) => {
    const confirmou = await (window as any).confirmarAcao({
      titulo: 'Restaurar cadastro?',
      mensagem: `Deseja restaurar "${nome}" de volta para a fila de aprovações pendentes?`,
      textoConfirmar: 'Sim, Restaurar',
      tipo: 'padrao'
    });
    if (!confirmou) return;

    try {
      const { error } = await supabase
        .from('animais')
        .update({ status_moderacao: 'pendente' })
        .eq('id', id);

      if (error) throw error;
      await carregarDados();
      (window as any).mostrarToast(`Cadastro de "${nome}" restaurado com sucesso!`, 'sucesso');
    } catch (err) {
      console.error(err);
      (window as any).mostrarToast('Não foi possível restaurar o cadastro.', 'erro');
    }
  };

  // Ação: Excluir Definitivo Individual (Apagar foto e registro sem termos técnicos)
  (window as any).excluirDefinitivo = async (id: string, nome: string, imagem_url?: string) => {
    const confirmou = await (window as any).confirmarAcao({
      titulo: 'Apagar para sempre?',
      mensagem: `Tem certeza que deseja apagar o cadastro de "${nome}" para sempre? Esta ação apagará a foto e todos os dados definitivamente.`,
      textoConfirmar: 'Apagar Para Sempre',
      tipo: 'perigo'
    });
    if (!confirmou) return;

    try {
      // 1. Deletar foto
      if (imagem_url) {
        const fileName = extrairNomeArquivoStorage(imagem_url);
        if (fileName) {
          await supabase.storage.from('animais').remove([fileName]);
        }
      }

      // 2. Deletar registro
      const { error } = await supabase
        .from('animais')
        .delete()
        .eq('id', id);

      if (error) throw error;
      await carregarDados();
      (window as any).mostrarToast(`Cadastro de "${nome}" apagado definitivamente!`, 'sucesso');
    } catch (err) {
      console.error(err);
      (window as any).mostrarToast('Não foi possível apagar o cadastro.', 'erro');
    }
  };

  // Ação: Esvaziar Todos os Rejeitados em Lote
  btnEsvaziarRejeitados?.addEventListener('click', async () => {
    if (listaAnimaisRejeitados.length === 0) return;

    const total = listaAnimaisRejeitados.length;
    const confirmou = await (window as any).confirmarAcao({
      titulo: 'Esvaziar toda a lixeira?',
      mensagem: `Deseja apagar definitivamente todos os ${total} cadastros da lixeira e liberar o espaço das fotos no aplicativo? Esta ação não pode ser desfeita.`,
      textoConfirmar: `Sim, Esvaziar (${total})`,
      tipo: 'perigo'
    });
    if (!confirmou) return;

    try {
      // 1. Coletar fotos para deletar
      const fileNamesParaDeletar: string[] = [];
      listaAnimaisRejeitados.forEach((animal) => {
        if (animal.imagem_url) {
          const fn = extrairNomeArquivoStorage(animal.imagem_url);
          if (fn) fileNamesParaDeletar.push(fn);
        }
      });

      if (fileNamesParaDeletar.length > 0) {
        await supabase.storage.from('animais').remove(fileNamesParaDeletar);
      }

      // 2. Deletar cadastros
      const { error } = await supabase
        .from('animais')
        .delete()
        .eq('status_moderacao', 'rejeitado');

      if (error) throw error;
      await carregarDados();
      (window as any).mostrarToast(`Todos os ${total} cadastros foram apagados e o espaço foi liberado!`, 'sucesso');
    } catch (err) {
      console.error(err);
      (window as any).mostrarToast('Não foi possível esvaziar a lixeira no momento.', 'erro');
    }
  });

  // Renderiza a lista de Pendentes com ficha completa
  function renderizarPendentes() {
    if (!listaPendentes) return;

    if (listaAnimaisPendentes.length === 0) {
      listaPendentes.innerHTML = `
        <div class="col-span-full text-center py-10 bg-white rounded-2xl border border-gray-100 flex flex-col items-center justify-center shadow-xs">
          <span class="text-4xl mb-3">🎉</span>
          <h3 class="text-base font-bold text-gray-800">Tudo limpo por aqui!</h3>
          <p class="text-xs text-gray-500 mt-1">Nenhum animal aguardando moderação no momento.</p>
          <a href="/" class="mt-4 inline-flex items-center gap-1 text-xs text-taka-green-600 font-bold hover:underline min-h-[44px] px-3 py-2">
            Voltar ao Início
          </a>
        </div>`;
      return;
    }

    let html = '';
    listaAnimaisPendentes.forEach((animal) => {
      const dataEnvio = new Date(animal.created_at).toLocaleDateString('pt-BR');
      const pesoFormatado = animal.peso ? `${animal.peso}kg` : 'Peso não informado';
      const faseVidaFormatada = animal.fase_vida || 'Idade não informada';
      const observacao = animal.observacoes || animal.descricao || '';

      html += `
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden flex flex-col justify-between">
          <div class="p-4 space-y-3">
            <!-- Cabeçalho do Card: Foto Compacta e Dados Principais -->
            <div class="flex gap-3.5 items-start">
              <div
                class="relative w-20 h-20 sm:w-24 sm:h-24 aspect-square shrink-0 rounded-2xl overflow-hidden bg-gray-100 cursor-pointer group shadow-xs"
                onclick="ampliarFoto('${animal.imagem_url || ''}')"
                title="Toque para ampliar a foto"
              >
                <img
                  src="${animal.imagem_url || '/assets/placeholder-pet.png'}"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                  alt="${animal.nome || 'Animal'}"
                />
                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                  <span class="text-white text-[10px] font-bold bg-black/60 px-1.5 py-0.5 rounded">🔍 Zoom</span>
                </div>
              </div>

              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-1">
                  <h3 class="text-base sm:text-lg font-bold text-gray-900 truncate">${animal.nome || 'Sem nome'}</h3>
                  <span class="text-[11px] text-gray-400 shrink-0">📅 ${dataEnvio}</span>
                </div>
                <p class="text-xs font-medium text-gray-700 mt-0.5">
                  ${animal.especie || 'Animal'} • ${animal.sexo || 'Sexo não informado'} • ${faseVidaFormatada}
                </p>
                <p class="text-xs text-gray-500 mt-0.5">
                  ⚖️ ${pesoFormatado}
                </p>
                <p class="text-xs font-semibold text-taka-green-700 mt-1 truncate">
                  📍 ${animal.localizacao || 'Passa Quatro/MG'}
                </p>
              </div>
            </div>

            <!-- Ficha Clínica: Badges de Castrado e Vacinado -->
            <div class="flex flex-wrap items-center gap-1.5 pt-1">
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold ${animal.castrado ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-gray-100 text-gray-600 border border-gray-200'}">
                ${animal.castrado ? '✅ Castrado(a)' : '❌ Não castrado'}
              </span>
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold ${animal.vacinado ? 'bg-blue-50 text-blue-800 border border-blue-200' : 'bg-gray-100 text-gray-600 border border-gray-200'}">
                ${animal.vacinado ? '✅ Vacinado(a)' : '❌ Não vacinado'}
              </span>
            </div>

            <!-- Observações (se houver) -->
            ${observacao ? `
              <div class="bg-gray-50 rounded-xl p-2.5 border border-gray-100 text-xs text-gray-700">
                <span class="font-bold text-gray-800">📝 Detalhes:</span> ${observacao}
              </div>
            ` : ''}
          </div>

          <!-- Ações do Card -->
          <div class="bg-gray-50/80 px-4 py-3 border-t border-gray-100 flex items-center justify-end gap-2.5">
            <button
              onclick="descartarAnimal('${animal.id}', '${animal.nome || 'Animal'}')"
              class="px-4 py-2.5 text-xs font-semibold text-red-600 hover:text-red-800 hover:bg-red-50 rounded-xl transition-colors min-h-[44px] flex items-center justify-center"
              aria-label="Descartar cadastro de ${animal.nome}"
            >
              Mover para Lixeira
            </button>
            <button
              onclick="aprovarAnimal('${animal.id}', '${animal.nome || 'Animal'}')"
              class="px-5 py-2.5 text-xs font-bold text-white bg-taka-green-600 hover:bg-taka-green-700 active:scale-95 rounded-xl transition-all shadow-sm min-h-[44px] flex items-center justify-center gap-1.5"
              aria-label="Aprovar cadastro de ${animal.nome}"
            >
              <span>✅ Aprovar Cadastro</span>
            </button>
          </div>
        </div>
      `;
    });

    listaPendentes.innerHTML = html;
  }

  // Renderiza a lista de Rejeitados com ficha completa
  function renderizarRejeitados() {
    if (!listaRejeitados) return;

    if (listaAnimaisRejeitados.length === 0) {
      bannerLoteRejeitados?.classList.add('hidden');
      listaRejeitados.innerHTML = `
        <div class="col-span-full text-center py-10 bg-white rounded-2xl border border-gray-100 flex flex-col items-center justify-center shadow-xs">
          <span class="text-4xl mb-3">✨</span>
          <h3 class="text-base font-bold text-gray-800">Lixeira vazia!</h3>
          <p class="text-xs text-gray-500 mt-1">Nenhum cadastro na lixeira ocupando espaço.</p>
        </div>`;
      return;
    }

    bannerLoteRejeitados?.classList.remove('hidden');
    if (infoRejeitadosTexto) {
      infoRejeitadosTexto.textContent = `${listaAnimaisRejeitados.length} cadastros na lixeira. Você pode restaurá-los a qualquer momento ou esvaziar tudo para liberar espaço.`;
    }

    let html = '';
    listaAnimaisRejeitados.forEach((animal) => {
      const dataEnvio = new Date(animal.created_at).toLocaleDateString('pt-BR');
      const pesoFormatado = animal.peso ? `${animal.peso}kg` : 'Peso não informado';
      const faseVidaFormatada = animal.fase_vida || 'Idade não informada';
      const observacao = animal.observacoes || animal.descricao || '';

      html += `
        <div class="bg-white rounded-2xl shadow-sm border border-red-100 overflow-hidden flex flex-col justify-between">
          <div class="p-4 space-y-3">
            <!-- Cabeçalho do Card: Foto Compacta e Dados Principais -->
            <div class="flex gap-3.5 items-start">
              <div
                class="relative w-20 h-20 sm:w-24 sm:h-24 aspect-square shrink-0 rounded-2xl overflow-hidden bg-gray-100 cursor-pointer group shadow-xs border border-red-100"
                onclick="ampliarFoto('${animal.imagem_url || ''}')"
                title="Toque para ampliar a foto"
              >
                <img
                  src="${animal.imagem_url || '/assets/placeholder-pet.png'}"
                  class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all"
                  alt="${animal.nome || 'Animal'}"
                />
                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                  <span class="text-white text-[10px] font-bold bg-black/60 px-1.5 py-0.5 rounded">🔍 Zoom</span>
                </div>
              </div>

              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-1">
                  <h3 class="text-base sm:text-lg font-bold text-gray-900 truncate">${animal.nome || 'Sem nome'}</h3>
                  <span class="bg-red-100 text-red-700 text-[10px] font-bold px-2 py-0.5 rounded-full shrink-0">Rejeitado</span>
                </div>
                <p class="text-xs font-medium text-gray-700 mt-0.5">
                  ${animal.especie || 'Animal'} • ${animal.sexo || 'Sexo não informado'} • ${faseVidaFormatada}
                </p>
                <p class="text-xs text-gray-500 mt-0.5">
                  ⚖️ ${pesoFormatado}
                </p>
                <div class="flex items-center justify-between gap-2 mt-1">
                  <p class="text-xs font-semibold text-taka-green-700 truncate">
                    📍 ${animal.localizacao || 'Passa Quatro/MG'}
                  </p>
                  <span class="text-[11px] text-gray-400 shrink-0">📅 ${dataEnvio}</span>
                </div>
              </div>
            </div>

            <!-- Ficha Clínica: Badges de Castrado e Vacinado -->
            <div class="flex flex-wrap items-center gap-1.5 pt-1">
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold ${animal.castrado ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-gray-100 text-gray-600 border border-gray-200'}">
                ${animal.castrado ? '✅ Castrado(a)' : '❌ Não castrado'}
              </span>
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold ${animal.vacinado ? 'bg-blue-50 text-blue-800 border border-blue-200' : 'bg-gray-100 text-gray-600 border border-gray-200'}">
                ${animal.vacinado ? '✅ Vacinado(a)' : '❌ Não vacinado'}
              </span>
            </div>

            <!-- Observações (se houver) -->
            ${observacao ? `
              <div class="bg-red-50/50 rounded-xl p-2.5 border border-red-100 text-xs text-gray-700">
                <span class="font-bold text-gray-800">📝 Detalhes:</span> ${observacao}
              </div>
            ` : ''}
          </div>

          <!-- Ações do Card -->
          <div class="bg-gray-50/80 px-4 py-3 border-t border-gray-100 flex items-center justify-between gap-2.5">
            <button
              onclick="restaurarAnimal('${animal.id}', '${animal.nome || 'Animal'}')"
              class="px-3.5 py-2.5 text-xs font-semibold text-taka-green-700 hover:bg-taka-green-50 rounded-xl transition-colors min-h-[44px] flex items-center gap-1.5"
              aria-label="Restaurar cadastro de ${animal.nome}"
            >
              <span>♻️ Restaurar</span>
            </button>
            <button
              onclick="excluirDefinitivo('${animal.id}', '${animal.nome || 'Animal'}', '${animal.imagem_url || ''}')"
              class="px-4 py-2.5 text-xs font-bold text-red-600 hover:text-white hover:bg-red-600 rounded-xl transition-all border border-red-200 hover:border-transparent min-h-[44px] flex items-center gap-1.5 shadow-xs"
              aria-label="Apagar cadastro de ${animal.nome} para sempre"
            >
              <span>❌ Apagar Para Sempre</span>
            </button>
          </div>
        </div>
      `;
    });

    listaRejeitados.innerHTML = html;
  }

  // Carrega os dados do Supabase
  async function carregarDados() {
    try {
      const { data, error } = await supabase
        .from('animais')
        .select('*')
        .in('status_moderacao', ['pendente', 'rejeitado'])
        .order('created_at', { ascending: false });

      if (error) throw error;

      listaAnimaisPendentes = (data || []).filter((a) => a.status_moderacao === 'pendente');
      listaAnimaisRejeitados = (data || []).filter((a) => a.status_moderacao === 'rejeitado');

      // Atualiza badges e contadores
      if (badgeContadorPendentes) badgeContadorPendentes.textContent = listaAnimaisPendentes.length.toString();
      if (badgeContadorRejeitados) badgeContadorRejeitados.textContent = listaAnimaisRejeitados.length.toString();
      if (subtituloPendentes) subtituloPendentes.textContent = `${listaAnimaisPendentes.length} pendências`;
      if (subtituloRejeitados) subtituloRejeitados.textContent = `${listaAnimaisRejeitados.length} cadastros`;

      if (loadingStatePendentes) loadingStatePendentes.style.display = 'none';

      renderizarPendentes();
      renderizarRejeitados();
    } catch (err) {
      console.error('Erro ao carregar dados de moderação:', err);
      if (loadingStatePendentes) {
        loadingStatePendentes.innerHTML = '<span class="text-red-500 font-medium">Não foi possível carregar os cadastros no momento.</span>';
      }
    }
  }

  // Inicialização
  checkAuth().then((autenticado) => {
    if (autenticado) carregarDados();
  });
</script>
