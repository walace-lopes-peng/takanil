---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hub Takanil - Aprovações">
  <div class="space-y-6 pb-20">
    <!-- Header -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-6 shadow-sm mt-4">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-2xl">🛎️</span>
        <h2 class="text-lg font-bold text-yellow-800">Aprovações Pendentes</h2>
      </div>
      <p class="text-sm text-yellow-700">Analise os animais enviados pela comunidade. Você pode aprovar para publicar na vitrine ou descartar se for spam.</p>
    </div>

    <!-- Lista de Pendentes -->
    <div>
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-md font-bold text-gray-800">Aguardando Revisão</h3>
        <span class="bg-yellow-200 text-yellow-800 text-xs font-bold px-2 py-1 rounded-full" id="totalPendentes">0</span>
      </div>
      
      <div id="listaPendentes" class="space-y-4">
        <div class="text-center py-8 text-gray-400 text-sm" id="loadingState">
          <svg class="animate-spin mx-auto h-8 w-8 text-gray-300 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Carregando pendências...
        </div>
        <!-- Inserido via JS -->
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase, getUserRole } from '../lib/supabaseClient';

  const listaPendentes = document.getElementById('listaPendentes');
  const totalPendentesEl = document.getElementById('totalPendentes');
  const loadingState = document.getElementById('loadingState');

  // Proteção de rota
  async function checkAuth() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = '/login';
      return;
    }
    const role = await getUserRole();
    if (role !== 'adm' && role !== 'dev') {
      window.location.href = '/';
    }
  }

  // Ação: Aprovar
  (window as any).aprovarAnimal = async (id: string, nome: string) => {
    if (!confirm(`Deseja aprovar o cadastro de "${nome}"? Ele ficará visível publicamente.`)) return;
    
    try {
      const { error } = await supabase
        .from('animais')
        .update({ status_moderacao: 'aprovado' })
        .eq('id', id);
        
      if (error) throw error;
      carregarPendentes();
    } catch (err) {
      console.error(err);
      alert('Erro ao aprovar o registro.');
    }
  };

  // Ação: Descartar (Reprovar/Spam)
  (window as any).descartarAnimal = async (id: string, nome: string) => {
    if (!confirm(`Deseja descartar "${nome}"? O registro ficará oculto (rejeitado).`)) return;
    
    try {
      const { error } = await supabase
        .from('animais')
        .update({ status_moderacao: 'rejeitado' })
        .eq('id', id);
        
      if (error) throw error;
      carregarPendentes();
    } catch (err) {
      console.error(err);
      alert('Erro ao descartar o registro.');
    }
  };

  async function carregarPendentes() {
    const { data: pendentes, error } = await supabase
      .from('animais')
      .select('*')
      .eq('status_moderacao', 'pendente')
      .order('created_at', { ascending: false });

    if (error) {
      console.error(error);
      if (loadingState) loadingState.innerHTML = '<span class="text-red-500">Erro ao carregar dados.</span>';
      return;
    }

    if (loadingState) loadingState.style.display = 'none';

    let html = '';

    if (!pendentes || pendentes.length === 0) {
      if (listaPendentes) {
        listaPendentes.innerHTML = `
          <div class="text-center py-10 bg-white rounded-xl border border-gray-100 flex flex-col items-center justify-center">
            <span class="text-4xl mb-3">🎉</span>
            <h3 class="text-lg font-medium text-gray-800">Tudo limpo!</h3>
            <p class="text-sm text-gray-500">Nenhum animal aguardando aprovação no momento.</p>
            <a href="/" class="mt-4 text-sm text-blue-600 font-medium hover:underline">Voltar ao Início</a>
          </div>`;
      }
      if (totalPendentesEl) totalPendentesEl.textContent = '0';
      return;
    }

    pendentes.forEach((animal) => {
      const dataEnvio = new Date(animal.created_at).toLocaleDateString('pt-BR');
      
      html += `
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="p-4 flex gap-4">
            <img src="${animal.imagem_url || ''}" class="w-24 h-24 rounded-lg object-cover bg-gray-100 flex-shrink-0" alt="${animal.nome}">
            <div class="flex-1 min-w-0">
              <h4 class="text-lg font-bold text-gray-800 truncate">${animal.nome}</h4>
              <p class="text-sm text-gray-600 truncate">${animal.especie} • ${animal.fase_vida} • ${animal.peso}kg</p>
              <p class="text-sm text-gray-600 truncate mt-1">📍 ${animal.localizacao}</p>
              <p class="text-xs text-gray-400 mt-2">Enviado em ${dataEnvio}</p>
            </div>
          </div>
          
          <div class="bg-gray-50 px-4 py-3 border-t border-gray-100 flex gap-2 justify-end">
            <button onclick="descartarAnimal('${animal.id}', '${animal.nome}')" class="px-4 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
              Descartar Spam
            </button>
            <button onclick="aprovarAnimal('${animal.id}', '${animal.nome}')" class="px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 transition-colors shadow-sm">
              Aprovar Publicação
            </button>
          </div>
        </div>
      `;
    });

    if (listaPendentes) listaPendentes.innerHTML = html;
    if (totalPendentesEl) totalPendentesEl.textContent = pendentes.length.toString();
  }

  // Inicializa
  checkAuth().then(() => carregarPendentes());
</script>
