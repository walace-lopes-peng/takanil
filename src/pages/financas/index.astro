---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Finanças - Hub Takanil">
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
    <div class="flex items-center justify-between mb-6">
      <a href="/" class="text-gray-500 hover:text-gray-900 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
      </a>
      <h2 class="text-xl font-bold text-gray-800 text-center flex-1">Finanças</h2>
      <div class="w-6"></div>
    </div>

    <!-- Resumo Financeiro / Saldo -->
    <div class="bg-gray-900 text-white rounded-2xl p-5 shadow-sm mb-6 transition-all duration-300">
      <h2 class="text-sm font-medium text-gray-300 mb-1">Saldo do Período</h2>
      <div class="flex items-baseline space-x-2">
        <span class="text-3xl font-bold" id="resumoSaldo">R$ 0,00</span>
      </div>
      <div class="grid grid-cols-2 gap-4 mt-4 pt-4 border-t border-gray-700/50">
        <div>
          <p class="text-xs text-gray-400 mb-0.5">Entradas</p>
          <p class="text-sm font-bold text-green-400" id="resumoEntradas">R$ 0,00</p>
        </div>
        <div>
          <p class="text-xs text-gray-400 mb-0.5">Saídas</p>
          <p class="text-sm font-bold text-red-400" id="resumoSaidas">R$ 0,00</p>
        </div>
      </div>
    </div>

    <!-- Botões de Ação -->
    <div class="grid grid-cols-2 gap-4 mb-4">
      <button id="btnEntrada" class="py-4 rounded-xl text-white font-bold text-lg bg-green-600 hover:bg-green-700 active:scale-95 transition-all shadow-sm">
        Nova Entrada
      </button>
      <button id="btnSaida" class="py-4 rounded-xl text-white font-bold text-lg bg-red-600 hover:bg-red-700 active:scale-95 transition-all shadow-sm">
        Nova Saída
      </button>
    </div>

    <!-- Formulário (Escondido por padrão) -->
    <form id="formFinancas" class="space-y-5 hidden bg-gray-50 p-4 rounded-xl border border-gray-200 mt-4">
      <div class="flex justify-between items-center mb-2">
        <h3 id="formTitle" class="font-bold text-gray-800 text-lg">Nova Transação</h3>
        <button type="button" id="btnCancelar" class="text-gray-400 hover:text-gray-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <input type="hidden" id="lancamentoId" name="lancamentoId" value="">
      <input type="hidden" id="tipo" name="tipo" value="">

      <!-- Valor -->
      <div>
        <label for="valor" class="block text-sm font-medium text-gray-700">Valor (R$)</label>
        <input type="number" name="valor" id="valor" step="0.01" min="0.01" required class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-3 border bg-white" placeholder="Ex: 150.00">
      </div>

      <!-- Descrição -->
      <div>
        <label for="descricao" class="block text-sm font-medium text-gray-700">Descrição <span class="text-xs text-gray-400 font-normal">(Opcional)</span></label>
        <input type="text" name="descricao" id="descricao" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-3 border bg-white" placeholder="Ex: Ração clínica">
      </div>

      <!-- Categoria (Toggle) -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Categoria</label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {
            [
              { label: 'Ração', value: 'racao', type: 'Saída' },
              { label: 'Veterinário', value: 'veterinario', type: 'Saída' },
              { label: 'Medicamento', value: 'medicamento', type: 'Saída' },
              { label: 'Castração', value: 'castracao', type: 'Saída' },
              { label: 'Doação', value: 'doacao', type: 'Entrada' },
              { label: 'Bazar', value: 'bazar', type: 'Entrada' },
              { label: 'Rifa', value: 'rifa', type: 'Entrada' },
              { label: 'Ajuste de Caixa', value: 'ajuste', type: 'Ambos' },
              { label: 'Outro', value: 'outro', type: 'Ambos' }
            ].map((cat) => (
              <label class="cursor-pointer cat-toggle" data-tipo={cat.type}>
                <input type="radio" name="categoria" value={cat.value} class="peer sr-only" required>
                <div class="text-center p-2 rounded-xl border border-gray-200 bg-white text-gray-600 text-sm peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:text-blue-700 peer-checked:font-medium transition-all">
                  {cat.label}
                </div>
              </label>
            ))
          }
        </div>
      </div>

      <!-- Data -->
      <div>
        <label for="data" class="block text-sm font-medium text-gray-700">Data</label>
        <input type="date" name="data" id="data" required class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-3 border bg-white">
      </div>

      <!-- Submit -->
      <div class="pt-4">
        <button type="submit" id="submitBtn" class="w-full flex justify-center py-3.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 active:scale-[0.98] transition-all disabled:opacity-70">
          <span>Salvar Lançamento</span>
          <svg id="loadingSpinner" class="animate-spin ml-2 h-5 w-5 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </div>

      <!-- Mensagem de erro/sucesso -->
      <div id="statusMessage" class="hidden text-center text-sm font-medium p-3 rounded-xl mt-2"></div>
    </form>
  </div>

  <!-- Seção de Filtros de Período -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 mb-6">
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-sm font-bold text-gray-700">Filtrar por Período</h3>
      <div class="flex items-center gap-3">
        <span id="labelPeriodoAtual" class="text-xs text-blue-600 font-medium"></span>
        <button id="btnExportar" class="text-xs font-bold text-blue-700 bg-blue-100 px-2 py-1 rounded hover:bg-blue-200 flex items-center gap-1 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Excel
        </button>
      </div>
    </div>

    <!-- Chips / Atalhos de Data -->
    <div class="flex flex-wrap gap-2" id="containerAtalhos">
      <button type="button" data-atalho="este_mes" class="btn-atalho px-3 py-1.5 rounded-lg text-xs font-medium border border-blue-500 bg-blue-50 text-blue-700 transition-all">
        Este mês
      </button>
      <button type="button" data-atalho="hoje" class="btn-atalho px-3 py-1.5 rounded-lg text-xs font-medium border border-gray-200 bg-gray-50 text-gray-600 hover:bg-gray-100 transition-all">
        Hoje
      </button>
      <button type="button" data-atalho="esta_semana" class="btn-atalho px-3 py-1.5 rounded-lg text-xs font-medium border border-gray-200 bg-gray-50 text-gray-600 hover:bg-gray-100 transition-all">
        Esta semana
      </button>
      <button type="button" data-atalho="semana_passada" class="btn-atalho px-3 py-1.5 rounded-lg text-xs font-medium border border-gray-200 bg-gray-50 text-gray-600 hover:bg-gray-100 transition-all">
        Semana passada
      </button>
      <button type="button" data-atalho="mes_passado" class="btn-atalho px-3 py-1.5 rounded-lg text-xs font-medium border border-gray-200 bg-gray-50 text-gray-600 hover:bg-gray-100 transition-all">
        Mês passado
      </button>
      <button type="button" data-atalho="personalizado" class="btn-atalho px-3 py-1.5 rounded-lg text-xs font-medium border border-gray-200 bg-gray-50 text-gray-600 hover:bg-gray-100 transition-all">
        Personalizado
      </button>
    </div>

    <!-- Campos de Data Personalizada -->
    <div id="containerPersonalizado" class="hidden mt-3 pt-3 border-t border-gray-100 grid grid-cols-2 gap-3">
      <div>
        <label for="filtroDataInicio" class="block text-xs font-medium text-gray-600 mb-1">Data Inicial</label>
        <input type="date" id="filtroDataInicio" class="w-full text-xs p-2 rounded-lg border border-gray-300 bg-gray-50 focus:border-blue-500 focus:bg-white transition-all">
      </div>
      <div>
        <label for="filtroDataFim" class="block text-xs font-medium text-gray-600 mb-1">Data Final</label>
        <input type="date" id="filtroDataFim" class="w-full text-xs p-2 rounded-lg border border-gray-300 bg-gray-50 focus:border-blue-500 focus:bg-white transition-all">
      </div>
    </div>

    <!-- Gráfico de Evolução SVG -->
    <div id="containerGrafico" class="mt-5 pt-4 border-t border-gray-100">
      <h4 class="text-xs font-bold text-gray-500 mb-2 uppercase tracking-wider">Evolução no Período</h4>
      <div id="graficoSvgContainer" class="w-full">
        <!-- SVG injetado via JS -->
      </div>
    </div>
  </div>

  <!-- Lista de Lançamentos -->
  <div>
    <div class="flex justify-between items-center mb-4 px-1">
      <h3 class="text-lg font-bold text-gray-800">Lançamentos</h3>
      <span id="totalRegistros" class="text-xs bg-gray-200 text-gray-700 font-bold px-2 py-0.5 rounded-full">0</span>
    </div>
    
    <div id="listaLancamentos" class="space-y-3 pb-20">
      <div class="text-center py-8 text-gray-400 text-sm" id="loadingState">
        <svg class="animate-spin mx-auto h-8 w-8 text-gray-300 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Carregando dados...
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase, getUserRole } from '../../lib/supabaseClient';

  const { data: authData } = await supabase.auth.getSession();
  if (!authData.session) {
    window.location.replace('/login');
  } else {
    const role = await getUserRole();
    if (role !== 'adm' && role !== 'dev') {
      window.location.replace('/');
    }
  }
  import { obterIntervaloPorAtalho, type TipoAtalhoData } from '../../lib/filtrosData';
  import { agruparLancamentos, gerarSvgGrafico } from '../../lib/agrupamentoFinancas';
  import * as XLSX from 'xlsx';

  // Elementos do Formulário
  const btnEntrada = document.getElementById('btnEntrada');
  const btnSaida = document.getElementById('btnSaida');
  const btnCancelar = document.getElementById('btnCancelar');
  const form = document.getElementById('formFinancas') as HTMLFormElement;
  const lancamentoIdInput = document.getElementById('lancamentoId') as HTMLInputElement;
  const tipoInput = document.getElementById('tipo') as HTMLInputElement;
  const formTitle = document.getElementById('formTitle');
  const dataInput = document.getElementById('data') as HTMLInputElement;
  
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const submitText = submitBtn.querySelector('span');
  const spinner = document.getElementById('loadingSpinner');
  const statusMessage = document.getElementById('statusMessage');

  // Elementos da Lista e Filtros
  const listaLancamentos = document.getElementById('listaLancamentos');
  const loadingState = document.getElementById('loadingState');
  const totalRegistrosEl = document.getElementById('totalRegistros');
  const labelPeriodoAtual = document.getElementById('labelPeriodoAtual');
  const containerPersonalizado = document.getElementById('containerPersonalizado');
  const filtroDataInicio = document.getElementById('filtroDataInicio') as HTMLInputElement;
  const filtroDataFim = document.getElementById('filtroDataFim') as HTMLInputElement;
  const botoesAtalho = document.querySelectorAll('.btn-atalho');

  // Elementos do Resumo e Gráfico
  const resumoSaldo = document.getElementById('resumoSaldo');
  const resumoEntradas = document.getElementById('resumoEntradas');
  const resumoSaidas = document.getElementById('resumoSaidas');
  const graficoSvgContainer = document.getElementById('graficoSvgContainer');

  // Estado atual do filtro
  let atalhoAtivo: TipoAtalhoData = 'este_mes';
  let periodoAtual = obterIntervaloPorAtalho('este_mes');
  let lancamentosAtuais: any[] = [];

  // Setar data padrão do formulário para hoje
  const hoje = new Date().toISOString().split('T')[0];
  if (dataInput) dataInput.value = hoje;
  if (filtroDataInicio) filtroDataInicio.value = periodoAtual.inicio;
  if (filtroDataFim) filtroDataFim.value = periodoAtual.fim;

  // Abrir / Fechar Formulário
  function openForm(tipo: 'Entrada' | 'Saída') {
    tipoInput.value = tipo;
    formTitle!.textContent = `Nova ${tipo}`;
    if (submitText) submitText.textContent = 'Salvar Lançamento';
    
    // Atualiza a lista de categorias mostradas baseadas no tipo
    document.querySelectorAll('.cat-toggle').forEach(el => {
      const t = el.getAttribute('data-tipo');
      if (t === tipo || t === 'Ambos') {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });

    lancamentoIdInput.value = '';
    form.reset();
    dataInput.value = hoje;
    if (formTitle) {
      formTitle.textContent = tipo === 'Entrada' ? 'Nova Entrada' : 'Nova Saída';
      formTitle.className = tipo === 'Entrada' ? 'font-bold text-lg text-green-700' : 'font-bold text-lg text-red-700';
    }
    form.classList.remove('hidden');
    form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  btnEntrada?.addEventListener('click', () => openForm('Entrada'));
  btnSaida?.addEventListener('click', () => openForm('Saída'));
  btnCancelar?.addEventListener('click', () => {
    form.classList.add('hidden');
    form.reset();
    dataInput.value = hoje;
  });

  const showStatus = (msg: string, type: 'success' | 'error') => {
    if (!statusMessage) return;
    statusMessage.textContent = msg;
    statusMessage.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'bg-green-50', 'text-green-700');
    if (type === 'error') {
      statusMessage.classList.add('bg-red-50', 'text-red-700');
    } else {
      statusMessage.classList.add('bg-green-50', 'text-green-700');
    }
  };

  // Submit do Formulário
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    statusMessage?.classList.add('hidden');
    
    const formData = new FormData(form);
    const tipo = formData.get('tipo') as string;
    const valorStr = formData.get('valor') as string;
    const valor = parseFloat(valorStr);
    let descricao = formData.get('descricao') as string;
    const categoria = formData.get('categoria') as string;
    const data = formData.get('data') as string;

    if (!descricao || descricao.trim() === '') {
      descricao = categoria.charAt(0).toUpperCase() + categoria.slice(1);
    }

    if (!tipo || isNaN(valor) || valor <= 0 || !categoria || !data) {
      showStatus('Por favor, preencha todos os campos corretamente.', 'error');
      return;
    }

    try {
      submitBtn.disabled = true;
      if (submitText) submitText.textContent = 'Salvando...';
      spinner?.classList.remove('hidden');

      const idToEdit = lancamentoIdInput.value;
      let dbError;

      if (idToEdit) {
        const { error } = await supabase
          .from('financas')
          .update({ tipo, valor, descricao, categoria, data })
          .eq('id', idToEdit);
        dbError = error;
      } else {
        const { error } = await supabase
          .from('financas')
          .insert([{ tipo, valor, descricao, categoria, data }]);
        dbError = error;
      }

      if (dbError) throw new Error('Erro ao salvar no banco: ' + dbError.message);

      showStatus(idToEdit ? 'Lançamento atualizado com sucesso!' : 'Lançamento cadastrado com sucesso!', 'success');
      form.reset();
      lancamentoIdInput.value = '';
      dataInput.value = hoje;
      
      setTimeout(() => {
        form.classList.add('hidden');
        statusMessage?.classList.add('hidden');
        carregarDados();
      }, 1500);

    } catch (err: any) {
      console.error(err);
      showStatus(err.message || 'Ocorreu um erro inesperado.', 'error');
    } finally {
      submitBtn.disabled = false;
      if (submitText) submitText.textContent = 'Salvar Lançamento';
      spinner?.classList.add('hidden');
    }
  });

  // Utilitários de Formatação
  function formatarMoeda(valor: number) {
    return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(valor);
  }

  function formatarDataBR(dataISO: string) {
    const partes = dataISO.split('-');
    if (partes.length === 3) {
      return `${partes[2]}/${partes[1]}/${partes[0]}`;
    }
    return dataISO;
  }

  // Atualizar visual dos chips de atalho
  function atualizarBotoesAtalho() {
    botoesAtalho.forEach((btn) => {
      const atalho = btn.getAttribute('data-atalho');
      if (atalho === atalhoAtivo) {
        btn.className = 'btn-atalho px-3 py-1.5 rounded-lg text-xs font-medium border border-blue-500 bg-blue-50 text-blue-700 transition-all';
      } else {
        btn.className = 'btn-atalho px-3 py-1.5 rounded-lg text-xs font-medium border border-gray-200 bg-gray-50 text-gray-600 hover:bg-gray-100 transition-all';
      }
    });

    if (atalhoAtivo === 'personalizado') {
      containerPersonalizado?.classList.remove('hidden');
    } else {
      containerPersonalizado?.classList.add('hidden');
    }

    if (labelPeriodoAtual) {
      labelPeriodoAtual.textContent = `${formatarDataBR(periodoAtual.inicio)} até ${formatarDataBR(periodoAtual.fim)}`;
    }
  }

  // Eventos dos chips de atalho
  botoesAtalho.forEach((btn) => {
    btn.addEventListener('click', () => {
      const atalho = btn.getAttribute('data-atalho') as TipoAtalhoData;
      if (!atalho) return;

      atalhoAtivo = atalho;
      if (atalho !== 'personalizado') {
        periodoAtual = obterIntervaloPorAtalho(atalho);
        if (filtroDataInicio) filtroDataInicio.value = periodoAtual.inicio;
        if (filtroDataFim) filtroDataFim.value = periodoAtual.fim;
      } else {
        if (filtroDataInicio && filtroDataFim) {
          periodoAtual = {
            inicio: filtroDataInicio.value || hoje,
            fim: filtroDataFim.value || hoje,
          };
        }
      }

      atualizarBotoesAtalho();
      carregarDados();
    });
  });

  // Eventos para mudança manual das datas personalizadas
  const onDataPersonalizadaChange = () => {
    if (filtroDataInicio && filtroDataFim) {
      if (filtroDataInicio.value && filtroDataFim.value) {
        periodoAtual = {
          inicio: filtroDataInicio.value,
          fim: filtroDataFim.value,
        };
        atualizarBotoesAtalho();
        carregarDados();
      }
    }
  };

  filtroDataInicio?.addEventListener('change', onDataPersonalizadaChange);
  filtroDataFim?.addEventListener('change', onDataPersonalizadaChange);

  // Expor funções globais de edição e deleção
  (window as any).deletarLancamento = async (id: string) => {
    if (!confirm('Tem certeza que deseja excluir este lançamento? Esta ação não pode ser desfeita.')) return;
    
    try {
      if (loadingState) loadingState.style.display = 'block';
      const { error } = await supabase.from('financas').delete().eq('id', id);
      if (error) throw error;
      await carregarDados();
    } catch (err: any) {
      alert('Erro ao excluir: ' + err.message);
      if (loadingState) loadingState.style.display = 'none';
    }
  };

  (window as any).editarLancamento = (id: string) => {
    const l = lancamentosAtuais.find(x => x.id === id);
    if (!l) return;
    
    lancamentoIdInput.value = l.id;
    tipoInput.value = l.tipo;
    (document.getElementById('valor') as HTMLInputElement).value = l.valor;
    (document.getElementById('descricao') as HTMLInputElement).value = l.descricao || '';
    (document.getElementById('data') as HTMLInputElement).value = l.data;
    
    // Atualiza a lista de categorias antes de marcar o rádio
    document.querySelectorAll('.cat-toggle').forEach(el => {
      const t = el.getAttribute('data-tipo');
      if (t === l.tipo || t === 'Ambos') {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });

    const radioCat = document.querySelector(`input[name="categoria"][value="${l.categoria}"]`) as HTMLInputElement;
    if (radioCat) radioCat.checked = true;

    formTitle!.textContent = 'Editar Lançamento';
    if (submitText) submitText.textContent = 'Atualizar Lançamento';
    
    form.classList.remove('hidden');
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  // Carregar dados filtrados do Supabase
  async function carregarDados() {
    if (loadingState) {
      loadingState.style.display = 'block';
    }

    const { data: lancamentos, error } = await supabase
      .from('financas')
      .select('*')
      .gte('data', periodoAtual.inicio)
      .lte('data', periodoAtual.fim)
      .order('data', { ascending: false })
      .order('created_at', { ascending: false });

    if (loadingState) loadingState.style.display = 'none';

    lancamentosAtuais = lancamentos || [];

    if (error) {
      console.error(error);
      if (listaLancamentos) {
        listaLancamentos.innerHTML = '<div class="text-center py-8 text-red-500 text-sm">Erro ao carregar os lançamentos.</div>';
      }
      return;
    }

    if (totalRegistrosEl) {
      totalRegistrosEl.textContent = (lancamentos?.length || 0).toString();
    }

    if (!lancamentos || lancamentos.length === 0) {
      if (listaLancamentos) {
        listaLancamentos.innerHTML = `
          <div class="text-center py-8 text-gray-500 bg-white rounded-xl border border-gray-100 shadow-sm text-sm">
            Nenhum lançamento encontrado para este período.
          </div>`;
      }
      
      // Zera o resumo e gráfico
      if (resumoSaldo) { resumoSaldo.textContent = 'R$ 0,00'; resumoSaldo.className = 'text-3xl font-bold text-gray-300'; }
      if (resumoEntradas) resumoEntradas.textContent = 'R$ 0,00';
      if (resumoSaidas) resumoSaidas.textContent = 'R$ 0,00';
      if (graficoSvgContainer) graficoSvgContainer.innerHTML = '<div class="text-center text-gray-400 text-sm py-4">Sem dados para exibir no gráfico.</div>';
      
      return;
    }

    let html = '';
    let totalEntradas = 0;
    let totalSaidas = 0;

    lancamentos.forEach((l) => {
      const isEntrada = l.tipo === 'Entrada';
      const colorText = isEntrada ? 'text-green-600' : 'text-red-600';
      const sinal = isEntrada ? '+' : '-';
      
      if (isEntrada) totalEntradas += l.valor;
      else totalSaidas += l.valor;

      const catLabel = l.categoria.charAt(0).toUpperCase() + l.categoria.slice(1);

      html += `
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex justify-between items-center">
          <div class="flex-1 pr-4">
            <h4 class="font-bold text-gray-800 text-sm truncate">${l.descricao}</h4>
            <p class="text-xs text-gray-500 mt-0.5">${catLabel} • ${formatarDataBR(l.data)}</p>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="font-bold text-sm ${colorText}">${sinal} ${formatarMoeda(l.valor)}</p>
            <div class="flex justify-end gap-3 mt-1.5">
              <button onclick="window.editarLancamento('${l.id}')" class="text-xs font-medium text-blue-600 hover:text-blue-800 underline">Editar</button>
              <button onclick="window.deletarLancamento('${l.id}')" class="text-xs font-medium text-red-600 hover:text-red-800 underline">Excluir</button>
            </div>
          </div>
        </div>
      `;
    });

    if (listaLancamentos) listaLancamentos.innerHTML = html;

    // Atualizar Resumo
    const saldo = totalEntradas - totalSaidas;
    if (resumoEntradas) resumoEntradas.textContent = formatarMoeda(totalEntradas);
    if (resumoSaidas) resumoSaidas.textContent = formatarMoeda(totalSaidas);
    if (resumoSaldo) {
      resumoSaldo.textContent = formatarMoeda(saldo);
      if (saldo > 0) resumoSaldo.className = 'text-3xl font-bold text-green-400';
      else if (saldo < 0) resumoSaldo.className = 'text-3xl font-bold text-red-400';
      else resumoSaldo.className = 'text-3xl font-bold text-gray-300';
    }
    
    // Atualizar Gráfico
    if (graficoSvgContainer) {
      const grupos = agruparLancamentos(lancamentos as any, periodoAtual.inicio, periodoAtual.fim);
      graficoSvgContainer.innerHTML = gerarSvgGrafico(grupos);
    }
  }

  // Exportar Excel
  const btnExportar = document.getElementById('btnExportar');
  btnExportar?.addEventListener('click', () => {
    if (lancamentosAtuais.length === 0) {
      alert('Nenhum dado para exportar neste período.');
      return;
    }

    const linhas = lancamentosAtuais.map(l => ({
      Data: formatarDataBR(l.data),
      Tipo: l.tipo,
      Categoria: l.categoria.charAt(0).toUpperCase() + l.categoria.slice(1),
      Descrição: l.descricao || 'Sem descrição',
      Valor: formatarMoeda(l.valor)
    }));

    const ws = XLSX.utils.json_to_sheet(linhas);
    ws['!cols'] = [{wch: 12}, {wch: 10}, {wch: 15}, {wch: 30}, {wch: 15}];
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Financeiro');
    XLSX.writeFile(wb, 'Takanil-Financeiro.xlsx');
  });

  // Inicialização
  atualizarBotoesAtalho();
  carregarDados();
</script>
