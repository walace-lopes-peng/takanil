---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hub Takanil - Dashboard">
  
  <div class="space-y-6 pb-20">
    
    <!-- Header / Ração -->
    <div class="bg-gradient-to-br from-taka-green-500 to-taka-green-700 text-white rounded-2xl p-6 shadow-md border border-taka-green-400/50">
      <h2 class="text-sm font-medium text-taka-green-100 mb-1">Previsão de Ração (Mensal)</h2>
      <div class="flex items-baseline space-x-2">
        <span class="text-4xl font-bold" id="totalRacao">--</span>
        <span class="text-taka-green-200">kg/mês</span>
      </div>
      <p class="text-xs text-taka-green-200 mt-2">*Apenas para animais no Abrigo Takanil (aprox. 1.5% peso/dia)</p>
    </div>

    <!-- Banner de Pendências -->
    <a href="/aprovacoes" id="bannerPendentes" class="hidden block bg-yellow-50 border border-yellow-200 rounded-xl p-4 shadow-sm hover:bg-yellow-100 transition-colors mb-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-xl">🛎️</span>
          <div>
            <h3 class="font-bold text-yellow-800 text-sm">Sugestões Pendentes</h3>
            <p class="text-xs text-yellow-700 mt-0.5">Você tem <span id="qtdPendentes" class="font-bold">0</span> animal(is) aguardando aprovação.</p>
          </div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-yellow-600" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
        </svg>
      </div>
    </a>

    <!-- Barra de Busca Textual por Nome -->
    <div class="relative w-full mb-3">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="text"
        id="inputBuscaNome"
        placeholder="Buscar por nome do animal..."
        class="w-full pl-10 pr-10 py-2.5 sm:py-3 bg-white border border-gray-200 rounded-2xl shadow-xs text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-taka-green-500 focus:border-transparent transition-all min-h-[44px]"
        aria-label="Buscar animal por nome"
      />
      <button
        type="button"
        id="btnLimparBusca"
        aria-label="Limpar busca por nome"
        class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 transition-colors min-w-[44px] min-h-[44px] justify-center"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 bg-gray-200 hover:bg-gray-300 rounded-full p-0.5 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Todos os Animais -->
    <div>
      <div class="flex items-center justify-between mb-4 gap-2">
        <div class="min-w-0">
          <p class="text-sm sm:text-base font-bold text-gray-700 truncate"><span id="totalAnimais" class="text-gray-900">0</span> <span id="labelTotalAnimais">Animais</span></p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <!-- Alternador de Visualização (Grade vs Lista) -->
          <div class="flex items-center p-1 bg-white rounded-xl border border-gray-200 shadow-xs" role="group" aria-label="Modo de visualização dos animais">
            <button
              type="button"
              onclick="definirModoVisualizacao('grid')"
              id="btnModoGrid"
              aria-label="Visualizar em grade de 2 colunas"
              title="Visualização em Grade"
              class="h-10 w-10 flex items-center justify-center rounded-lg text-sm font-bold transition-all bg-taka-green-50 text-taka-green-700 shadow-xs border border-taka-green-200"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
            </button>
            <button
              type="button"
              onclick="definirModoVisualizacao('list')"
              id="btnModoList"
              aria-label="Visualizar em lista compacta"
              title="Visualização em Lista Compacta"
              class="h-10 w-10 flex items-center justify-center rounded-lg text-sm font-bold transition-all text-gray-500 hover:text-gray-800"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>

          <!-- Botão Filtrar -->
          <button
            onclick="abrirModalFiltros()"
            id="btnAbrirFiltros"
            aria-label="Abrir modal de filtros"
            class="px-3.5 py-2 rounded-xl border border-taka-green-300 bg-taka-green-50 text-taka-green-700 font-bold text-sm hover:bg-taka-green-100 active:scale-95 transition-all flex items-center gap-1.5 shadow-xs min-h-[44px]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            <span>Filtrar</span>
          </button>

          <!-- Botão Finais Felizes -->
          <button
            type="button"
            onclick="alternarFinaisFelizes()"
            title="Ver finais felizes (adotados)"
            aria-label="Ver animais com finais felizes"
            class="h-11 w-11 flex items-center justify-center rounded-xl bg-gray-100 text-gray-500 hover:bg-gray-200 active:scale-95 transition-all shadow-xs shrink-0 min-w-[44px] min-h-[44px]"
            id="btnFinaisFelizes"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform transform-gpu" viewBox="0 0 20 20" fill="currentColor" id="svgFinaisFelizes">
              <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </div>
      <div id="listaAnimais" class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
        <div class="col-span-full text-center py-8 text-gray-500 text-sm" id="loadingState">
          <svg class="animate-spin mx-auto h-8 w-8 text-taka-green-600 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Carregando dados...
        </div>
        <!-- Inserido via JS -->
      </div>
    </div>
  </div>

  <!-- Modal de Filtros (Organizado em 2 Colunas Limpas) -->
  <div id="modalFiltros" class="fixed inset-0 z-50 bg-black/60 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
      <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-taka-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
          <h3 class="font-bold text-gray-800 text-lg">Filtrar Animais</h3>
        </div>
        <button onclick="fecharModalFiltros()" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div class="p-5 space-y-5 max-h-[70vh] overflow-y-auto">
        <!-- Categoria 1: Situação / Urgência -->
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Situação / Urgência</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" onclick="selecionarFiltroUrgencia('Todos')" class="opt-filtro-urgencia p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-urgencia="Todos">
              <span>Todos</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" onclick="selecionarFiltroUrgencia('Machucados')" class="opt-filtro-urgencia p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-urgencia="Machucados">
              <span>🚨 Machucados</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" onclick="selecionarFiltroUrgencia('Desaparecidos')" class="opt-filtro-urgencia p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-urgencia="Desaparecidos">
              <span>🔍 Sumidos</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
          </div>
        </div>

        <!-- Categoria 2: Localização -->
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Localização</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" onclick="selecionarFiltroLocalizacao('Todas')" class="opt-filtro-loc p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-loc="Todas">
              <span>Todas</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" onclick="selecionarFiltroLocalizacao('Abrigo Takanil')" class="opt-filtro-loc p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-loc="Abrigo Takanil">
              <span>🏡 No Abrigo</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" onclick="selecionarFiltroLocalizacao('Na rua')" class="opt-filtro-loc p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-loc="Na rua">
              <span>🐾 Na Rua</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" onclick="selecionarFiltroLocalizacao('Lar Temporário')" class="opt-filtro-loc p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-loc="Lar Temporário">
              <span>🚧 Lar Temp.</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
          </div>
        </div>

        <!-- Categoria 3: Espécie -->
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Espécie</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" onclick="selecionarFiltroEspecie('Todas')" class="opt-filtro-especie p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-especie="Todas">
              <span>Todas</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" onclick="selecionarFiltroEspecie('Cão')" class="opt-filtro-especie p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-especie="Cão">
              <span>🐶 Cães</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" onclick="selecionarFiltroEspecie('Gato')" class="opt-filtro-especie p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-especie="Gato">
              <span>🐱 Gatos</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
          </div>
        </div>

        <!-- Categoria 4: Sexo -->
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Sexo</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" onclick="selecionarFiltroSexo('Todos')" class="opt-filtro-sexo p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-sexo="Todos">
              <span>Todos</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" onclick="selecionarFiltroSexo('Macho')" class="opt-filtro-sexo p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-sexo="Macho">
              <span>♂️ Machos</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" onclick="selecionarFiltroSexo('Fêmea')" class="opt-filtro-sexo p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-sexo="Fêmea">
              <span>♀️ Fêmeas</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" onclick="selecionarFiltroSexo('Misto (Ninhada)')" class="opt-filtro-sexo p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-sexo="Misto (Ninhada)">
              <span>📦 Misto / Ninhada</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
          </div>
        </div>

        <!-- Categoria 5: Status Clínico / Tags -->
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Status Clínico / Tags</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" onclick="selecionarFiltroClinico('Todos')" class="opt-filtro-clinico p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-clinico="Todos">
              <span>Todos</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" onclick="selecionarFiltroClinico('castrado')" class="opt-filtro-clinico p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-clinico="castrado">
              <span>✂️ Apenas Castrados</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" onclick="selecionarFiltroClinico('vacinado')" class="opt-filtro-clinico p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-clinico="vacinado">
              <span>💉 Apenas Vacinados</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
          </div>
        </div>
      </div>

      <div class="p-4 border-t border-gray-100 bg-gray-50 flex gap-2">
        <button onclick="limparFiltrosModal()" class="flex-1 py-3 text-sm font-bold text-gray-600 hover:bg-gray-200 rounded-xl transition-colors">Limpar</button>
        <button onclick="aplicarFiltrosModal()" class="flex-[2] py-3 text-sm font-bold text-white bg-taka-green-600 hover:bg-taka-green-700 rounded-xl transition-colors shadow-md active:scale-95">Aplicar Filtros</button>
      </div>
    </div>
  </div>

  <!-- Modal de Edição Rápida (Status/Localização) -->
  <div id="modalEdicao" class="fixed inset-0 z-50 bg-black/60 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm overflow-hidden">
      <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
        <h3 class="font-bold text-gray-800" id="modalEdicaoTitulo">Editar Status</h3>
        <button onclick="fecharModalEdicao()" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-5 space-y-4">
        <input type="hidden" id="editAnimalId">
        
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Localização</label>
          <select id="editLocalizacao" class="w-full rounded-xl border-gray-300 shadow-sm focus:border-taka-green-500 focus:ring-taka-green-500 text-sm p-3 border bg-white">
            <option value="Abrigo Takanil">Abrigo Takanil</option>
            <option value="Na rua">Na rua</option>
            <option value="Lar Temporário">Lar Temporário</option>
            <option value="Casa de terceiros">Casa de terceiros</option>
            <option value="Desaparecido">Desaparecido</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Situação / Resolução</label>
          <select id="editUrgencia" class="w-full rounded-xl border-gray-300 shadow-sm focus:border-taka-green-500 focus:ring-taka-green-500 text-sm p-3 border bg-white">
            <option value="Nenhuma">Normal (Nenhuma)</option>
            <option value="Machucado/Risco">🚨 Machucado / Risco</option>
            <option value="Desaparecido">🔍 Desaparecido</option>
            <option value="Adotado">✅ Adotado</option>
            <option value="Tutor Encontrado">🏠 Tutor Encontrado</option>
            <option value="Óbito">✝️ Óbito</option>
          </select>
        </div>
      </div>
      <div class="p-4 border-t border-gray-100 bg-gray-50 flex justify-end gap-2">
        <button onclick="fecharModalEdicao()" class="px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-200 rounded-xl transition-colors">Cancelar</button>
        <button onclick="salvarEdicao()" id="btnSalvarEdicao" class="px-4 py-2 text-sm font-medium text-white bg-taka-green-600 hover:bg-taka-green-700 rounded-xl transition-colors shadow-sm">Salvar Alterações</button>
      </div>
    </div>
  </div>

  <!-- Modal de Zoom da Foto do Animal -->
  <div id="modalZoomFoto" class="fixed inset-0 z-50 bg-black/85 hidden flex items-center justify-center p-3 sm:p-4 backdrop-blur-md transition-opacity duration-200 opacity-0" role="dialog" aria-modal="true" aria-labelledby="modalZoomTitulo">
    <div id="modalZoomCard" class="relative max-w-2xl w-full flex flex-col items-center bg-gray-950 rounded-2xl overflow-hidden shadow-2xl border border-white/15 transform transition-transform duration-200 scale-95">
      <!-- Botão Fechar -->
      <button onclick="fecharModalZoom()" aria-label="Fechar zoom da foto" class="absolute top-3 right-3 text-white/90 hover:text-white bg-black/60 hover:bg-black/90 rounded-full p-2.5 transition-colors z-10 min-w-[44px] min-h-[44px] flex items-center justify-center border border-white/10 shadow-md">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>

      <!-- Imagem Principal -->
      <div class="w-full flex items-center justify-center bg-black min-h-[220px] max-h-[70vh] overflow-hidden">
        <img id="modalZoomImg" src="" alt="Foto do animal ampliada" class="max-w-full max-h-[70vh] object-contain" />
      </div>

      <!-- Legenda com Nome e Detalhes -->
      <div class="w-full p-4 bg-gray-900 border-t border-white/10 text-white flex justify-between items-center gap-3">
        <div class="min-w-0 flex-1">
          <h3 id="modalZoomTitulo" class="font-bold text-base sm:text-lg text-white truncate"></h3>
          <p id="modalZoomSubtitulo" class="text-xs sm:text-sm text-gray-300 truncate mt-0.5"></p>
        </div>
        <button onclick="fecharModalZoom()" class="px-4 py-2 bg-white/15 hover:bg-white/25 active:scale-95 text-white rounded-xl text-sm font-semibold transition-all min-h-[44px] shrink-0">Fechar</button>
      </div>
    </div>
  </div>

  <!-- Botões Flutuantes (FABs) -->
  <div class="fixed bottom-20 right-4 flex flex-col items-end gap-3 z-30" id="fabsContainer">
    <!-- FAB Associar -->
    <a href="https://docs.google.com/forms/d/e/1FAIpQLSeiYK6dKhgITc7oCZjOw5_u6G_5QWOKnL6TkA-EFwJGskpNUw/viewform" id="fabAssociar" target="_blank" rel="noopener noreferrer" aria-label="Quero ser um associado da ONG Takanil" class="backdrop-blur-md text-white border border-pink-400 rounded-full flex items-center justify-center shadow-lg hover:shadow-xl active:scale-95 transition-all duration-300 px-3 opacity-60 hover:opacity-100 min-h-[44px]" style="background-color: rgba(236, 72, 153, 0.9);" title="Quero ser um associado">
      <span class="text-xl">💖</span>
      <span id="fabAssociarText" class="font-bold text-xs uppercase tracking-wider drop-shadow-sm overflow-hidden transition-all duration-300 max-w-[0px] opacity-0">ASSOCIAR</span>
    </a>

    <!-- FAB Instagram Oficial -->
    <a href="https://www.instagram.com/takanilp4" id="fabInstagram" target="_blank" rel="noopener noreferrer" aria-label="Acompanhe o Instagram oficial da ONG Takanil" class="backdrop-blur-md text-white border border-pink-300/40 rounded-full flex items-center justify-center shadow-lg hover:shadow-xl active:scale-95 transition-all duration-300 px-3 opacity-60 hover:opacity-100 min-h-[44px]" style="background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);" title="Instagram Oficial @takanilp4">
      <img src="/assets/insta-logo.png" alt="Instagram" class="w-5 h-5 object-contain" />
      <span id="fabInstagramText" class="font-bold text-xs uppercase tracking-wider drop-shadow-sm overflow-hidden transition-all duration-300 max-w-[0px] opacity-0">INSTA</span>
    </a>
    
    <!-- FAB Sugerir/Novo Animal -->
    <a href="/sugerir-animal" id="fabAddAnimal" aria-label="Sugerir novo animal para cadastro" class="backdrop-blur-md text-white border border-taka-green-400 rounded-full flex items-center justify-center shadow-lg hover:shadow-xl active:scale-95 transition-all duration-300 px-3 opacity-60 hover:opacity-100 shadow-taka-green-600/30 min-h-[44px]" style="background-color: rgba(55, 176, 141, 0.9);" title="Sugerir novo animal">
      <span id="fabIcon" class="text-xl drop-shadow-sm">🐾</span>
      <span id="fabText" class="font-bold text-xs uppercase tracking-wider drop-shadow-sm overflow-hidden transition-all duration-300 max-w-[0px] opacity-0">SUGERIR</span>
    </a>
  </div>

</Layout>

<script>
  import { supabase, getUserRole } from '../lib/supabaseClient';

  const listaAnimais = document.getElementById('listaAnimais');
  const totalRacaoEl = document.getElementById('totalRacao');
  const totalAnimaisEl = document.getElementById('totalAnimais');
  const loadingState = document.getElementById('loadingState');
  const bannerPendentes = document.getElementById('bannerPendentes');
  const qtdPendentes = document.getElementById('qtdPendentes');

  // Estado local
  let animaisGlobais: any[] = [];
  let isAdminGlob = false;
  let modoVisualizacao: 'grid' | 'list' = (localStorage.getItem('takanil_view_mode') as any) || 'grid';

  // Variáveis de Filtro do Modal e Busca
  let termoBusca = '';
  let filtroUrgencia = 'Todos';
  let filtroLocalizacao = 'Todas';
  let filtroEspecie = 'Todas';
  let filtroSexo = 'Todos';
  let filtroClinico = 'Todos';
  let mostrarFinaisFelizes = false;

  // Handler da Barra de Busca por Nome
  const inputBusca = document.getElementById('inputBuscaNome') as HTMLInputElement;
  const btnLimparBusca = document.getElementById('btnLimparBusca');

  inputBusca?.addEventListener('input', () => {
    termoBusca = inputBusca.value.trim().toLowerCase();
    if (termoBusca.length > 0) {
      btnLimparBusca?.classList.remove('hidden');
    } else {
      btnLimparBusca?.classList.add('hidden');
    }
    renderLista(animaisGlobais);
  });

  btnLimparBusca?.addEventListener('click', () => {
    if (inputBusca) {
      inputBusca.value = '';
      termoBusca = '';
      btnLimparBusca.classList.add('hidden');
      inputBusca.focus();
      renderLista(animaisGlobais);
    }
  });

  // Sincronização e alternância do Modo de Visualização (Grade vs Lista)
  function sincronizarUIModoVisualizacao() {
    const btnGrid = document.getElementById('btnModoGrid');
    const btnList = document.getElementById('btnModoList');
    const container = document.getElementById('listaAnimais');

    if (btnGrid && btnList) {
      if (modoVisualizacao === 'grid') {
        btnGrid.className = 'h-10 w-10 flex items-center justify-center rounded-lg text-sm font-bold transition-all bg-taka-green-50 text-taka-green-700 shadow-xs border border-taka-green-200';
        btnList.className = 'h-10 w-10 flex items-center justify-center rounded-lg text-sm font-bold transition-all text-gray-500 hover:text-gray-800';
      } else {
        btnList.className = 'h-10 w-10 flex items-center justify-center rounded-lg text-sm font-bold transition-all bg-taka-green-50 text-taka-green-700 shadow-xs border border-taka-green-200';
        btnGrid.className = 'h-10 w-10 flex items-center justify-center rounded-lg text-sm font-bold transition-all text-gray-500 hover:text-gray-800';
      }
    }

    if (container) {
      if (modoVisualizacao === 'grid') {
        container.className = 'grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4';
      } else {
        container.className = 'flex flex-col gap-3 w-full';
      }
    }
  }

  (window as any).definirModoVisualizacao = (novoModo: 'grid' | 'list') => {
    modoVisualizacao = novoModo;
    try {
      localStorage.setItem('takanil_view_mode', novoModo);
    } catch (_) {}
    sincronizarUIModoVisualizacao();
    renderLista(animaisGlobais);
  };

  // Funções do Modal de Zoom de Fotos
  (window as any).abrirModalZoom = (url: string, nome: string, subtitulo: string) => {
    const modal = document.getElementById('modalZoomFoto');
    const card = document.getElementById('modalZoomCard');
    const img = document.getElementById('modalZoomImg') as HTMLImageElement;
    const titulo = document.getElementById('modalZoomTitulo');
    const sub = document.getElementById('modalZoomSubtitulo');

    if (!modal || !card || !img || !titulo || !sub) return;

    img.src = url || '/assets/takanil-icon-png.png';
    titulo.textContent = nome || 'Animal';
    sub.textContent = subtitulo || '';

    modal.classList.remove('hidden');
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      modal.classList.add('opacity-100');
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    });
  };

  (window as any).fecharModalZoom = () => {
    const modal = document.getElementById('modalZoomFoto');
    const card = document.getElementById('modalZoomCard');
    if (!modal || !card) return;

    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');

    setTimeout(() => {
      modal.classList.add('hidden');
      const img = document.getElementById('modalZoomImg') as HTMLImageElement;
      if (img) img.src = '';
    }, 200);
  };

  // Fechar modals ao pressionar a tecla ESC
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      (window as any).fecharModalZoom();
      (window as any).fecharModalFiltros();
      (window as any).fecharModalEdicao();
    }
  });

  // Fechar Modal Zoom ao clicar no backdrop
  document.getElementById('modalZoomFoto')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('modalZoomFoto')) {
      (window as any).fecharModalZoom();
    }
  });

  // Lógica de abertura/fechamento do Modal de Filtros
  (window as any).abrirModalFiltros = () => {
    document.getElementById('modalFiltros')?.classList.remove('hidden');
    sincronizarUIModalFiltros();
  };

  (window as any).fecharModalFiltros = () => {
    document.getElementById('modalFiltros')?.classList.add('hidden');
  };

  (window as any).limparFiltrosModal = () => {
    filtroUrgencia = 'Todos';
    filtroLocalizacao = 'Todas';
    filtroEspecie = 'Todas';
    filtroSexo = 'Todos';
    filtroClinico = 'Todos';
    sincronizarUIModalFiltros();
    (window as any).aplicarFiltrosModal();
  };

  (window as any).aplicarFiltrosModal = () => {
    (window as any).fecharModalFiltros();
    
    // Atualizar badge no botão Filtrar
    const btnFiltrar = document.getElementById('btnAbrirFiltros');
    const totalFiltrosAtivos = (filtroUrgencia !== 'Todos' ? 1 : 0) + 
                              (filtroLocalizacao !== 'Todas' ? 1 : 0) + 
                              (filtroEspecie !== 'Todas' ? 1 : 0) +
                              (filtroSexo !== 'Todos' ? 1 : 0) +
                              (filtroClinico !== 'Todos' ? 1 : 0);

    if (btnFiltrar) {
      if (totalFiltrosAtivos > 0) {
        btnFiltrar.classList.remove('bg-taka-green-50', 'text-taka-green-700', 'border-taka-green-300');
        btnFiltrar.classList.add('bg-taka-green-600', 'text-white', 'border-taka-green-600');
        btnFiltrar.querySelector('span')!.textContent = `Filtrar (${totalFiltrosAtivos})`;
      } else {
        btnFiltrar.classList.remove('bg-taka-green-600', 'text-white', 'border-taka-green-600');
        btnFiltrar.classList.add('bg-taka-green-50', 'text-taka-green-700', 'border-taka-green-300');
        btnFiltrar.querySelector('span')!.textContent = 'Filtrar';
      }
    }

    if (mostrarFinaisFelizes) {
      mostrarFinaisFelizes = false;
      const btnFinais = document.getElementById('btnFinaisFelizes');
      if (btnFinais) {
        btnFinais.className = 'h-11 w-11 flex items-center justify-center rounded-xl bg-gray-100 text-gray-500 hover:bg-gray-200 active:scale-95 transition-all shadow-xs shrink-0 min-w-[44px] min-h-[44px]';
        btnFinais.blur();
      }
      document.getElementById('tituloSecao')!.innerText = 'Animais Cadastrados';
    }

    renderLista(animaisGlobais);
  };

  function sincronizarUIModalFiltros() {
    // Categoria Urgência
    document.querySelectorAll('.opt-filtro-urgencia').forEach(btn => {
      const val = btn.getAttribute('data-urgencia');
      const check = btn.querySelector('.check-icon');
      if (val === filtroUrgencia) {
        btn.classList.add('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.remove('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.add('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.add('hidden');
      }
    });

    // Categoria Localização
    document.querySelectorAll('.opt-filtro-loc').forEach(btn => {
      const val = btn.getAttribute('data-loc');
      const check = btn.querySelector('.check-icon');
      if (val === filtroLocalizacao) {
        btn.classList.add('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.remove('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.add('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.add('hidden');
      }
    });

    // Categoria Espécie
    document.querySelectorAll('.opt-filtro-especie').forEach(btn => {
      const val = btn.getAttribute('data-especie');
      const check = btn.querySelector('.check-icon');
      if (val === filtroEspecie) {
        btn.classList.add('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.remove('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.add('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.add('hidden');
      }
    });

    // Categoria Sexo
    document.querySelectorAll('.opt-filtro-sexo').forEach(btn => {
      const val = btn.getAttribute('data-sexo');
      const check = btn.querySelector('.check-icon');
      if (val === filtroSexo) {
        btn.classList.add('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.remove('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.add('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.add('hidden');
      }
    });

    // Categoria Status Clínico / Tags
    document.querySelectorAll('.opt-filtro-clinico').forEach(btn => {
      const val = btn.getAttribute('data-clinico');
      const check = btn.querySelector('.check-icon');
      if (val === filtroClinico) {
        btn.classList.add('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.remove('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.add('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.add('hidden');
      }
    });
  }

  // Handlers de seleção dos botões dentro do Modal
  (window as any).selecionarFiltroUrgencia = (val: string) => {
    filtroUrgencia = val;
    sincronizarUIModalFiltros();
  };

  (window as any).selecionarFiltroLocalizacao = (val: string) => {
    filtroLocalizacao = val;
    sincronizarUIModalFiltros();
  };

  (window as any).selecionarFiltroEspecie = (val: string) => {
    filtroEspecie = val;
    sincronizarUIModalFiltros();
  };

  (window as any).selecionarFiltroSexo = (val: string) => {
    filtroSexo = val;
    sincronizarUIModalFiltros();
  };

  (window as any).selecionarFiltroClinico = (val: string) => {
    filtroClinico = val;
    sincronizarUIModalFiltros();
  };

  document.querySelectorAll('.opt-filtro-urgencia').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-urgencia') || 'Todos';
      (window as any).selecionarFiltroUrgencia(val);
    });
  });

  document.querySelectorAll('.opt-filtro-loc').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-loc') || 'Todas';
      (window as any).selecionarFiltroLocalizacao(val);
    });
  });

  document.querySelectorAll('.opt-filtro-especie').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-especie') || 'Todas';
      (window as any).selecionarFiltroEspecie(val);
    });
  });

  document.querySelectorAll('.opt-filtro-sexo').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-sexo') || 'Todos';
      (window as any).selecionarFiltroSexo(val);
    });
  });

  document.querySelectorAll('.opt-filtro-clinico').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-clinico') || 'Todos';
      (window as any).selecionarFiltroClinico(val);
    });
  });

  function renderLista(animais: any[]) {
    let htmlOutput = '';
    
    // Filtro base: Remover óbitos de todas as views públicas
    let baseAnimais = animais.filter(a => a.situacao_urgencia !== 'Óbito');
    let filtrados = baseAnimais;
    const statusFinais = ['Adotado', 'Tutor Encontrado'];

    if (mostrarFinaisFelizes) {
      filtrados = baseAnimais.filter(a => statusFinais.includes(a.situacao_urgencia) || a.status === 'Adotado');
    } else {
      // Normal filters on active animals
      filtrados = baseAnimais.filter(a => !statusFinais.includes(a.situacao_urgencia) && a.status !== 'Adotado');
      
      // Aplicar Busca Textual por Nome (Case-Insensitive)
      if (termoBusca) {
        filtrados = filtrados.filter(a => (a.nome || '').toLowerCase().includes(termoBusca));
      }

      // Aplicar Filtro de Urgência
      if (filtroUrgencia === 'Machucados') {
        filtrados = filtrados.filter(a => a.situacao_urgencia === 'Machucado/Risco');
      } else if (filtroUrgencia === 'Desaparecidos') {
        filtrados = filtrados.filter(a => a.situacao_urgencia === 'Desaparecido' || a.localizacao.includes('Desaparecido'));
      }

      // Aplicar Filtro de Localização
      if (filtroLocalizacao !== 'Todas') {
        filtrados = filtrados.filter(a => a.localizacao === filtroLocalizacao);
      }

      // Aplicar Filtro de Espécie
      if (filtroEspecie !== 'Todas') {
        filtrados = filtrados.filter(a => a.especie === filtroEspecie);
      }

      // Aplicar Filtro de Sexo
      if (filtroSexo !== 'Todos') {
        filtrados = filtrados.filter(a => a.sexo === filtroSexo);
      }

      // Aplicar Filtro de Status Clínico
      if (filtroClinico === 'castrado') {
        filtrados = filtrados.filter(a => a.castrado === 'Sim' || a.castrado === true);
      } else if (filtroClinico === 'vacinado') {
        filtrados = filtrados.filter(a => a.vacinado === 'Sim' || a.vacinado === true);
      }
    }

    if (!filtrados || filtrados.length === 0) {
      if (listaAnimais) {
        listaAnimais.innerHTML = `
          <div class="col-span-full text-center py-10 px-4 bg-gray-50 rounded-2xl border border-dashed border-gray-300">
            <span class="text-3xl mb-2 block">🐾</span>
            <p class="text-gray-600 text-sm font-medium">Nenhum animal encontrado para este filtro.</p>
          </div>`;
      }
      if (totalAnimaisEl) totalAnimaisEl.textContent = '0';
      return;
    }

    const hoje = new Date();

    filtrados.forEach((animal) => {
      const dataCadastro = new Date(animal.created_at);
      const diffTime = Math.abs(hoje.getTime() - dataCadastro.getTime());
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
      
      // Badges
      let badgeUrgencia = '';
      let isResolvido = false;

      if (animal.situacao_urgencia === 'Machucado/Risco') {
        badgeUrgencia = `<span class="inline-block bg-red-100 text-red-700 text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1 shadow-xs border border-red-200">🚨 Urgência Médica</span>`;
      } else if (animal.situacao_urgencia === 'Desaparecido' || animal.localizacao.includes('Desaparecido')) {
        badgeUrgencia = `<span class="inline-block bg-yellow-100 text-yellow-800 text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1 shadow-xs border border-yellow-200">🔍 Desaparecido</span>`;
      } else if (animal.situacao_urgencia === 'Adotado') {
        badgeUrgencia = `<span class="inline-block bg-green-100 text-green-800 text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1 shadow-xs border border-green-200">✅ Adotado</span>`;
        isResolvido = true;
      } else if (animal.situacao_urgencia === 'Tutor Encontrado') {
        badgeUrgencia = `<span class="inline-block bg-taka-green-100 text-taka-green-800 text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1 shadow-xs border border-taka-green-200">🏠 Voltou pro Tutor</span>`;
        isResolvido = true;
      }

      // Badges Secundárias (Tags)
      let tags = '';
      if (animal.sexo === 'Macho') tags += `<span class="bg-taka-green-50 text-taka-green-700 border border-taka-green-200/60 text-[10px] sm:text-xs font-medium px-1.5 py-0.5 rounded">♂ Macho</span> `;
      if (animal.sexo === 'Fêmea') tags += `<span class="bg-pink-50 text-pink-700 border border-pink-200/60 text-[10px] sm:text-xs font-medium px-1.5 py-0.5 rounded">♀ Fêmea</span> `;
      if (animal.sexo === 'Misto (Ninhada)') tags += `<span class="bg-purple-50 text-purple-700 border border-purple-200/60 text-[10px] sm:text-xs font-medium px-1.5 py-0.5 rounded">♂♀ Misto</span> `;
      if (animal.quantidade > 1) tags += `<span class="bg-gray-100 text-gray-700 border border-gray-200 text-[10px] sm:text-xs font-medium px-1.5 py-0.5 rounded">📦 ${animal.quantidade} animais</span> `;
      if (animal.vacinado === 'Sim') tags += `<span class="bg-taka-green-50 text-taka-green-700 border border-taka-green-200/60 text-[10px] sm:text-xs font-medium px-1.5 py-0.5 rounded">💉 Vacinado</span> `;
      if (animal.castrado === 'Sim') tags += `<span class="bg-purple-50 text-purple-700 border border-purple-200/60 text-[10px] sm:text-xs font-medium px-1.5 py-0.5 rounded">✂️ Castrado</span> `;

      const imgUrl = animal.imagem_url || '/assets/takanil-icon-png.png';
      const subtituloZoom = `${animal.especie || 'Animal'} • ${animal.sexo || ''} • ${animal.peso ? animal.peso + 'kg' : ''} • ${animal.localizacao || ''}`;
      const nomeSanitizado = (animal.nome || '').replace(/'/g, "\\'");
      const subtituloSanitizado = subtituloZoom.replace(/'/g, "\\'");

      if (modoVisualizacao === 'grid') {
        // Modo Grade (2 Colunas Mobile / 3-4 Desktop)
        htmlOutput += `
          <div class="bg-white rounded-2xl shadow-xs border border-gray-200/90 overflow-hidden flex flex-col justify-between group relative hover:shadow-md transition-all ${isResolvido ? 'bg-gray-50 border-gray-200 opacity-75' : ''}">
            <!-- Foto Aspect Ratio 1:1 com Toque para Zoom -->
            <div class="relative aspect-square w-full bg-gray-100 overflow-hidden">
              <img 
                src="${imgUrl}" 
                class="w-full h-full object-cover cursor-pointer hover:scale-105 transition-transform duration-300" 
                alt="${animal.nome}"
                onclick="abrirModalZoom('${imgUrl}', '${nomeSanitizado}', '${subtituloSanitizado}')"
              >
              <!-- Badges e Botão de Zoom sobrepostos -->
              <div class="absolute top-2 left-2 right-2 flex justify-between items-start pointer-events-none">
                <div class="pointer-events-auto">
                  ${badgeUrgencia}
                </div>
                <button 
                  type="button"
                  onclick="abrirModalZoom('${imgUrl}', '${nomeSanitizado}', '${subtituloSanitizado}')"
                  aria-label="Ampliar foto de ${animal.nome}"
                  class="pointer-events-auto bg-black/60 hover:bg-black/85 text-white rounded-full p-2 backdrop-blur-xs transition-colors shadow-xs min-w-[36px] min-h-[36px] flex items-center justify-center"
                  title="Ampliar foto"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
