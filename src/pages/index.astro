          <img src="/assets/insta-logo.png" alt="Instagram" class="w-8 h-8 object-contain shrink-0" />
          <div class="min-w-0 flex-1">
            <div class="font-bold text-sm">Instagram</div>
            <div class="text-xs text-pink-700">Copia texto/link e abre o Instagram</div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-pink-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </button>

        <!-- Opção Copiar Texto e Link -->
        <button type="button" onclick="executarCompartilhamento('copiar')" class="w-full flex items-center gap-3.5 p-3.5 rounded-2xl border border-gray-200 bg-gray-50 hover:bg-gray-100 text-gray-800 transition-all active:scale-[0.98] min-h-[48px] text-left">
          <span class="text-2xl w-8 text-center shrink-0">📋</span>
