            <!-- Detalhes do Animal -->
            <div class="p-3 sm:p-3.5 flex flex-col justify-between flex-1 gap-2">
              <div>
                <h4 class="text-base sm:text-lg font-bold text-gray-900 truncate ${isResolvido ? 'line-through text-gray-400' : ''}">${animal.nome}</h4>
                <p class="text-xs sm:text-sm text-gray-600 truncate mt-0.5 font-medium">${animal.fase_vida || ''} • ${animal.peso || 0}kg</p>
                
                <div class="mt-1.5 flex flex-wrap items-center gap-1">
                  ${tags}
                  ${animal.instagram_url ? `
                    <a 
                      href="${animal.instagram_url}" 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      onclick="event.stopPropagation()" 
                      class="inline-flex items-center gap-1 text-[11px] font-semibold text-pink-600 hover:text-pink-700 bg-pink-50 hover:bg-pink-100 px-2 py-0.5 rounded-md border border-pink-200/80 transition-all hover:scale-105 active:scale-95"
