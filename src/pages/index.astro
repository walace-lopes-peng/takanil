  // Função para deletar animal e imagem associada
  (window as any).deletarAnimal = async (id: string, imagem_url: string, nome: string) => {
    const confirmou = await (window as any).confirmarAcao({
      titulo: 'Excluir cadastro do animal?',
      mensagem: `Tem certeza que deseja excluir o cadastro de "${nome}" e apagar a foto permanentemente?`,
      textoConfirmar: 'Sim, Excluir',
      tipo: 'perigo'
    });
    if (!confirmou) return;
    
    try {
      // 1. Tentar deletar imagem do storage
      if (imagem_url) {
        const urlParts = imagem_url.split('/');
        const fileName = urlParts[urlParts.length - 1];
        await supabase.storage.from('animais').remove([fileName]);
      }

      // 2. Deletar registro do banco
      const { error } = await supabase.from('animais').delete().eq('id', id);
      if (error) throw error;

      carregarDados();
      (window as any).mostrarToast('Registro excluído com sucesso!', 'sucesso');
    } catch (err) {
      console.error(err);
      (window as any).mostrarToast('Erro ao excluir o registro.', 'erro');
    }
  };

  // Helper para obter a URL base pública (garantindo que o WhatsApp no celular torne o link clicável)
  function obterUrlBaseApp(): string {
    if (typeof window === 'undefined') return 'https://hub-takanil.vercel.app';
    const host = window.location.hostname;
    // Se estiver testando localmente (localhost ou IP local), usa o domínio público da Vercel
    // para que o WhatsApp reconheça a URL com domínio real e a deixe clicável no celular!
    if (host === 'localhost' || host === '127.0.0.1' || host.startsWith('192.168.') || host.startsWith('10.')) {
      return 'https://hub-takanil.vercel.app';
    }
    return window.location.origin;
  }

  // 1. Contato direto com a Takanil via WhatsApp oficial (wa.me)
  (window as any).falarComTakanil = (id: string) => {
    const animal = animaisGlobais.find(a => a.id === id);
    if (!animal) return;
    const urlApp = `${obterUrlBaseApp()}/?animal=${animal.id}`;
    abrirWhatsAppDireto(animal, '5535998687395', urlApp);
  };

  // Mantido para retrocompatibilidade
  (window as any).compartilharWhatsApp = (window as any).falarComTakanil;

  // 2. Abre o menu de opções para a pessoa escolher onde compartilhar
  (window as any).compartilharAnimal = (id: string) => {
    const animal = animaisGlobais.find(a => a.id === id);
    if (!animal) return;
    animalParaCompartilhar = animal;

    const tituloEl = document.getElementById('modalCompartilharTitulo');
    if (tituloEl) {
      tituloEl.textContent = `Compartilhar ${animal.nome || 'Animal'}`;
    }

    const modal = document.getElementById('modalCompartilhar');
    const backdrop = document.getElementById('modalCompartilharBackdrop');
    if (!modal || !backdrop) return;

    backdrop.classList.remove('hidden');
    modal.classList.remove('hidden');
    requestAnimationFrame(() => {
      backdrop.classList.remove('opacity-0');
      backdrop.classList.add('opacity-100');
      modal.classList.remove('translate-y-full', 'sm:opacity-0');
      modal.classList.add('translate-y-0', 'sm:opacity-100');
    });
  };

  (window as any).fecharModalCompartilhar = () => {
    const modal = document.getElementById('modalCompartilhar');
    const backdrop = document.getElementById('modalCompartilharBackdrop');
    if (!modal || !backdrop) return;

    backdrop.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');
    modal.classList.remove('translate-y-0', 'sm:opacity-100');
    modal.classList.add('translate-y-full', 'sm:opacity-0');

    setTimeout(() => {
      modal.classList.add('hidden');
      backdrop.classList.add('hidden');
    }, 200);
  };

  (window as any).executarCompartilhamento = async (destino: 'whatsapp' | 'instagram' | 'copiar') => {
    if (!animalParaCompartilhar) return;
    const urlApp = `${obterUrlBaseApp()}/?animal=${animalParaCompartilhar.id}`;
    const mensagem = gerarMensagemCompartilhamentoPublico(animalParaCompartilhar, urlApp);

    (window as any).fecharModalCompartilhar();

    if (destino === 'whatsapp') {
      window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(mensagem)}`, '_blank');
      (window as any).mostrarToast?.('Abrindo WhatsApp para escolher conversa... 💬', 'sucesso');
    } else if (destino === 'instagram') {
      if (typeof navigator !== 'undefined' && navigator.clipboard) {
        await navigator.clipboard.writeText(mensagem);
      }
      (window as any).mostrarToast?.('Mensagem copiada! Abrindo o Instagram... 📸', 'sucesso');
      setTimeout(() => {
        window.open('https://www.instagram.com', '_blank');
      }, 500);
    } else if (destino === 'copiar') {
      if (typeof navigator !== 'undefined' && navigator.clipboard) {
        await navigator.clipboard.writeText(mensagem);
      }
      (window as any).mostrarToast?.('Mensagem e link copiados com sucesso! 📋✨', 'sucesso');
    }
  };

  // Botão Finais Felizes
  (window as any).alternarFinaisFelizes = () => {
    mostrarFinaisFelizes = !mostrarFinaisFelizes;
    const btn = document.getElementById('btnFinaisFelizes');
    const labelAnimais = document.getElementById('labelTotalAnimais');
    btn?.blur(); // Remove o foco/hover preso no toque mobile
    
    if (mostrarFinaisFelizes) {
      if (btn) btn.className = 'h-11 w-11 flex items-center justify-center rounded-xl bg-pink-100 text-pink-600 border border-pink-300 scale-105 active:scale-95 transition-all shadow-xs shrink-0 min-w-[44px] min-h-[44px]';
      if (labelAnimais) labelAnimais.innerText = 'Finais Felizes 💖';
    } else {
      if (btn) btn.className = 'h-11 w-11 flex items-center justify-center rounded-xl bg-gray-100 text-gray-500 hover:bg-gray-200 active:scale-95 transition-all shadow-xs shrink-0 min-w-[44px] min-h-[44px]';
      if (labelAnimais) labelAnimais.innerText = 'Animais';
      
      // Restaura os filtros padrões
      filtroUrgencia = 'Todos';
      filtroLocalizacao = 'Todas';
      filtroEspecie = 'Todas';
      filtroSexo = 'Todos';
      filtroClinico = 'Todos';
      sincronizarUIModalFiltros();
      const btnFiltrar = document.getElementById('btnAbrirFiltros');
      if (btnFiltrar) {
        btnFiltrar.classList.remove('bg-taka-green-600', 'text-white', 'border-taka-green-600');
        btnFiltrar.classList.add('bg-taka-green-50', 'text-taka-green-700', 'border-taka-green-300');
        btnFiltrar.querySelector('span')!.textContent = 'Filtrar';
      }
    }
    renderLista(animaisGlobais);
  };

  // === Dropdown de Status (substitui o modal antigo e os botões de desfecho) ===

  // Fechar dropdown de status
  (window as any).fecharDropdownStatus = () => {
    document.getElementById('dropdownStatus')?.classList.add('hidden');
    document.getElementById('dropdownStatusBackdrop')?.classList.add('hidden');
  };

  // Abrir dropdown posicionado perto do botão que o disparou
  (window as any).abrirDropdownStatus = (id: string, urgencia: string, status: string, nome: string, event: MouseEvent) => {
    const dropdown = document.getElementById('dropdownStatus');
    const backdrop = document.getElementById('dropdownStatusBackdrop');
    const opcoesContainer = document.getElementById('dropdownStatusOpcoes');
    const titulo = document.getElementById('dropdownStatusTitulo');
    if (!dropdown || !backdrop || !opcoesContainer || !titulo) return;

    titulo.textContent = nome || 'Mudar status';

    // Monta as opções dinamicamente conforme o status atual do animal
    const statusFinais = ['Adotado', 'Tutor Encontrado'];
    const estaResolvido = statusFinais.includes(urgencia) || status === 'Adotado';

    interface OpcaoStatus {
      icone: string;
      texto: string;
      novosDados: Record<string, string | null>;
      toast: string;
      cor: string;
    }

    const opcoes: OpcaoStatus[] = [];

    if (estaResolvido) {
      // Animal resolvido (Finais Felizes): permite voltar a disponível ou retificar status
      opcoes.push({
        icone: '↩️', texto: 'Voltar ao normal',
        novosDados: { situacao_urgencia: 'Nenhuma', status: 'Disponível' },
        toast: `${nome} voltou para a lista principal como disponível`,
        cor: 'text-gray-700 hover:bg-gray-50 font-semibold'
      });
      if (urgencia !== 'Tutor Encontrado') {
        opcoes.push({
          icone: '🏠', texto: 'Voltou pro tutor',
          novosDados: { situacao_urgencia: 'Tutor Encontrado', status: 'Disponível' },
          toast: `${nome} voltou para o tutor!`,
          cor: 'text-taka-green-700 hover:bg-taka-green-50'
        });
      }
      if (urgencia !== 'Adotado' && status !== 'Adotado') {
        opcoes.push({
          icone: '💚', texto: 'Marcar como adotado',
          novosDados: { situacao_urgencia: 'Adotado', status: 'Adotado' },
          toast: `${nome} foi adotado(a)!`,
          cor: 'text-taka-green-700 hover:bg-taka-green-50'
        });
      }
      opcoes.push({
        icone: '🚨', texto: 'Urgência médica',
        novosDados: { situacao_urgencia: 'Machucado/Risco', status: 'Disponível' },
        toast: `${nome} marcado com urgência médica`,
        cor: 'text-red-700 hover:bg-red-50'
      });
      opcoes.push({
        icone: '✝️', texto: 'Registrar óbito',
        novosDados: { situacao_urgencia: 'Óbito', status: 'Disponível' },
        toast: `${nome} registrado como óbito`,
        cor: 'text-gray-500 hover:bg-gray-50'
      });
    } else {
      // Animal ativo: opções contextuais
      opcoes.push({
        icone: '💚', texto: 'Marcar como adotado',
        novosDados: { situacao_urgencia: 'Adotado', status: 'Adotado' },
        toast: `${nome} foi adotado(a)!`,
        cor: 'text-taka-green-700 hover:bg-taka-green-50'
      });
      opcoes.push({
        icone: '🏠', texto: 'Voltou pro tutor',
        novosDados: { situacao_urgencia: 'Tutor Encontrado', status: 'Disponível' },
        toast: `${nome} voltou para o tutor!`,
        cor: 'text-taka-green-700 hover:bg-taka-green-50'
      });

      if (urgencia === 'Machucado/Risco') {
        opcoes.push({
          icone: '🩺', texto: 'Marcar como curado',
          novosDados: { situacao_urgencia: 'Nenhuma', status: 'Disponível' },
          toast: `${nome} está recuperado(a)!`,
          cor: 'text-blue-700 hover:bg-blue-50'
        });
      } else {
        opcoes.push({
          icone: '🚨', texto: 'Urgência médica',
          novosDados: { situacao_urgencia: 'Machucado/Risco', status: 'Disponível' },
          toast: `${nome} marcado com urgência médica`,
          cor: 'text-red-700 hover:bg-red-50'
        });
      }

      if (urgencia !== 'Desaparecido') {
        opcoes.push({
          icone: '🔍', texto: 'Marcar como desaparecido',
          novosDados: { situacao_urgencia: 'Desaparecido', status: 'Disponível' },
          toast: `${nome} marcado como desaparecido`,
          cor: 'text-yellow-700 hover:bg-yellow-50'
        });
      } else {
        opcoes.push({
          icone: '↩️', texto: 'Remover desaparecido',
          novosDados: { situacao_urgencia: 'Nenhuma', status: 'Disponível' },
          toast: `${nome} não está mais desaparecido`,
          cor: 'text-gray-700 hover:bg-gray-50'
        });
      }

      opcoes.push({
        icone: '✝️', texto: 'Registrar óbito',
        novosDados: { situacao_urgencia: 'Óbito', status: 'Disponível' },
        toast: `${nome} registrado como óbito`,
        cor: 'text-gray-500 hover:bg-gray-50'
      });
    }

    // Renderizar opções como botões
    opcoesContainer.innerHTML = opcoes.map(op => `
      <button 
        type="button"
        onclick="event.stopPropagation(); mudarStatus('${id}', ${JSON.stringify(op.novosDados).replace(/'/g, "&#39;").replace(/"/g, '&quot;')}, '${urgencia}', '${status || ''}', '${nome.replace(/'/g, "\\'")}'  , '${op.toast.replace(/'/g, "\\'")}')" 
        class="w-full text-left px-4 py-3 text-sm font-medium flex items-center gap-3 transition-colors active:scale-[0.98] min-h-[44px] ${op.cor}"
      >
        <span class="text-base">${op.icone}</span>
        <span>${op.texto}</span>
      </button>
    `).join('');

    // Posicionar dropdown perto do botão clicado
    const btn = event.currentTarget as HTMLElement;
    const rect = btn.getBoundingClientRect();
    const dropdownAltura = 300; // estimativa
    const espacoAbaixo = window.innerHeight - rect.bottom;

    dropdown.style.left = Math.max(8, Math.min(rect.left, window.innerWidth - 268)) + 'px';
    if (espacoAbaixo > dropdownAltura) {
      dropdown.style.top = (rect.bottom + 4) + 'px';
    } else {
      dropdown.style.top = Math.max(8, rect.top - dropdownAltura) + 'px';
    }

    backdrop.classList.remove('hidden');
    dropdown.classList.remove('hidden');
  };

  // Mudar status com undo via toast (sem confirm() prévio — a reversão é o safety net)
  (window as any).mudarStatus = async (id: string, novosDadosArg: any, urgenciaAnterior: string, statusAnterior: string, nome: string, toastMsg: string) => {
    let novosDados: Record<string, string | null>;
    if (typeof novosDadosArg === 'object' && novosDadosArg !== null) {
      novosDados = novosDadosArg;
    } else {
      try {
        novosDados = JSON.parse(novosDadosArg);
      } catch {
        novosDados = JSON.parse(decodeURIComponent(novosDadosArg));
      }
    }

    (window as any).fecharDropdownStatus();

    try {
      const { error } = await supabase
        .from('animais')
        .update(novosDados)
        .eq('id', id);

      if (error) throw error;

      carregarDados();

      // Toast com botão "Desfazer" por 5 segundos
      (window as any).mostrarToast(toastMsg, 'sucesso', {
        duracao: 5000,
        acao: {
          texto: 'Desfazer',
          callback: async () => {
            try {
              // Restaurar dados anteriores
              const dadosAnteriores: Record<string, string | null> = { situacao_urgencia: urgenciaAnterior || 'Nenhuma' };
              dadosAnteriores.status = (statusAnterior === 'Adotado') ? 'Adotado' : 'Disponível';

              const { error: errUndo } = await supabase
                .from('animais')
                .update(dadosAnteriores)
                .eq('id', id);

              if (errUndo) throw errUndo;
              carregarDados();
              (window as any).mostrarToast(`Status de ${nome} restaurado`, 'info');
            } catch (e) {
              console.error(e);
              (window as any).mostrarToast('Erro ao desfazer. Tente pela ficha do animal.', 'erro');
            }
          }
        }
      });
    } catch (err: any) {
      console.error('Erro ao atualizar status do animal:', err);
      (window as any).mostrarToast(err?.message || 'Erro ao atualizar o status do animal.', 'erro');
    }
  };



  async function carregarDados() {
    const { data: animaisOriginais, error } = await supabase
      .from('animais')
      .select('*')
      .order('created_at', { ascending: false });

    // Manter todos os animais aprovados (incluindo adotados para a visualização de Finais Felizes)
    const animais = animaisOriginais?.filter(a => a.status_moderacao === 'aprovado') || [];
    let pendentes = animaisOriginais?.filter(a => a.status_moderacao === 'pendente') || [];

    const role = await getUserRole();
    isAdminGlob = role === 'adm' || role === 'dev';
    const isAdmin = isAdminGlob;

    // Se não for admin, não mostra o banner de pendentes
    if (!isAdmin) {
      pendentes = [];
    }

    // Lógica do FAB Inteligente
    const { data: { session } } = await supabase.auth.getSession();
    const fab = document.getElementById('fabAddAnimal') as HTMLAnchorElement;
    const fabIcon = document.getElementById('fabIcon');
    const fabText = document.getElementById('fabText');
    
    if (session && isAdminGlob) {
      const fabAssociar = document.getElementById('fabAssociar');
      if (fabAssociar) fabAssociar.style.display = 'none';
      
      if (fab) {
        fab.href = '/animais/novo';
        fab.className = 'backdrop-blur-md text-white border border-taka-orange-400 rounded-full flex items-center justify-center shadow-lg hover:shadow-xl active:scale-95 transition-all duration-300 px-3 opacity-50 shadow-taka-orange-500/30';
        fab.style.backgroundColor = 'rgba(254, 118, 32, 0.85)'; // taka-orange
      }
      if (fabIcon) fabIcon.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 drop-shadow-sm" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>`;
      if (fabIcon) fabIcon.className = ''; 
      if (fabText) {
        fabText.innerText = 'CADASTRAR';
        fabText.style.display = 'block';
      }
    }

    // Lógica de recolher (collapse) os FABs no scroll
    const fabAssociar = document.getElementById('fabAssociar');
    const fabAssociarText = document.getElementById('fabAssociarText');
    const fabInstagram = document.getElementById('fabInstagram');
    const fabInstagramText = document.getElementById('fabInstagramText');
    let scrollTimeout: number;

    const setFabState = (collapsed: boolean) => {
      const stateConfigs = [
        { btn: fab, text: fabText },
        { btn: fabAssociar, text: fabAssociarText },
        { btn: fabInstagram, text: fabInstagramText }
      ];

      stateConfigs.forEach(({ btn, text }) => {
        if (!btn || !text) return;
        
        if (collapsed) {
          // Recolher: esconde texto, tira gap, reduz opacidade do botão
          text.style.maxWidth = '0px';
          text.style.opacity = '0';
          btn.classList.remove('px-4', 'py-3', 'gap-2');
          btn.classList.add('px-3');
          btn.style.opacity = '0.5';
        } else {
          // Expandir: mostra texto
          text.style.maxWidth = '100px';
          text.style.opacity = '1';
          btn.classList.add('px-4', 'py-3', 'gap-2');
          btn.classList.remove('px-3');
          btn.style.opacity = '1';
        }
      });
    };

    // Estado inicial já vem recolhido no HTML. Apenas garantimos a variável
    let isCollapsed = true;

    window.addEventListener('scroll', () => {
      // Ao começar a rolar, expande (se estiver recolhido)
      if (isCollapsed) {
        setFabState(false);
        isCollapsed = false;
      }

      // Limpa o temporizador se a pessoa continuar rolando
      clearTimeout(scrollTimeout);

      // Define um novo temporizador de 1 segundo para recolher após PARAR de rolar
      scrollTimeout = window.setTimeout(() => {
        setFabState(true);
        isCollapsed = true;
      }, 1000);
    }, { passive: true });

    if (error) {
      console.error(error);
      if (loadingState) loadingState.innerHTML = '<span class="text-red-500">Erro ao carregar os dados.</span>';
      return;
    }

    if (loadingState) loadingState.style.display = 'none';

    if (pendentes.length > 0) {
      if (bannerPendentes) bannerPendentes.classList.remove('hidden');
      if (qtdPendentes) qtdPendentes.textContent = pendentes.length.toString();
    } else {
      if (bannerPendentes) bannerPendentes.classList.add('hidden');
    }

    animaisGlobais = animais;
    
    let totalRacao = 0;
    const statusFinais = ['Adotado', 'Tutor Encontrado'];

    animais.forEach((animal) => {
      const isResolvido = animal.status === 'Adotado' || statusFinais.includes(animal.situacao_urgencia);
      if (!isResolvido && animal.localizacao === 'Abrigo Takanil' && animal.peso) {
        totalRacao += (animal.peso * 0.015) * 30;
      }
    });

    if (totalRacaoEl) totalRacaoEl.textContent = totalRacao.toFixed(1);

    // Primeira renderização da vitrine normal
    renderLista(animaisGlobais);
  }
  
  // Iniciar
  sincronizarUIModoVisualizacao();
  carregarDados();
</script>
