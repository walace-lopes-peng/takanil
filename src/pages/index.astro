---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hub Takanil - Dashboard">
  
  <div class="space-y-6 pb-20">
    
    <!-- Header / Ração -->
    <div class="bg-blue-600 text-white rounded-2xl p-6 shadow-sm">
      <h2 class="text-sm font-medium text-blue-100 mb-1">Previsão de Ração (Mensal)</h2>
      <div class="flex items-baseline space-x-2">
        <span class="text-4xl font-bold" id="totalRacao">--</span>
        <span class="text-blue-200">kg/mês</span>
      </div>
      <p class="text-xs text-blue-200 mt-2">*Apenas para animais no Abrigo Takanil (aprox. 1.5% peso/dia)</p>
    </div>

    <!-- Banner de Pendências -->
    <a href="/aprovacoes" id="bannerPendentes" class="hidden block bg-yellow-50 border border-yellow-200 rounded-xl p-4 shadow-sm hover:bg-yellow-100 transition-colors mb-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-xl">🛎️</span>
          <div>
            <h3 class="font-bold text-yellow-800 text-sm">Sugestões Pendentes</h3>
            <p class="text-xs text-yellow-700 mt-0.5">Você tem <span id="qtdPendentes" class="font-bold">0</span> animal(is) aguardando aprovação.</p>
          </div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-yellow-600" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
        </svg>
      </div>
    </a>

    <!-- Moderação / Alertas -->
    <div id="alertasContainer" class="hidden">
      <h3 class="text-sm font-bold text-red-600 mb-3 uppercase tracking-wider">⚠️ Revisão Necessária (10+ dias)</h3>
      <div id="listaAlertas" class="space-y-3">
        <!-- Inserido via JS -->
      </div>
    </div>

    <!-- Filtros por Urgência (Chips) -->
    <div class="relative flex items-center group">
      <!-- Seta Esquerda -->
      <button id="scrollLeftBtn" class="absolute left-0 top-1/2 -translate-y-1/2 bg-white/90 backdrop-blur shadow-sm p-1.5 rounded-full hidden md:flex items-center justify-center text-gray-600 hover:text-gray-900 border border-gray-200 z-10 cursor-pointer -ml-2" title="Rolar para esquerda">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <div class="flex overflow-x-auto pb-3 pt-1 px-2 gap-2 w-full" style="scrollbar-width: none;" id="botoesFiltro">
        <button class="filtro-btn px-4 py-1.5 rounded-full text-sm font-medium whitespace-nowrap transition-colors flex-shrink-0 bg-gray-900 text-white" data-filtro="Todos">Todos</button>
        <button class="filtro-btn px-4 py-1.5 rounded-full text-sm font-medium whitespace-nowrap transition-colors flex-shrink-0 bg-gray-100 text-gray-600 hover:bg-gray-200" data-filtro="Urgências">🚨 Machucados</button>
        <button class="filtro-btn px-4 py-1.5 rounded-full text-sm font-medium whitespace-nowrap transition-colors flex-shrink-0 bg-gray-100 text-gray-600 hover:bg-gray-200" data-filtro="Desaparecidos">🔍 Desaparecidos</button>
        <button class="filtro-btn px-4 py-1.5 rounded-full text-sm font-medium whitespace-nowrap transition-colors flex-shrink-0 bg-gray-100 text-gray-600 hover:bg-gray-200" data-filtro="Abrigo">🏡 No Abrigo</button>
      </div>
      
      <!-- Seta Direita -->
      <button id="scrollRightBtn" class="absolute right-0 top-1/2 -translate-y-1/2 bg-white/90 backdrop-blur shadow-sm p-1.5 rounded-full hidden md:flex items-center justify-center text-gray-600 hover:text-gray-900 border border-gray-200 z-10 cursor-pointer -mr-2" title="Rolar para direita">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Todos os Animais -->
    <div>
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold text-gray-800">Animais Cadastrados</h3>
        <span class="bg-gray-200 text-gray-700 text-xs font-bold px-2 py-1 rounded-full" id="totalAnimais">0</span>
      </div>
      <div id="listaAnimais" class="space-y-4">
        <div class="text-center py-8 text-gray-400 text-sm" id="loadingState">
          <svg class="animate-spin mx-auto h-8 w-8 text-gray-300 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Carregando dados...
        </div>
        <!-- Inserido via JS -->
      </div>
    </div>
  </div>

  <!-- Botão Flutuante (FAB) -->
  <a href="/sugerir-animal" id="fabAddAnimal" class="fixed bottom-24 right-6 bg-blue-600 text-white rounded-full flex items-center justify-center shadow-lg hover:bg-blue-700 active:scale-95 transition-all z-30 px-5 h-14 gap-2">
    <span id="fabIcon" class="text-xl">📣</span>
    <span id="fabText" class="font-bold text-sm whitespace-nowrap">Sugerir</span>
  </a>

</Layout>

<script>
  import { supabase, getUserRole } from '../lib/supabaseClient';

  const listaAnimais = document.getElementById('listaAnimais');
  const listaAlertas = document.getElementById('listaAlertas');
  const alertasContainer = document.getElementById('alertasContainer');
  const totalRacaoEl = document.getElementById('totalRacao');
  const totalAnimaisEl = document.getElementById('totalAnimais');
  const loadingState = document.getElementById('loadingState');
  const bannerPendentes = document.getElementById('bannerPendentes');
  const qtdPendentes = document.getElementById('qtdPendentes');

  let animaisGlobais: any[] = [];
  let isAdminGlob = false;
  let filtroAtual = 'Todos';

  // Configurar botões de filtro
  document.getElementById('botoesFiltro')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.filtro-btn');
    if (!btn) return;
    
    document.querySelectorAll('.filtro-btn').forEach(b => {
      b.classList.remove('bg-gray-900', 'text-white');
      b.classList.add('bg-gray-100', 'text-gray-600');
    });
    btn.classList.remove('bg-gray-100', 'text-gray-600');
    btn.classList.add('bg-gray-900', 'text-white');

    filtroAtual = btn.getAttribute('data-filtro') || 'Todos';
    renderLista(animaisGlobais);
  });

  // Scroll horizontal com mouse wheel e seta no desktop
  const filtrosContainer = document.getElementById('botoesFiltro');
  const scrollRightBtn = document.getElementById('scrollRightBtn');
  const scrollLeftBtn = document.getElementById('scrollLeftBtn');
  
  if (filtrosContainer) {
    filtrosContainer.addEventListener('wheel', (e) => {
      // Se não estiver rolando perfeitamente vertical, converte em scroll horizontal
      if (Math.abs(e.deltaY) > 0) {
        e.preventDefault();
        filtrosContainer.scrollLeft += e.deltaY;
      }
    });

    scrollRightBtn?.addEventListener('click', () => {
      filtrosContainer.scrollBy({ left: 150, behavior: 'smooth' });
    });

    scrollLeftBtn?.addEventListener('click', () => {
      filtrosContainer.scrollBy({ left: -150, behavior: 'smooth' });
    });
  }

  function renderLista(animais: any[]) {
    let htmlNormal = '';
    let filtrados = animais;

    if (filtroAtual === 'Urgências') {
      filtrados = animais.filter(a => a.situacao_urgencia === 'Machucado/Risco');
    } else if (filtroAtual === 'Desaparecidos') {
      filtrados = animais.filter(a => a.situacao_urgencia === 'Desaparecido' || a.localizacao.includes('Desaparecido'));
    } else if (filtroAtual === 'Abrigo') {
      filtrados = animais.filter(a => a.localizacao === 'Abrigo Takanil');
    }

    if (!filtrados || filtrados.length === 0) {
      if (listaAnimais) {
        listaAnimais.innerHTML = `
          <div class="text-center py-10 px-4 bg-gray-50 rounded-2xl border border-dashed border-gray-300">
            <span class="text-3xl mb-2 block">🐾</span>
            <p class="text-gray-500 text-sm">Nenhum animal encontrado para este filtro.</p>
          </div>`;
      }
      if (totalAnimaisEl) totalAnimaisEl.textContent = '0';
      return;
    }

    const hoje = new Date();

    filtrados.forEach((animal) => {
      const dataCadastro = new Date(animal.created_at);
      const diffTime = Math.abs(hoje.getTime() - dataCadastro.getTime());
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 

      const dataFormatada = dataCadastro.toLocaleDateString('pt-BR');

      // Badge de Urgência
      let badgeUrgencia = '';
      let imgStyle = '';
      if (animal.situacao_urgencia === 'Machucado/Risco') {
        badgeUrgencia = `<span class="inline-block bg-red-100 text-red-700 text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1">🚨 Urgência Médica</span>`;
      } else if (animal.situacao_urgencia === 'Desaparecido' || animal.localizacao.includes('Desaparecido')) {
        badgeUrgencia = `<span class="inline-block bg-yellow-100 text-yellow-800 text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1">🔍 Desaparecido</span>`;
      }

      // Badges Secundárias (Tags)
      let tags = '';
      if (animal.sexo === 'Macho') tags += `<span class="bg-blue-50 text-blue-600 text-[10px] px-1.5 py-0.5 rounded">♂ Macho</span> `;
      if (animal.sexo === 'Fêmea') tags += `<span class="bg-pink-50 text-pink-600 text-[10px] px-1.5 py-0.5 rounded">♀ Fêmea</span> `;
      if (animal.sexo === 'Misto (Ninhada)') tags += `<span class="bg-purple-50 text-purple-600 text-[10px] px-1.5 py-0.5 rounded">♂♀ Misto</span> `;
      if (animal.quantidade > 1) tags += `<span class="bg-gray-100 text-gray-600 text-[10px] px-1.5 py-0.5 rounded">📦 ${animal.quantidade} animais</span> `;
      if (animal.vacinado === 'Sim') tags += `<span class="bg-blue-50 text-blue-600 text-[10px] px-1.5 py-0.5 rounded">💉 Vacinado</span> `;
      if (animal.castrado === 'Sim') tags += `<span class="bg-purple-50 text-purple-600 text-[10px] px-1.5 py-0.5 rounded">✂️ Castrado</span> `;

      htmlNormal += `
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex gap-4 items-center group relative ${diffDays > 10 ? 'border-l-4 border-l-gray-300' : ''}">
          <img src="${animal.imagem_url || ''}" class="w-20 h-20 rounded-lg object-cover bg-gray-100 flex-shrink-0 ${imgStyle}" alt="${animal.nome}">
          <div class="flex-1 min-w-0 pr-8">
            ${badgeUrgencia}
            <h4 class="text-lg font-bold text-gray-800 truncate">${animal.nome}</h4>
            <p class="text-xs text-gray-500 truncate mt-0.5">${animal.fase_vida} • ${animal.peso}kg</p>
            <div class="mt-1.5 flex flex-wrap gap-1">
              ${tags}
            </div>
            <p class="text-[10px] font-medium text-blue-600 mt-1.5 truncate">📍 ${animal.localizacao}</p>
            <p class="text-[9px] text-gray-400 mt-0.5">Cadastrado em ${dataFormatada}</p>
          </div>
          ${isAdminGlob ? `
          <!-- Botão Excluir Registro -->
          <button 
            onclick="deletarAnimal('${animal.id}', '${animal.imagem_url || ''}', '${animal.nome}')" 
            title="Excluir cadastro" 
            class="absolute top-4 right-4 p-2 text-gray-300 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
          ` : ''}
        </div>
      `;
    });

    if (listaAnimais) listaAnimais.innerHTML = htmlNormal;
    if (totalAnimaisEl) totalAnimaisEl.textContent = filtrados.length.toString();
  }

  // Função para deletar animal e imagem associada
  (window as any).deletarAnimal = async (id: string, imagem_url: string, nome: string) => {
    if (!confirm(`Tem certeza que deseja excluir o cadastro de "${nome}" e apagar a foto?`)) return;
    
    try {
      // 1. Tentar deletar imagem do storage
      if (imagem_url) {
        const urlParts = imagem_url.split('/');
        const fileName = urlParts[urlParts.length - 1];
        await supabase.storage.from('animais').remove([fileName]);
      }

      // 2. Deletar registro do banco
      const { error } = await supabase.from('animais').delete().eq('id', id);
      if (error) throw error;

      carregarDados();
    } catch (err) {
      console.error(err);
      alert('Erro ao excluir o registro.');
    }
  };

  // Função para marcar animal como adotado/encontrado (preservando o histórico)
  (window as any).marcarResolvido = async (id: string, novoStatus: string) => {
    if (!confirm(`Confirmar que este animal foi ${novoStatus}?`)) return;
    
    try {
      const { error } = await supabase.from('animais').update({ status: novoStatus }).eq('id', id);
      if (error) throw error;

      carregarDados();
    } catch (err) {
      console.error(err);
      alert('Erro ao atualizar o registro.');
    }
  };

  async function carregarDados() {
    const { data: animaisOriginais, error } = await supabase
      .from('animais')
      .select('*')
      .order('created_at', { ascending: false });

    // Filtrar localmente os que já estão resolvidos e manter apenas os aprovados na lista principal
    const animais = animaisOriginais?.filter(a => a.status_moderacao === 'aprovado' && a.status !== 'Adotado') || [];
    let pendentes = animaisOriginais?.filter(a => a.status_moderacao === 'pendente') || [];

    const role = await getUserRole();
    isAdminGlob = role === 'adm' || role === 'dev';
    const isAdmin = isAdminGlob;

    // Se não for admin, não mostra o banner de pendentes
    if (!isAdmin) {
      pendentes = [];
    }

    // Lógica do FAB Inteligente
    const { data: { session } } = await supabase.auth.getSession();
    const fab = document.getElementById('fabAddAnimal') as HTMLAnchorElement;
    const fabIcon = document.getElementById('fabIcon');
    const fabText = document.getElementById('fabText');

    if (session) {
      if (fab) {
        fab.href = '/animais/novo';
        fab.className = 'fixed bottom-24 right-6 w-14 h-14 bg-gray-900 text-white rounded-full flex items-center justify-center shadow-lg hover:bg-gray-800 active:scale-95 transition-all z-30';
      }
      if (fabIcon) fabIcon.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>`;
      if (fabIcon) fabIcon.className = ''; // Remove custom text classes
      if (fabText) fabText.style.display = 'none';
    }

    if (error) {
      console.error(error);
      if (loadingState) loadingState.innerHTML = '<span class="text-red-500">Erro ao carregar os dados.</span>';
      return;
    }

    if (loadingState) loadingState.style.display = 'none';

    if (pendentes.length > 0) {
      if (bannerPendentes) bannerPendentes.classList.remove('hidden');
      if (qtdPendentes) qtdPendentes.textContent = pendentes.length.toString();
    } else {
      if (bannerPendentes) bannerPendentes.classList.add('hidden');
    }

    animaisGlobais = animais;
    
    let totalRacao = 0;
    let htmlAlertas = '';
    const hoje = new Date();

    animais.forEach((animal) => {
      if (animal.localizacao === 'Abrigo Takanil' && animal.peso) {
        totalRacao += (animal.peso * 0.015) * 30;
      }

      const dataCadastro = new Date(animal.created_at);
      const diffTime = Math.abs(hoje.getTime() - dataCadastro.getTime());
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 

      if (diffDays > 10 && isAdmin) {
        const isDesaparecido = animal.situacao_urgencia === 'Desaparecido' || animal.localizacao.includes('Desaparecido');
        const statusPergunta = isDesaparecido ? 'Já foi encontrado?' : 'Já foi adotado?';
        const novoStatusLabel = isDesaparecido ? 'Encontrado' : 'Adotado';
          
        htmlAlertas += `
          <div class="bg-red-50 rounded-xl p-4 border border-red-100">
            <div class="flex gap-4 mb-3">
              <img src="${animal.imagem_url || ''}" class="w-16 h-16 rounded-lg object-cover flex-shrink-0" alt="${animal.nome}">
              <div>
                <h4 class="font-bold text-red-800">${animal.nome}</h4>
                <p class="text-xs text-red-600">No sistema há ${diffDays} dias</p>
              </div>
            </div>
            <div class="flex items-center justify-between mt-2 pt-2 border-t border-red-200/50">
              <span class="text-sm font-medium text-red-800">${statusPergunta}</span>
              <button onclick="marcarResolvido('${animal.id}', 'Adotado')" class="text-xs bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded-lg font-medium transition-colors">
                Sim, ${novoStatusLabel}
              </button>
            </div>
          </div>
        `;
      }
    });

    if (htmlAlertas) {
      if (alertasContainer) alertasContainer.classList.remove('hidden');
      if (listaAlertas) listaAlertas.innerHTML = htmlAlertas;
    } else {
      if (alertasContainer) alertasContainer.classList.add('hidden');
      if (listaAlertas) listaAlertas.innerHTML = '';
    }

    if (totalRacaoEl) totalRacaoEl.textContent = totalRacao.toFixed(1);

    // Primeira renderização da vitrine normal
    renderLista(animaisGlobais);
  }

  // Iniciar
  carregarDados();
</script>
