        <button type="button" onclick="fecharModalCompartilhar()" class="w-full py-3 bg-gray-100 hover:bg-gray-200 active:scale-98 text-gray-700 font-semibold rounded-xl text-sm transition-all min-h-[44px]">
          Cancelar
        </button>
