---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hub Takanil - Dashboard">
  
  <div class="space-y-6 pb-20">
    
    <!-- Header / Ração -->
    <div class="bg-gradient-to-br from-taka-green-500 to-taka-green-700 text-white rounded-2xl p-6 shadow-md border border-taka-green-400/50">
      <h2 class="text-sm font-medium text-taka-green-100 mb-1">Previsão de Ração (Mensal)</h2>
      <div class="flex items-baseline space-x-2">
        <span class="text-4xl font-bold" id="totalRacao">--</span>
        <span class="text-taka-green-200">kg/mês</span>
      </div>
      <p class="text-xs text-taka-green-200 mt-2">*Apenas para animais no Abrigo Takanil (aprox. 1.5% peso/dia)</p>
    </div>

    <!-- Banner de Pendências -->
    <a href="/aprovacoes" id="bannerPendentes" class="hidden block bg-yellow-50 border border-yellow-200 rounded-xl p-4 shadow-sm hover:bg-yellow-100 transition-colors mb-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-xl">🛎️</span>
          <div>
            <h3 class="font-bold text-yellow-800 text-sm">Sugestões Pendentes</h3>
            <p class="text-xs text-yellow-700 mt-0.5">Você tem <span id="qtdPendentes" class="font-bold">0</span> animal(is) aguardando aprovação.</p>
          </div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-yellow-600" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
        </svg>
      </div>
    </a>

    <!-- Todos os Animais -->
    <div>
      <div class="flex justify-between items-center mb-4 gap-2">
        <div class="min-w-0 flex-1">
          <h3 class="text-base sm:text-lg font-bold text-gray-800 truncate" id="tituloSecao">Animais Cadastrados</h3>
          <p class="text-xs text-gray-500 font-medium mt-0.5"><span id="totalAnimais" class="font-bold text-gray-700">0</span> amiguinhos registrados</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button
            onclick="abrirModalFiltros()"
            id="btnAbrirFiltros"
            class="px-3 py-2 rounded-xl border border-taka-green-300 bg-taka-green-50 text-taka-green-700 font-bold text-sm hover:bg-taka-green-100 active:scale-95 transition-all flex items-center gap-1.5 shadow-sm min-h-[44px]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            <span>Filtrar</span>
          </button>
          <button
            onclick="alternarFinaisFelizes()"
            title="Ver finais felizes"
            class="h-11 w-11 flex items-center justify-center rounded-xl bg-gray-100 text-gray-400 hover:bg-pink-50 hover:text-pink-500 active:scale-95 transition-all shadow-sm shrink-0"
            id="btnFinaisFelizes"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform transform-gpu" viewBox="0 0 20 20" fill="currentColor" id="svgFinaisFelizes">
              <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </div>
      <div id="listaAnimais" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <div class="col-span-full text-center py-8 text-gray-400 text-sm" id="loadingState">
          <svg class="animate-spin mx-auto h-8 w-8 text-gray-300 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Carregando dados...
        </div>
        <!-- Inserido via JS -->
      </div>
    </div>
  </div>

  <!-- Modal de Filtros (Organizado em 2 Colunas Limpas) -->
  <div id="modalFiltros" class="fixed inset-0 z-50 bg-black/60 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
      <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-taka-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
          <h3 class="font-bold text-gray-800 text-lg">Filtrar Animais</h3>
        </div>
        <button onclick="fecharModalFiltros()" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div class="p-5 space-y-5 max-h-[70vh] overflow-y-auto">
        <!-- Categoria 1: Situação / Urgência -->
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Situação / Urgência</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" class="opt-filtro-urgencia p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-urgencia="Todos">
              <span>Todos</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" class="opt-filtro-urgencia p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-urgencia="Machucados">
              <span>🚨 Machucados</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" class="opt-filtro-urgencia p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-urgencia="Desaparecidos">
              <span>🔍 Sumidos</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
          </div>
        </div>

        <!-- Categoria 2: Localização -->
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Localização</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" class="opt-filtro-loc p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-loc="Todas">
              <span>Todas</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" class="opt-filtro-loc p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-loc="Abrigo Takanil">
              <span>🏡 No Abrigo</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" class="opt-filtro-loc p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-loc="Na rua">
              <span>🐾 Na Rua</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" class="opt-filtro-loc p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-loc="Lar Temporário">
              <span>🚧 Lar Temp.</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
          </div>
        </div>

        <!-- Categoria 3: Espécie -->
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Espécie</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" class="opt-filtro-especie p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-especie="Todas">
              <span>Todas</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" class="opt-filtro-especie p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-especie="Cão">
              <span>🐶 Cães</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
            <button type="button" class="opt-filtro-especie p-3 text-left rounded-xl border text-sm font-semibold transition-all h-12 flex items-center justify-between" data-especie="Gato">
              <span>🐱 Gatos</span>
              <span class="check-icon hidden text-taka-green-600 font-bold">✓</span>
            </button>
          </div>
        </div>
      </div>

      <div class="p-4 border-t border-gray-100 bg-gray-50 flex gap-2">
        <button onclick="limparFiltrosModal()" class="flex-1 py-3 text-sm font-bold text-gray-600 hover:bg-gray-200 rounded-xl transition-colors">Limpar</button>
        <button onclick="aplicarFiltrosModal()" class="flex-[2] py-3 text-sm font-bold text-white bg-taka-green-600 hover:bg-taka-green-700 rounded-xl transition-colors shadow-md active:scale-95">Aplicar Filtros</button>
      </div>
    </div>
  </div>

  <!-- Modal de Edição Rápida (Status/Localização) -->
  <div id="modalEdicao" class="fixed inset-0 z-50 bg-black/60 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm overflow-hidden">
      <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
        <h3 class="font-bold text-gray-800" id="modalEdicaoTitulo">Editar Status</h3>
        <button onclick="fecharModalEdicao()" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-5 space-y-4">
        <input type="hidden" id="editAnimalId">
        
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Localização</label>
          <select id="editLocalizacao" class="w-full rounded-xl border-gray-300 shadow-sm focus:border-taka-green-500 focus:ring-taka-green-500 text-sm p-3 border bg-white">
            <option value="Abrigo Takanil">Abrigo Takanil</option>
            <option value="Na rua">Na rua</option>
            <option value="Lar Temporário">Lar Temporário</option>
            <option value="Casa de terceiros">Casa de terceiros</option>
            <option value="Desaparecido">Desaparecido</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Situação / Resolução</label>
          <select id="editUrgencia" class="w-full rounded-xl border-gray-300 shadow-sm focus:border-taka-green-500 focus:ring-taka-green-500 text-sm p-3 border bg-white">
            <option value="Nenhuma">Normal (Nenhuma)</option>
            <option value="Machucado/Risco">🚨 Machucado / Risco</option>
            <option value="Desaparecido">🔍 Desaparecido</option>
            <option value="Adotado">✅ Adotado</option>
            <option value="Tutor Encontrado">🏠 Tutor Encontrado</option>
            <option value="Óbito">✝️ Óbito</option>
          </select>
        </div>
      </div>
      <div class="p-4 border-t border-gray-100 bg-gray-50 flex justify-end gap-2">
        <button onclick="fecharModalEdicao()" class="px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-200 rounded-xl transition-colors">Cancelar</button>
        <button onclick="salvarEdicao()" id="btnSalvarEdicao" class="px-4 py-2 text-sm font-medium text-white bg-taka-green-600 hover:bg-taka-green-700 rounded-xl transition-colors shadow-sm">Salvar Alterações</button>
      </div>
    </div>
  </div>

  <!-- Botões Flutuantes (FABs) -->
  <div class="fixed bottom-20 right-4 flex flex-col items-end gap-3 z-30" id="fabsContainer">
    <!-- FAB Associar -->
    <a href="https://docs.google.com/forms/d/e/1FAIpQLSeiYK6dKhgITc7oCZjOw5_u6G_5QWOKnL6TkA-EFwJGskpNUw/viewform" id="fabAssociar" target="_blank" rel="noopener noreferrer" class="backdrop-blur-md text-white border border-pink-400 rounded-full flex items-center justify-center shadow-lg hover:shadow-xl active:scale-95 transition-all duration-300 px-3 opacity-50 hover:opacity-100" style="background-color: rgba(236, 72, 153, 0.85);" title="Quero ser um associado">
      <span class="text-xl">💖</span>
      <span id="fabAssociarText" class="font-bold text-xs uppercase tracking-wider drop-shadow-sm overflow-hidden transition-all duration-300 max-w-[0px] opacity-0">ASSOCIAR</span>
    </a>
    
    <!-- FAB Sugerir/Novo Animal -->
    <a href="/sugerir-animal" id="fabAddAnimal" class="backdrop-blur-md text-white border border-taka-green-400 rounded-full flex items-center justify-center shadow-lg hover:shadow-xl active:scale-95 transition-all duration-300 px-3 opacity-50 hover:opacity-100 shadow-taka-green-600/30" style="background-color: rgba(55, 176, 141, 0.85);" title="Sugerir novo animal">
      <span id="fabIcon" class="text-xl drop-shadow-sm">🐾</span>
      <span id="fabText" class="font-bold text-xs uppercase tracking-wider drop-shadow-sm overflow-hidden transition-all duration-300 max-w-[0px] opacity-0">SUGERIR</span>
    </a>
  </div>

</Layout>

<script>
  import { supabase, getUserRole } from '../lib/supabaseClient';

  const listaAnimais = document.getElementById('listaAnimais');
  const totalRacaoEl = document.getElementById('totalRacao');
  const totalAnimaisEl = document.getElementById('totalAnimais');
  const loadingState = document.getElementById('loadingState');
  const bannerPendentes = document.getElementById('bannerPendentes');
  const qtdPendentes = document.getElementById('qtdPendentes');

  // Estado local
  let animaisGlobais: any[] = [];
  let isAdminGlob = false;
  // Variáveis de Filtro do Modal
  let filtroUrgencia = 'Todos';
  let filtroLocalizacao = 'Todas';
  let filtroEspecie = 'Todas';
  let mostrarFinaisFelizes = false;

  // Lógica de abertura/fechamento do Modal de Filtros
  (window as any).abrirModalFiltros = () => {
    document.getElementById('modalFiltros')?.classList.remove('hidden');
    sincronizarUIModalFiltros();
  };

  (window as any).fecharModalFiltros = () => {
    document.getElementById('modalFiltros')?.classList.add('hidden');
  };

  (window as any).limparFiltrosModal = () => {
    filtroUrgencia = 'Todos';
    filtroLocalizacao = 'Todas';
    filtroEspecie = 'Todas';
    sincronizarUIModalFiltros();
    (window as any).aplicarFiltrosModal();
  };

  (window as any).aplicarFiltrosModal = () => {
    (window as any).fecharModalFiltros();
    
    // Atualizar badge no botão Filtrar
    const btnFiltrar = document.getElementById('btnAbrirFiltros');
    const totalFiltrosAtivos = (filtroUrgencia !== 'Todos' ? 1 : 0) + 
                              (filtroLocalizacao !== 'Todas' ? 1 : 0) + 
                              (filtroEspecie !== 'Todas' ? 1 : 0);

    if (btnFiltrar) {
      if (totalFiltrosAtivos > 0) {
        btnFiltrar.classList.remove('bg-taka-green-50', 'text-taka-green-700', 'border-taka-green-300');
        btnFiltrar.classList.add('bg-taka-green-600', 'text-white', 'border-taka-green-600');
        btnFiltrar.querySelector('span')!.textContent = `Filtrar (${totalFiltrosAtivos})`;
      } else {
        btnFiltrar.classList.remove('bg-taka-green-600', 'text-white', 'border-taka-green-600');
        btnFiltrar.classList.add('bg-taka-green-50', 'text-taka-green-700', 'border-taka-green-300');
        btnFiltrar.querySelector('span')!.textContent = 'Filtrar';
      }
    }

    if (mostrarFinaisFelizes) {
      mostrarFinaisFelizes = false;
      document.getElementById('btnFinaisFelizes')!.classList.remove('text-pink-500');
      document.getElementById('btnFinaisFelizes')!.classList.add('text-gray-400');
      document.getElementById('tituloSecao')!.innerText = 'Animais Cadastrados';
    }

    renderLista(animaisGlobais);
  };

  function sincronizarUIModalFiltros() {
    // Categoria Urgência
    document.querySelectorAll('.opt-filtro-urgencia').forEach(btn => {
      const val = btn.getAttribute('data-urgencia');
      const check = btn.querySelector('.check-icon');
      if (val === filtroUrgencia) {
        btn.classList.add('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.remove('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.add('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.add('hidden');
      }
    });

    // Categoria Localização
    document.querySelectorAll('.opt-filtro-loc').forEach(btn => {
      const val = btn.getAttribute('data-loc');
      const check = btn.querySelector('.check-icon');
      if (val === filtroLocalizacao) {
        btn.classList.add('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.remove('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.add('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.add('hidden');
      }
    });

    // Categoria Espécie
    document.querySelectorAll('.opt-filtro-especie').forEach(btn => {
      const val = btn.getAttribute('data-especie');
      const check = btn.querySelector('.check-icon');
      if (val === filtroEspecie) {
        btn.classList.add('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.remove('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.add('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.add('hidden');
      }
    });
  }

  // Handlers de seleção dos botões dentro do Modal
  document.querySelectorAll('.opt-filtro-urgencia').forEach(btn => {
    btn.addEventListener('click', () => {
      filtroUrgencia = btn.getAttribute('data-urgencia') || 'Todos';
      sincronizarUIModalFiltros();
    });
  });

  document.querySelectorAll('.opt-filtro-loc').forEach(btn => {
    btn.addEventListener('click', () => {
      filtroLocalizacao = btn.getAttribute('data-loc') || 'Todas';
      sincronizarUIModalFiltros();
    });
  });

  document.querySelectorAll('.opt-filtro-especie').forEach(btn => {
    btn.addEventListener('click', () => {
      filtroEspecie = btn.getAttribute('data-especie') || 'Todas';
      sincronizarUIModalFiltros();
    });
  });

  function renderLista(animais: any[]) {
    let htmlNormal = '';
    
    // Filtro base: Remover óbitos de todas as views públicas
    let baseAnimais = animais.filter(a => a.situacao_urgencia !== 'Óbito');
    let filtrados = baseAnimais;
    const statusFinais = ['Adotado', 'Tutor Encontrado'];

    if (mostrarFinaisFelizes) {
      filtrados = baseAnimais.filter(a => statusFinais.includes(a.situacao_urgencia));
    } else {
      // Normal filters on active animals
      filtrados = baseAnimais.filter(a => !statusFinais.includes(a.situacao_urgencia));
      
      // Aplicar Filtro de Urgência
      if (filtroUrgencia === 'Machucados') {
        filtrados = filtrados.filter(a => a.situacao_urgencia === 'Machucado/Risco');
      } else if (filtroUrgencia === 'Desaparecidos') {
        filtrados = filtrados.filter(a => a.situacao_urgencia === 'Desaparecido' || a.localizacao.includes('Desaparecido'));
      }

      // Aplicar Filtro de Localização
      if (filtroLocalizacao !== 'Todas') {
        filtrados = filtrados.filter(a => a.localizacao === filtroLocalizacao);
      }

      // Aplicar Filtro de Espécie
      if (filtroEspecie !== 'Todas') {
        filtrados = filtrados.filter(a => a.especie === filtroEspecie);
      }
    }

    if (!filtrados || filtrados.length === 0) {
      if (listaAnimais) {
        listaAnimais.innerHTML = `
          <div class="col-span-full text-center py-10 px-4 bg-gray-50 rounded-2xl border border-dashed border-gray-300">
            <span class="text-3xl mb-2 block">🐾</span>
            <p class="text-gray-500 text-sm font-medium">Nenhum animal encontrado para este filtro.</p>
          </div>`;
      }
      if (totalAnimaisEl) totalAnimaisEl.textContent = '0';
      return;
    }

    const hoje = new Date();

    filtrados.forEach((animal) => {
      const dataCadastro = new Date(animal.created_at);
      const diffTime = Math.abs(hoje.getTime() - dataCadastro.getTime());
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
      // Badges
      let badgeUrgencia = '';
      let isResolvido = false;

      if (animal.situacao_urgencia === 'Machucado/Risco') {
        badgeUrgencia = `<span class="inline-block bg-red-100 text-red-700 text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1">🚨 Urgência Médica</span>`;
      } else if (animal.situacao_urgencia === 'Desaparecido' || animal.localizacao.includes('Desaparecido')) {
        badgeUrgencia = `<span class="inline-block bg-yellow-100 text-yellow-800 text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1">🔍 Desaparecido</span>`;
      } else if (animal.situacao_urgencia === 'Adotado') {
        badgeUrgencia = `<span class="inline-block bg-green-100 text-green-800 text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1 shadow-sm border border-green-200">✅ Adotado</span>`;
        isResolvido = true;
      } else if (animal.situacao_urgencia === 'Tutor Encontrado') {
        badgeUrgencia = `<span class="inline-block bg-taka-green-100 text-taka-green-800 text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1 shadow-sm border border-taka-green-200">🏠 Voltou pro Tutor</span>`;
        isResolvido = true;
      }

      // Badges Secundárias (Tags)
      let tags = '';
      if (animal.sexo === 'Macho') tags += `<span class="bg-taka-green-50 text-taka-green-600 text-[10px] px-1.5 py-0.5 rounded">♂ Macho</span> `;
      if (animal.sexo === 'Fêmea') tags += `<span class="bg-pink-50 text-pink-600 text-[10px] px-1.5 py-0.5 rounded">♀ Fêmea</span> `;
      if (animal.sexo === 'Misto (Ninhada)') tags += `<span class="bg-purple-50 text-purple-600 text-[10px] px-1.5 py-0.5 rounded">♂♀ Misto</span> `;
      if (animal.quantidade > 1) tags += `<span class="bg-gray-100 text-gray-600 text-[10px] px-1.5 py-0.5 rounded">📦 ${animal.quantidade} animais</span> `;
      if (animal.vacinado === 'Sim') tags += `<span class="bg-taka-green-50 text-taka-green-600 text-[10px] px-1.5 py-0.5 rounded">💉 Vacinado</span> `;
      if (animal.castrado === 'Sim') tags += `<span class="bg-purple-50 text-purple-600 text-[10px] px-1.5 py-0.5 rounded">✂️ Castrado</span> `;

      htmlNormal += `
        <div class="bg-taka-orange-50/80 rounded-2xl shadow-xs border border-taka-orange-200/60 p-4 flex flex-col justify-between group relative hover:shadow-md transition-all ${isResolvido ? 'bg-gray-50 border-gray-200 opacity-70' : ''}">
          <div class="flex gap-3.5 items-start">
            <img src="${animal.imagem_url || ''}" class="w-20 h-20 rounded-xl object-cover bg-gray-100 flex-shrink-0" alt="${animal.nome}">
            <div class="flex-1 min-w-0 pr-8">
              ${badgeUrgencia}
              <h4 class="text-base sm:text-lg font-bold text-gray-800 truncate ${isResolvido ? 'line-through text-gray-400' : ''}">${animal.nome}</h4>
              <p class="text-xs text-gray-500 truncate mt-0.5">${animal.fase_vida} • ${animal.peso}kg</p>
              <div class="mt-1.5 flex flex-wrap gap-1">
                ${tags}
              </div>
              ${!isResolvido ? `<p class="text-[11px] font-medium text-taka-green-700 mt-1.5 truncate">📍 ${animal.localizacao}</p>` : ''}
              <p class="text-[10px] text-gray-400 mt-1">🕒 No sistema há ${diffDays} ${diffDays === 1 ? 'dia' : 'dias'}</p>
            </div>
          </div>
          ${isAdminGlob ? `
          <!-- Botões Admin -->
          <div class="absolute top-3.5 right-3.5 flex gap-1">
            <button 
              onclick="abrirModalEdicao('${animal.id}', '${animal.localizacao}', '${animal.situacao_urgencia}', '${animal.nome}')" 
              title="Editar Status" 
              class="p-1.5 text-gray-400 hover:text-taka-green-600 hover:bg-taka-green-50 rounded-lg transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            </button>
            <a 
              href="/animais/editar?id=${animal.id}"
              title="Editar dados do animal" 
              class="p-1.5 text-gray-400 hover:text-green-600 hover:bg-green-50 rounded-lg transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </a>
            <button 
              onclick="deletarAnimal('${animal.id}', '${animal.imagem_url || ''}', '${animal.nome}')" 
              title="Excluir cadastro" 
              class="p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
          ` : ''}
        </div>
      `;
    });

    if (listaAnimais) listaAnimais.innerHTML = htmlNormal;
    if (totalAnimaisEl) totalAnimaisEl.textContent = filtrados.length.toString();
  }

  // Função para deletar animal e imagem associada
  (window as any).deletarAnimal = async (id: string, imagem_url: string, nome: string) => {
    const confirmou = await (window as any).confirmarAcao({
      titulo: 'Excluir cadastro do animal?',
      mensagem: `Tem certeza que deseja excluir o cadastro de "${nome}" e apagar a foto permanentemente?`,
      textoConfirmar: 'Sim, Excluir',
      tipo: 'perigo'
    });
    if (!confirmou) return;
    
    try {
      // 1. Tentar deletar imagem do storage
      if (imagem_url) {
        const urlParts = imagem_url.split('/');
        const fileName = urlParts[urlParts.length - 1];
        await supabase.storage.from('animais').remove([fileName]);
      }

      // 2. Deletar registro do banco
      const { error } = await supabase.from('animais').delete().eq('id', id);
      if (error) throw error;

      carregarDados();
      (window as any).mostrarToast('Registro excluído com sucesso!', 'sucesso');
    } catch (err) {
      console.error(err);
      (window as any).mostrarToast('Erro ao excluir o registro.', 'erro');
    }
  };

  // Botão Finais Felizes
  (window as any).alternarFinaisFelizes = () => {
    mostrarFinaisFelizes = !mostrarFinaisFelizes;
    const btn = document.getElementById('btnFinaisFelizes')!;
    const titulo = document.getElementById('tituloSecao')!;
    
    if (mostrarFinaisFelizes) {
      btn.classList.remove('bg-gray-100', 'text-gray-400');
      btn.classList.add('bg-pink-100', 'text-pink-600', 'border', 'border-pink-300', 'scale-105');
      titulo.innerText = 'Finais Felizes';
      
    } else {
      btn.classList.remove('bg-pink-100', 'text-pink-600', 'border', 'border-pink-300', 'scale-105');
      btn.classList.add('bg-gray-100', 'text-gray-400');
      titulo.innerText = 'Animais Cadastrados';
      
      // Restaura os filtros padrões
      filtroUrgencia = 'Todos';
      filtroLocalizacao = 'Todas';
      filtroEspecie = 'Todas';
      const btnFiltrar = document.getElementById('btnAbrirFiltros');
      if (btnFiltrar) {
        btnFiltrar.classList.remove('bg-taka-green-600', 'text-white', 'border-taka-green-600');
        btnFiltrar.classList.add('bg-taka-green-50', 'text-taka-green-700', 'border-taka-green-300');
        btnFiltrar.querySelector('span')!.textContent = 'Filtrar';
      }
    }
    carregarDados();
  };

  // Funções do Modal de Edição
  (window as any).abrirModalEdicao = (id: string, localizacao: string, urgencia: string, nome: string) => {
    (document.getElementById('editAnimalId') as HTMLInputElement).value = id;
    (document.getElementById('editLocalizacao') as HTMLSelectElement).value = localizacao;
    (document.getElementById('editUrgencia') as HTMLSelectElement).value = urgencia;
    document.getElementById('modalEdicaoTitulo')!.innerText = `Editar: ${nome}`;
    document.getElementById('modalEdicao')!.classList.remove('hidden');
  };

  (window as any).fecharModalEdicao = () => {
    document.getElementById('modalEdicao')!.classList.add('hidden');
  };

  (window as any).salvarEdicao = async () => {
    const id = (document.getElementById('editAnimalId') as HTMLInputElement).value;
    const localizacao = (document.getElementById('editLocalizacao') as HTMLSelectElement).value;
    const situacao_urgencia = (document.getElementById('editUrgencia') as HTMLSelectElement).value;
    const btn = document.getElementById('btnSalvarEdicao')!;
    
    btn.innerHTML = 'Salvando...';
    btn.setAttribute('disabled', 'true');

    try {
      const { error } = await supabase
        .from('animais')
        .update({ localizacao, situacao_urgencia })
        .eq('id', id);

      if (error) throw error;
      
      (window as any).fecharModalEdicao();
      carregarDados(); // Recarrega os cards
      (window as any).mostrarToast('Status do animal atualizado!', 'sucesso');
    } catch (err) {
      console.error(err);
      (window as any).mostrarToast('Erro ao atualizar o status do animal.', 'erro');
    } finally {
      btn.innerHTML = 'Salvar Alterações';
      btn.removeAttribute('disabled');
    }
  };

  // Função para marcar animal como adotado/encontrado (preservando o histórico)
  (window as any).marcarResolvido = async (id: string, novoStatus: string) => {
    const confirmou = await (window as any).confirmarAcao({
      titulo: `Confirmar ${novoStatus}?`,
      mensagem: `Deseja atualizar o status deste animal para "${novoStatus}"?`,
      textoConfirmar: 'Confirmar',
      tipo: 'padrao'
    });
    if (!confirmou) return;
    
    try {
      const { error } = await supabase.from('animais').update({ status: novoStatus }).eq('id', id);
      if (error) throw error;

      carregarDados();
      (window as any).mostrarToast(`Animal marcado como ${novoStatus}!`, 'sucesso');
    } catch (err) {
      console.error(err);
      (window as any).mostrarToast('Erro ao atualizar o registro.', 'erro');
    }
  };

  async function carregarDados() {
    const { data: animaisOriginais, error } = await supabase
      .from('animais')
      .select('*')
      .order('created_at', { ascending: false });

    // Filtrar localmente os que já estão resolvidos e manter apenas os aprovados na lista principal
    const animais = animaisOriginais?.filter(a => a.status_moderacao === 'aprovado' && a.status !== 'Adotado') || [];
    let pendentes = animaisOriginais?.filter(a => a.status_moderacao === 'pendente') || [];

    const role = await getUserRole();
    isAdminGlob = role === 'adm' || role === 'dev';
    const isAdmin = isAdminGlob;

    // Se não for admin, não mostra o banner de pendentes
    if (!isAdmin) {
      pendentes = [];
    }

    // Lógica do FAB Inteligente
    const { data: { session } } = await supabase.auth.getSession();
    const fab = document.getElementById('fabAddAnimal') as HTMLAnchorElement;
    const fabIcon = document.getElementById('fabIcon');
    const fabText = document.getElementById('fabText');
    
    if (session && isAdminGlob) {
      const fabAssociar = document.getElementById('fabAssociar');
      if (fabAssociar) fabAssociar.style.display = 'none';
      
      if (fab) {
        fab.href = '/animais/novo';
        fab.className = 'backdrop-blur-md text-white border border-taka-orange-400 rounded-full flex items-center justify-center shadow-lg hover:shadow-xl active:scale-95 transition-all duration-300 px-3 opacity-50 shadow-taka-orange-500/30';
        fab.style.backgroundColor = 'rgba(254, 118, 32, 0.85)'; // taka-orange
      }
      if (fabIcon) fabIcon.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 drop-shadow-sm" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>`;
      if (fabIcon) fabIcon.className = ''; 
      if (fabText) {
        fabText.innerText = 'CADASTRAR';
        fabText.style.display = 'block';
      }
    }

    // Lógica de recolher (collapse) os FABs no scroll
    const fabAssociar = document.getElementById('fabAssociar');
    const fabAssociarText = document.getElementById('fabAssociarText');
    let scrollTimeout: number;

    const setFabState = (collapsed: boolean) => {
      const stateConfigs = [
        { btn: fab, text: fabText },
        { btn: fabAssociar, text: fabAssociarText }
      ];

      stateConfigs.forEach(({ btn, text }) => {
        if (!btn || !text) return;
        
        if (collapsed) {
          // Recolher: esconde texto, tira gap, reduz opacidade do botão
          text.style.maxWidth = '0px';
          text.style.opacity = '0';
          btn.classList.remove('px-4', 'py-3', 'gap-2');
          btn.classList.add('px-3');
          btn.style.opacity = '0.5';
        } else {
          // Expandir: mostra texto
          text.style.maxWidth = '100px';
          text.style.opacity = '1';
          btn.classList.add('px-4', 'py-3', 'gap-2');
          btn.classList.remove('px-3');
          btn.style.opacity = '1';
        }
      });
    };

    // Estado inicial já vem recolhido no HTML. Apenas garantimos a variável
    let isCollapsed = true;

    window.addEventListener('scroll', () => {
      // Ao começar a rolar, expande (se estiver recolhido)
      if (isCollapsed) {
        setFabState(false);
        isCollapsed = false;
      }

      // Limpa o temporizador se a pessoa continuar rolando
      clearTimeout(scrollTimeout);

      // Define um novo temporizador de 1 segundo para recolher após PARAR de rolar
      scrollTimeout = window.setTimeout(() => {
        setFabState(true);
        isCollapsed = true;
      }, 1000);
    }, { passive: true });

    if (error) {
      console.error(error);
      if (loadingState) loadingState.innerHTML = '<span class="text-red-500">Erro ao carregar os dados.</span>';
      return;
    }

    if (loadingState) loadingState.style.display = 'none';

    if (pendentes.length > 0) {
      if (bannerPendentes) bannerPendentes.classList.remove('hidden');
      if (qtdPendentes) qtdPendentes.textContent = pendentes.length.toString();
    } else {
      if (bannerPendentes) bannerPendentes.classList.add('hidden');
    }

    animaisGlobais = animais;
    
    let totalRacao = 0;

    animais.forEach((animal) => {
      if (animal.localizacao === 'Abrigo Takanil' && animal.peso) {
        totalRacao += (animal.peso * 0.015) * 30;
      }
    });

    if (totalRacaoEl) totalRacaoEl.textContent = totalRacao.toFixed(1);

    // Primeira renderização da vitrine normal
    renderLista(animaisGlobais);
  }
  
  // Iniciar
  carregarDados();
</script>
