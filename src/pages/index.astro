</Layout>

<script>
  import { supabase, getUserRole } from '../lib/supabaseClient';
  import { abrirWhatsAppDireto, gerarMensagemCompartilhamentoPublico } from '../lib/whatsappContextual';

  const listaAnimais = document.getElementById('listaAnimais');
  const totalRacaoEl = document.getElementById('totalRacao');
  const totalAnimaisEl = document.getElementById('totalAnimais');
  const loadingState = document.getElementById('loadingState');
  const bannerPendentes = document.getElementById('bannerPendentes');
  const qtdPendentes = document.getElementById('qtdPendentes');

  // Estado local
  let animaisGlobais: any[] = [];
  let isAdminGlob = false;
  let modoVisualizacao: 'grid' | 'list' = (localStorage.getItem('takanil_view_mode') as any) || 'grid';
  let paramAnimalProcessado = false;
  let animalParaCompartilhar: any = null;

  // Variáveis de Filtro do Modal e Busca
  let termoBusca = '';
  let filtroUrgencia = 'Todos';
  let filtroLocalizacao = 'Todas';
  let filtroEspecie = 'Todas';
  let filtroSexo = 'Todos';
  let filtroClinico = 'Todos';
  let mostrarFinaisFelizes = false;

  // Handler da Barra de Busca por Nome
  const inputBusca = document.getElementById('inputBuscaNome') as HTMLInputElement;
  const btnLimparBusca = document.getElementById('btnLimparBusca');

  inputBusca?.addEventListener('input', () => {
    termoBusca = inputBusca.value.trim().toLowerCase();
    if (termoBusca.length > 0) {
      btnLimparBusca?.classList.remove('hidden');
    } else {
      btnLimparBusca?.classList.add('hidden');
    }
    renderLista(animaisGlobais);
  });

  btnLimparBusca?.addEventListener('click', () => {
    if (inputBusca) {
      inputBusca.value = '';
      termoBusca = '';
      btnLimparBusca.classList.add('hidden');
      inputBusca.focus();
      renderLista(animaisGlobais);
    }
  });

  // Sincronização e alternância do Modo de Visualização (Grade vs Lista)
  function sincronizarUIModoVisualizacao() {
    const btnGrid = document.getElementById('btnModoGrid');
    const btnList = document.getElementById('btnModoList');
    const container = document.getElementById('listaAnimais');

    if (btnGrid && btnList) {
      if (modoVisualizacao === 'grid') {
        btnGrid.className = 'h-10 w-10 flex items-center justify-center rounded-lg text-sm font-bold transition-all bg-taka-green-50 text-taka-green-700 shadow-xs border border-taka-green-200';
        btnList.className = 'h-10 w-10 flex items-center justify-center rounded-lg text-sm font-bold transition-all text-gray-500 hover:text-gray-800';
      } else {
        btnList.className = 'h-10 w-10 flex items-center justify-center rounded-lg text-sm font-bold transition-all bg-taka-green-50 text-taka-green-700 shadow-xs border border-taka-green-200';
        btnGrid.className = 'h-10 w-10 flex items-center justify-center rounded-lg text-sm font-bold transition-all text-gray-500 hover:text-gray-800';
      }
    }

    if (container) {
      if (modoVisualizacao === 'grid') {
        container.className = 'grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4';
      } else {
        container.className = 'flex flex-col gap-3 w-full';
      }
    }
  }

  (window as any).definirModoVisualizacao = (novoModo: 'grid' | 'list') => {
    modoVisualizacao = novoModo;
    try {
      localStorage.setItem('takanil_view_mode', novoModo);
    } catch (_) {}
    sincronizarUIModoVisualizacao();
    renderLista(animaisGlobais);
  };

  // Funções do Modal de Zoom de Fotos
  (window as any).abrirModalZoom = (url: string, nome: string, subtitulo: string) => {
    const modal = document.getElementById('modalZoomFoto');
    const card = document.getElementById('modalZoomCard');
    const img = document.getElementById('modalZoomImg') as HTMLImageElement;
    const titulo = document.getElementById('modalZoomTitulo');
    const sub = document.getElementById('modalZoomSubtitulo');

    if (!modal || !card || !img || !titulo || !sub) return;

    img.src = url || '/assets/takanil-icon-png.png';
    titulo.textContent = nome || 'Animal';
    sub.textContent = subtitulo || '';

    modal.classList.remove('hidden');
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      modal.classList.add('opacity-100');
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    });
  };

  (window as any).fecharModalZoom = () => {
    const modal = document.getElementById('modalZoomFoto');
    const card = document.getElementById('modalZoomCard');
    if (!modal || !card) return;

    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');

    setTimeout(() => {
      modal.classList.add('hidden');
      const img = document.getElementById('modalZoomImg') as HTMLImageElement;
      if (img) img.src = '';
    }, 200);
  };

  // Fechar modals ao pressionar a tecla ESC
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      (window as any).fecharModalZoom();
      (window as any).fecharModalCompartilhar?.();
      (window as any).fecharModalFiltros();
      (window as any).fecharDropdownStatus();
      (window as any).fecharModalNovidades?.();
    }
  });

  // Fechar Modal Zoom ao clicar no backdrop
  document.getElementById('modalZoomFoto')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('modalZoomFoto')) {
      (window as any).fecharModalZoom();
    }
  });

  // Lógica de abertura/fechamento do Modal de Filtros
  (window as any).abrirModalFiltros = () => {
    document.getElementById('modalFiltros')?.classList.remove('hidden');
    sincronizarUIModalFiltros();
  };

  (window as any).fecharModalFiltros = () => {
    document.getElementById('modalFiltros')?.classList.add('hidden');
  };

  (window as any).limparFiltrosModal = () => {
    filtroUrgencia = 'Todos';
    filtroLocalizacao = 'Todas';
    filtroEspecie = 'Todas';
    filtroSexo = 'Todos';
    filtroClinico = 'Todos';
    sincronizarUIModalFiltros();
    (window as any).aplicarFiltrosModal();
  };

  (window as any).aplicarFiltrosModal = () => {
    (window as any).fecharModalFiltros();
    
    // Atualizar badge no botão Filtrar
    const btnFiltrar = document.getElementById('btnAbrirFiltros');
    const totalFiltrosAtivos = (filtroUrgencia !== 'Todos' ? 1 : 0) + 
                              (filtroLocalizacao !== 'Todas' ? 1 : 0) + 
                              (filtroEspecie !== 'Todas' ? 1 : 0) +
                              (filtroSexo !== 'Todos' ? 1 : 0) +
                              (filtroClinico !== 'Todos' ? 1 : 0);

    if (btnFiltrar) {
      if (totalFiltrosAtivos > 0) {
        btnFiltrar.classList.remove('bg-taka-green-50', 'text-taka-green-700', 'border-taka-green-300');
        btnFiltrar.classList.add('bg-taka-green-600', 'text-white', 'border-taka-green-600');
        btnFiltrar.querySelector('span')!.textContent = `Filtrar (${totalFiltrosAtivos})`;
      } else {
        btnFiltrar.classList.remove('bg-taka-green-600', 'text-white', 'border-taka-green-600');
        btnFiltrar.classList.add('bg-taka-green-50', 'text-taka-green-700', 'border-taka-green-300');
        btnFiltrar.querySelector('span')!.textContent = 'Filtrar';
      }
    }

    if (mostrarFinaisFelizes) {
      mostrarFinaisFelizes = false;
      const btnFinais = document.getElementById('btnFinaisFelizes');
      if (btnFinais) {
        btnFinais.className = 'h-11 w-11 flex items-center justify-center rounded-xl bg-gray-100 text-gray-500 hover:bg-gray-200 active:scale-95 transition-all shadow-xs shrink-0 min-w-[44px] min-h-[44px]';
        btnFinais.blur();
      }
      const labelAnimais = document.getElementById('labelTotalAnimais');
      if (labelAnimais) labelAnimais.innerText = 'Animais';
    }

    renderLista(animaisGlobais);
  };

  function sincronizarUIModalFiltros() {
    // Categoria Urgência
    document.querySelectorAll('.opt-filtro-urgencia').forEach(btn => {
      const val = btn.getAttribute('data-urgencia');
      const check = btn.querySelector('.check-icon');
      if (val === filtroUrgencia) {
        btn.classList.add('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.remove('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.add('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.add('hidden');
      }
    });

    // Categoria Localização
    document.querySelectorAll('.opt-filtro-loc').forEach(btn => {
      const val = btn.getAttribute('data-loc');
      const check = btn.querySelector('.check-icon');
      if (val === filtroLocalizacao) {
        btn.classList.add('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.remove('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.add('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.add('hidden');
      }
    });

    // Categoria Espécie
    document.querySelectorAll('.opt-filtro-especie').forEach(btn => {
      const val = btn.getAttribute('data-especie');
      const check = btn.querySelector('.check-icon');
      if (val === filtroEspecie) {
        btn.classList.add('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.remove('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.add('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.add('hidden');
      }
    });

    // Categoria Sexo
    document.querySelectorAll('.opt-filtro-sexo').forEach(btn => {
      const val = btn.getAttribute('data-sexo');
      const check = btn.querySelector('.check-icon');
      if (val === filtroSexo) {
        btn.classList.add('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.remove('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.add('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.add('hidden');
      }
    });

    // Categoria Status Clínico / Tags
    document.querySelectorAll('.opt-filtro-clinico').forEach(btn => {
      const val = btn.getAttribute('data-clinico');
      const check = btn.querySelector('.check-icon');
      if (val === filtroClinico) {
        btn.classList.add('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.remove('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('bg-taka-green-50', 'border-taka-green-500', 'text-taka-green-700');
        btn.classList.add('bg-gray-50', 'border-gray-200', 'text-gray-700');
        check?.classList.add('hidden');
      }
    });
  }

  // Handlers de seleção dos botões dentro do Modal
  (window as any).selecionarFiltroUrgencia = (val: string) => {
    filtroUrgencia = val;
    sincronizarUIModalFiltros();
  };

  (window as any).selecionarFiltroLocalizacao = (val: string) => {
    filtroLocalizacao = val;
    sincronizarUIModalFiltros();
  };

  (window as any).selecionarFiltroEspecie = (val: string) => {
    filtroEspecie = val;
    sincronizarUIModalFiltros();
  };

  (window as any).selecionarFiltroSexo = (val: string) => {
    filtroSexo = val;
    sincronizarUIModalFiltros();
  };

  (window as any).selecionarFiltroClinico = (val: string) => {
    filtroClinico = val;
    sincronizarUIModalFiltros();
  };

  document.querySelectorAll('.opt-filtro-urgencia').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-urgencia') || 'Todos';
      (window as any).selecionarFiltroUrgencia(val);
    });
  });

  document.querySelectorAll('.opt-filtro-loc').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-loc') || 'Todas';
      (window as any).selecionarFiltroLocalizacao(val);
    });
  });

  document.querySelectorAll('.opt-filtro-especie').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-especie') || 'Todas';
      (window as any).selecionarFiltroEspecie(val);
    });
  });

  document.querySelectorAll('.opt-filtro-sexo').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-sexo') || 'Todos';
      (window as any).selecionarFiltroSexo(val);
    });
  });

  document.querySelectorAll('.opt-filtro-clinico').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-clinico') || 'Todos';
      (window as any).selecionarFiltroClinico(val);
    });
  });

  function renderLista(animais: any[]) {
    let htmlOutput = '';
    
    // Filtro base: Remover óbitos de todas as views públicas
    let baseAnimais = animais.filter(a => a.situacao_urgencia !== 'Óbito');
    let filtrados = baseAnimais;
    const statusFinais = ['Adotado', 'Tutor Encontrado'];

    if (mostrarFinaisFelizes) {
      // Visão Finais Felizes: exibe apenas os que foram adotados ou voltaram para o tutor
      filtrados = baseAnimais.filter(a => statusFinais.includes(a.situacao_urgencia) || a.status === 'Adotado');
    } else {
      // Catálogo geral: TODOS os animais continuam no catálogo normalmente (adotados, em tratamento, etc.)
      filtrados = [...baseAnimais];
      
      // Aplicar Busca Textual por Nome (Case-Insensitive)
      if (termoBusca) {
        filtrados = filtrados.filter(a => (a.nome || '').toLowerCase().includes(termoBusca));
      }

      // Aplicar Filtro de Urgência
      if (filtroUrgencia === 'Machucados') {
        filtrados = filtrados.filter(a => a.situacao_urgencia === 'Machucado/Risco');
      } else if (filtroUrgencia === 'Desaparecidos') {
        filtrados = filtrados.filter(a => a.situacao_urgencia === 'Desaparecido' || a.localizacao.includes('Desaparecido'));
      }

      // Aplicar Filtro de Localização
      if (filtroLocalizacao !== 'Todas') {
        filtrados = filtrados.filter(a => a.localizacao === filtroLocalizacao);
      }

      // Aplicar Filtro de Espécie
      if (filtroEspecie !== 'Todas') {
        filtrados = filtrados.filter(a => a.especie === filtroEspecie);
      }

      // Aplicar Filtro de Sexo
      if (filtroSexo !== 'Todos') {
        filtrados = filtrados.filter(a => a.sexo === filtroSexo);
      }

      // Aplicar Filtro de Status Clínico
      if (filtroClinico === 'castrado') {
        filtrados = filtrados.filter(a => a.castrado === 'Sim' || a.castrado === true);
      } else if (filtroClinico === 'vacinado') {
        filtrados = filtrados.filter(a => a.vacinado === 'Sim' || a.vacinado === true);
      }
    }

    if (!filtrados || filtrados.length === 0) {
      if (listaAnimais) {
        listaAnimais.innerHTML = `
          <div class="col-span-full text-center py-10 px-4 bg-gray-50 rounded-2xl border border-dashed border-gray-300">
            <span class="text-3xl mb-2 block">🐾</span>
            <p class="text-gray-600 text-sm font-medium">Nenhum animal encontrado para este filtro.</p>
          </div>`;
      }
      if (totalAnimaisEl) totalAnimaisEl.textContent = '0';
      return;
    }

    const hoje = new Date();

    filtrados.forEach((animal) => {
      const dataCadastro = new Date(animal.created_at);
      const diffTime = Math.abs(hoje.getTime() - dataCadastro.getTime());
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
      
      // Badges
      let badgeUrgencia = '';
      let isResolvido = false;

      if (animal.situacao_urgencia === 'Machucado/Risco') {
        badgeUrgencia = `<span class="inline-block bg-red-100 text-red-700 text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1 shadow-xs border border-red-200">🚨 Urgência Médica</span>`;
      } else if (animal.situacao_urgencia === 'Desaparecido' || animal.localizacao.includes('Desaparecido')) {
        badgeUrgencia = `<span class="inline-block bg-yellow-100 text-yellow-800 text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1 shadow-xs border border-yellow-200">🔍 Desaparecido</span>`;
      } else if (animal.situacao_urgencia === 'Adotado') {
        badgeUrgencia = `<span class="inline-block bg-green-100 text-green-800 text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1 shadow-xs border border-green-200">✅ Adotado</span>`;
        isResolvido = true;
      } else if (animal.situacao_urgencia === 'Tutor Encontrado') {
