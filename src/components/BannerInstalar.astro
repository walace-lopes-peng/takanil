
---
// BannerInstalar.astro
// Exibe um prompt de instalacao PWA para dispositivos moveis / navegadores moveis.
// Android: usa o evento nativo `beforeinstallprompt` do browser.
// iOS: exibe instrucao manual (Safari nao dispara o evento nativo).
// Desktop/Geral: fallback para teste ou navegadores sem acionamento automatico.
---

<div id="bannerInstalar" class="hidden">
  <!-- Banner principal -->
  <div
    id="bannerConteudo"
    class="fixed top-16 left-0 right-0 z-50 mx-auto max-w-md px-3 pt-1"
  >
    <div class="flex items-center gap-3 rounded-2xl bg-white border border-taka-green-200 p-3.5 shadow-2xl text-gray-900 ring-1 ring-black/5">
      <!-- Icone do app -->
      <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-taka-green-100 flex items-center justify-center text-taka-green-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
      </div>

      <!-- Texto -->
      <div class="flex-1 min-w-0">
        <p class="text-sm font-bold leading-tight text-gray-900">Instale o Hub Takanil</p>
        <p class="text-xs text-gray-500 leading-tight mt-0.5">Acesse mais rápido na tela inicial</p>
      </div>

      <!-- Botao instalar -->
      <button
        id="btnInstalar"
        class="flex-shrink-0 bg-taka-green-600 hover:bg-taka-green-700 text-white text-xs font-bold px-3.5 py-2 rounded-xl active:scale-95 transition-all shadow-sm"
      >
        Instalar
      </button>

      <!-- Fechar -->
      <button
        id="btnFecharBanner"
        aria-label="Fechar banner de instalação"
        class="flex-shrink-0 min-w-[36px] min-h-[36px] flex items-center justify-center text-gray-400 hover:text-gray-600 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Instrucao de instalacao (Modal/Overlay) -->
  <div
    id="instrucaoInstalacao"
    class="hidden fixed inset-0 z-50 flex items-end"
  >
    <div id="overlayInstalacao" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>

    <div class="relative w-full max-w-md mx-auto bg-white rounded-t-3xl p-6 pb-10 shadow-2xl">
      <div class="w-10 h-1 bg-gray-300 rounded-full mx-auto mb-5"></div>

      <h2 id="tituloModalInstalacao" class="text-base font-bold text-gray-900 text-center mb-4">
        Adicionar à Tela Inicial
      </h2>

      <!-- Passos iOS -->
      <ol id="passosIOS" class="space-y-4 hidden">
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-taka-green-100 text-taka-green-600 text-sm font-bold flex items-center justify-center">1</span>
          <p class="text-sm text-gray-700 pt-0.5">
            Toque no botão <strong>Compartilhar</strong>
            <span class="inline-flex items-center justify-center w-6 h-6 bg-taka-green-500 rounded-md mx-1 align-middle">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
              </svg>
            </span>
            na barra do Safari
          </p>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-taka-green-100 text-taka-green-600 text-sm font-bold flex items-center justify-center">2</span>
          <p class="text-sm text-gray-700 pt-0.5">
            Role para baixo e toque em <strong>"Adicionar à Tela Inicial"</strong>
          </p>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-taka-green-100 text-taka-green-600 text-sm font-bold flex items-center justify-center">3</span>
          <p class="text-sm text-gray-700 pt-0.5">
            Toque em <strong>"Adicionar"</strong> no canto superior direito
          </p>
        </li>
      </ol>

      <!-- Passos Geral (Android / Chrome sem prompt automático) -->
      <ol id="passosGeral" class="space-y-4 hidden">
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-taka-green-100 text-taka-green-600 text-sm font-bold flex items-center justify-center">1</span>
          <p class="text-sm text-gray-700 pt-0.5">
            Abra o menu do navegador (ícone de <strong>3 pontos ⋮</strong> ou opções no topo/rodapé)
          </p>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-taka-green-100 text-taka-green-600 text-sm font-bold flex items-center justify-center">2</span>
          <p class="text-sm text-gray-700 pt-0.5">
            Selecione <strong>"Instalar aplicativo"</strong> ou <strong>"Adicionar à Tela Inicial"</strong>
          </p>
        </li>
      </ol>

      <button
        id="btnFecharModalInstalacao"
        class="mt-6 w-full bg-taka-green-600 text-white font-semibold py-3 rounded-xl hover:bg-taka-green-700 transition-colors"
      >
        Entendi
      </button>
    </div>
  </div>
</div>

<script>
  const CHAVE_DISPENSADO = 'takanil_banner_install_dispensado_ate';
  const CHAVE_CONTAGEM   = 'takanil_banner_install_contagem';

  // Escalonamento de pausa por numero de vezes dispensado (em horas)
  const PAUSAS_HORAS = [4, 72, 168, 240, 720, 2160]; // 4h, 3d, 7d, 10d, 30d, 90d

  // Nao exibe se ja instalado (modo standalone)
  const jaInstalado =
    (window.navigator as any).standalone === true ||
    window.matchMedia('(display-mode: standalone)').matches;

  const dispensadoAte = localStorage.getItem(CHAVE_DISPENSADO);
  // Em DEV, ignora o timer para facilitar testes visuais
  const ehDev = import.meta.env.DEV;
  const dispensado = !ehDev && dispensadoAte && Date.now() < Number(dispensadoAte);

  // Apenas em telas/dispositivos moveis
  const ehMobile = window.innerWidth < 768 || /iphone|ipad|ipod|android/i.test(navigator.userAgent);
  const ehIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);

  if (!jaInstalado && !dispensado && ehMobile) {
    const banner = document.getElementById('bannerInstalar');
    const btnInstalar = document.getElementById('btnInstalar');
    const btnFechar = document.getElementById('btnFecharBanner');
    const instrucaoModal = document.getElementById('instrucaoInstalacao');
    const overlayModal = document.getElementById('overlayInstalacao');
    const btnFecharModal = document.getElementById('btnFecharModalInstalacao');
    const passosIOS = document.getElementById('passosIOS');
    const passosGeral = document.getElementById('passosGeral');

    function exibirBanner() {
      banner?.classList.remove('hidden');
    }

    function fecharBanner() {
      banner?.classList.add('hidden');

      // Lê e incrementa a contagem de vezes dispensado
      const contagem = parseInt(localStorage.getItem(CHAVE_CONTAGEM) || '0', 10);
      const novaContagem = contagem + 1;
      localStorage.setItem(CHAVE_CONTAGEM, String(novaContagem));

      // Busca a pausa correspondente (usa a ultima se ultrapassar o array)
      const pausaHoras = PAUSAS_HORAS[Math.min(contagem, PAUSAS_HORAS.length - 1)];
      const ate = Date.now() + pausaHoras * 60 * 60 * 1000;
      localStorage.setItem(CHAVE_DISPENSADO, String(ate));
    }

    function abrirModalInstrucao() {
      if (ehIOS) {
        passosIOS?.classList.remove('hidden');
        passosGeral?.classList.add('hidden');
      } else {
        passosGeral?.classList.remove('hidden');
        passosIOS?.classList.add('hidden');
      }
      instrucaoModal?.classList.remove('hidden');
    }

    function fecharModalInstrucao() {
      instrucaoModal?.classList.add('hidden');
    }

    // Exibe o banner sempre que as condicoes forem satisfeitas
    exibirBanner();

    btnInstalar?.addEventListener('click', async () => {
      const deferredPrompt = (window as any).deferredInstallPrompt;

      if (deferredPrompt) {
        // Dispara a caixa nativa de instalação diretamente no celular
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          // Zera o historico apos instalacao confirmada
          localStorage.removeItem(CHAVE_DISPENSADO);
          localStorage.removeItem(CHAVE_CONTAGEM);
          fecharBanner();
        }
        (window as any).deferredInstallPrompt = null;
      } else {
        // No iOS ou fallback (DEV/HTTP), abre o modal com o passo a passo
        abrirModalInstrucao();
      }
    });

    btnFecharModal?.addEventListener('click', fecharModalInstrucao);
    overlayModal?.addEventListener('click', fecharModalInstrucao);
    btnFechar?.addEventListener('click', fecharBanner);
    window.addEventListener('appinstalled', () => {
      localStorage.removeItem(CHAVE_DISPENSADO);
      localStorage.removeItem(CHAVE_CONTAGEM);
      banner?.classList.add('hidden');
    });
  }
</script>
