---
interface Props {
  isPublic?: boolean;
}

const { isPublic = false } = Astro.props;

const btnText = isPublic ? 'Enviar Sugestão' : 'Salvar Animal';
const formTitle = isPublic ? 'Sugerir Animal' : 'Novo Animal';
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
  <div class="flex items-center justify-between mb-6">
    <a href="/" class="text-gray-500 hover:text-gray-900 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
    </a>
    <h2 class="text-xl font-bold text-gray-800 text-center flex-1">{formTitle}</h2>
    <div class="w-6"></div> <!-- Spacer for centering -->
  </div>

  <form id="novoAnimalForm" class="space-y-5" data-is-public={isPublic ? 'true' : 'false'}>
    <!-- Foto (Câmera Nativa) -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Foto do Animal</label>
      <label for="fotoInput" class="mt-1 flex flex-col items-center justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-xl hover:border-blue-400 hover:bg-blue-50/30 transition-all bg-gray-50 cursor-pointer w-full text-center group" id="fotoContainer">
        <svg class="mx-auto h-12 w-12 text-gray-400 group-hover:text-blue-500 transition-colors pointer-events-none" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
          <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="mt-2 text-sm font-medium text-blue-600 group-hover:text-blue-700 pointer-events-none">
          Tirar Foto ou Escolher da Galeria
        </span>
        <span class="text-xs text-gray-400 mt-1 pointer-events-none">
          PNG, JPG ou WEBP (Comprimido automaticamente)
        </span>
        <input id="fotoInput" name="foto" type="file" accept="image/*" capture="environment" class="sr-only" required>
      </label>
      <div id="fotoPreviewContainer" class="hidden mt-2 relative rounded-xl overflow-hidden aspect-video bg-gray-100">
          <img id="fotoPreview" class="object-cover w-full h-full" src="" alt="Preview da foto">
          <button type="button" id="removerFoto" class="absolute top-2 right-2 bg-gray-900/70 text-white p-1.5 rounded-full backdrop-blur-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
      </div>
    </div>

    <!-- Nome -->
    <div>
      <label for="nome" class="block text-sm font-medium text-gray-700">Nome</label>
      <input type="text" name="nome" id="nome" required class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-3 border bg-gray-50" placeholder="Ex: Rabito">
    </div>

    <!-- Espécie (Toggle) -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Espécie</label>
      <div class="grid grid-cols-3 gap-2">
        <label class="cursor-pointer">
          <input type="radio" name="especie" value="Cão" class="peer sr-only" required>
          <div class="text-center p-3 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:text-blue-700 peer-checked:font-medium transition-all text-sm">
            🐶 Cão
          </div>
        </label>
        <label class="cursor-pointer">
          <input type="radio" name="especie" value="Gato" class="peer sr-only">
          <div class="text-center p-3 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:text-blue-700 peer-checked:font-medium transition-all text-sm">
            🐱 Gato
          </div>
        </label>
        <label class="cursor-pointer">
          <input type="radio" name="especie" value="Ambos/Múltiplos" class="peer sr-only">
          <div class="text-center p-3 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:text-blue-700 peer-checked:font-medium transition-all text-sm">
            🐶🐱 Ambos
          </div>
        </label>
      </div>
    </div>

    <!-- Fase de Vida (Toggle) -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Fase de Vida</label>
      <div class="grid grid-cols-3 gap-2">
        <label class="cursor-pointer">
          <input type="radio" name="fase_vida" value="Filhote" class="peer sr-only" required>
          <div class="text-center p-2 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 text-sm peer-checked:border-green-500 peer-checked:bg-green-50 peer-checked:text-green-700 peer-checked:font-medium transition-all">
            Filhote
          </div>
        </label>
        <label class="cursor-pointer">
          <input type="radio" name="fase_vida" value="Adulto" class="peer sr-only">
          <div class="text-center p-2 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 text-sm peer-checked:border-green-500 peer-checked:bg-green-50 peer-checked:text-green-700 peer-checked:font-medium transition-all">
            Adulto
          </div>
        </label>
        <label class="cursor-pointer">
          <input type="radio" name="fase_vida" value="Idoso" class="peer sr-only">
          <div class="text-center p-2 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 text-sm peer-checked:border-green-500 peer-checked:bg-green-50 peer-checked:text-green-700 peer-checked:font-medium transition-all">
            Idoso
          </div>
        </label>
      </div>
    </div>

    <!-- Peso -->
    <div>
      <label for="peso" class="block text-sm font-medium text-gray-700">Peso Aproximado(kg)</label>
      <input type="number" name="peso" id="peso" step="0.1" min="0.1" required class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-3 border bg-gray-50" placeholder="Ex: 4.5">
    </div>

    <!-- Localização / Situação -->
    <div>
      <label for="localizacao" class="block text-sm font-medium text-gray-700">Onde o animal está?</label>
      <select name="localizacao" id="localizacao" required class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-3 border bg-gray-50">
        <option value="Abrigo Takanil">Abrigo Takanil (Consome Ração)</option>
        <option value="Lar Temporário / Terceiros">Lar Temporário / Terceiros</option>
        <option value="Desaparecido / Rua">Desaparecido / Rua</option>
      </select>
    </div>

    <!-- Situação de Urgência -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Situação de Urgência</label>
      <div class="grid grid-cols-3 gap-2">
        <label class="cursor-pointer">
          <input type="radio" name="situacao_urgencia" value="Nenhuma" class="peer sr-only" required checked>
          <div class="text-center p-2 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 text-sm peer-checked:border-gray-500 peer-checked:bg-gray-100 peer-checked:text-gray-800 peer-checked:font-medium transition-all">
            Nenhuma
          </div>
        </label>
        <label class="cursor-pointer">
          <input type="radio" name="situacao_urgencia" value="Machucado/Risco" class="peer sr-only">
          <div class="text-center p-2 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 text-sm peer-checked:border-red-500 peer-checked:bg-red-50 peer-checked:text-red-700 peer-checked:font-medium transition-all">
            🚨 Machucado
          </div>
        </label>
        <label class="cursor-pointer">
          <input type="radio" name="situacao_urgencia" value="Desaparecido" class="peer sr-only">
          <div class="text-center p-2 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 text-sm peer-checked:border-yellow-500 peer-checked:bg-yellow-50 peer-checked:text-yellow-700 peer-checked:font-medium transition-all">
            🔍 Sumiu
          </div>
        </label>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <!-- Quantidade -->
      <div>
        <label for="quantidade" class="block text-sm font-medium text-gray-700">Quantidade</label>
        <input type="number" name="quantidade" id="quantidade" min="1" value="1" required class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-3 border bg-gray-50">
      </div>
      <!-- Temperamento -->
      <div>
        <label for="temperamento" class="block text-sm font-medium text-gray-700">Temperamento</label>
        <select name="temperamento" id="temperamento" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-3 border bg-gray-50">
          <option value="Não informado">Não informado</option>
          <option value="Dócil">Dócil</option>
          <option value="Brincalhão">Brincalhão</option>
          <option value="Assustado">Assustado</option>
          <option value="Bravo">Bravo</option>
          <option value="Protetor">Protetor</option>
        </select>
      </div>
    </div>

    <!-- Vacinado / Castrado -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Vacinado?</label>
        <div class="grid grid-cols-3 gap-1">
          <label class="cursor-pointer"><input type="radio" name="vacinado" value="Sim" class="peer sr-only"><div class="text-center py-2 px-1 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 text-xs peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:text-blue-700 transition-all">Sim</div></label>
          <label class="cursor-pointer"><input type="radio" name="vacinado" value="Não" class="peer sr-only"><div class="text-center py-2 px-1 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 text-xs peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:text-blue-700 transition-all">Não</div></label>
          <label class="cursor-pointer"><input type="radio" name="vacinado" value="Não sei" class="peer sr-only" checked><div class="text-center py-2 px-1 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 text-xs peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:text-blue-700 transition-all">?</div></label>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Castrado?</label>
        <div class="grid grid-cols-3 gap-1">
          <label class="cursor-pointer"><input type="radio" name="castrado" value="Sim" class="peer sr-only"><div class="text-center py-2 px-1 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 text-xs peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:text-blue-700 transition-all">Sim</div></label>
          <label class="cursor-pointer"><input type="radio" name="castrado" value="Não" class="peer sr-only"><div class="text-center py-2 px-1 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 text-xs peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:text-blue-700 transition-all">Não</div></label>
          <label class="cursor-pointer"><input type="radio" name="castrado" value="Não sei" class="peer sr-only" checked><div class="text-center py-2 px-1 rounded-xl border border-gray-200 bg-gray-50 text-gray-600 text-xs peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:text-blue-700 transition-all">?</div></label>
        </div>
      </div>
    </div>

    <!-- Submit -->
    <div class="pt-4">
      <button type="submit" id="submitBtn" class="w-full flex justify-center py-3.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 active:scale-[0.98] transition-all disabled:opacity-70">
        <span>{btnText}</span>
        <svg id="loadingSpinner" class="animate-spin ml-2 h-5 w-5 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </button>
    </div>

    <!-- Mensagem de erro/sucesso -->
    <div id="statusMessage" class="hidden text-center text-sm font-medium p-3 rounded-xl mt-4"></div>
  </form>
</div>

<script>
  import { supabase } from '../lib/supabaseClient';

  const form = document.getElementById('novoAnimalForm') as HTMLFormElement;
  
  // Como o script roda apenas uma vez no cliente (Astro bundling),
  // se houver mais de um form na mesma view (não tem, mas boa prática)
  // seria ideal usar querySelectorAll. Aqui sabemos que há apenas 1.
  if (form) {
    const isPublic = form.getAttribute('data-is-public') === 'true';

    const fotoInput = document.getElementById('fotoInput') as HTMLInputElement;
    const fotoPreview = document.getElementById('fotoPreview') as HTMLImageElement;
    const fotoContainer = document.getElementById('fotoContainer');
    const fotoPreviewContainer = document.getElementById('fotoPreviewContainer');
    const removerFotoBtn = document.getElementById('removerFoto');
    
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const submitText = submitBtn.querySelector('span');
    const spinner = document.getElementById('loadingSpinner');
    const statusMessage = document.getElementById('statusMessage');

    // Preview de foto
    fotoInput.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (e) => {
          fotoPreview.src = e.target?.result as string;
          fotoContainer?.classList.add('hidden');
          fotoPreviewContainer?.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
      }
    });

    // Remover foto
    removerFotoBtn?.addEventListener('click', () => {
      fotoInput.value = '';
      fotoPreview.src = '';
      fotoContainer?.classList.remove('hidden');
      fotoPreviewContainer?.classList.add('hidden');
    });

    // Função para comprimir a imagem antes de subir
    async function comprimirImagem(file: File): Promise<File> {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            const MAX_WIDTH = 800;
            const MAX_HEIGHT = 800;
            let width = img.width;
            let height = img.height;

            if (width > height) {
              if (width > MAX_WIDTH) {
                height *= MAX_WIDTH / width;
                width = MAX_WIDTH;
              }
            } else {
              if (height > MAX_HEIGHT) {
                width *= MAX_HEIGHT / height;
                height = MAX_HEIGHT;
              }
            }
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx?.drawImage(img, 0, 0, width, height);
            
            canvas.toBlob((blob) => {
              if (blob) {
                resolve(new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", { type: 'image/jpeg', lastModified: Date.now() }));
              } else {
                resolve(file);
              }
            }, 'image/jpeg', 0.8);
          };
          img.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);
      });
    }

    const showStatus = (msg: string, type: 'success' | 'error') => {
      if(!statusMessage) return;
      statusMessage.textContent = msg;
      statusMessage.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'bg-green-50', 'text-green-700');
      if (type === 'error') {
        statusMessage.classList.add('bg-red-50', 'text-red-700');
      } else {
        statusMessage.classList.add('bg-green-50', 'text-green-700');
      }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      statusMessage?.classList.add('hidden');
      
      const formData = new FormData(form);
      const nome = formData.get('nome') as string;
      const especie = formData.get('especie') as string;
      const fase_vida = formData.get('fase_vida') as string;
      const peso = parseFloat(formData.get('peso') as string);
      const localizacao = formData.get('localizacao') as string;
      const quantidade = parseInt(formData.get('quantidade') as string) || 1;
      const situacao_urgencia = formData.get('situacao_urgencia') as string || 'Nenhuma';
      const vacinado = formData.get('vacinado') as string || 'Não sei';
      const castrado = formData.get('castrado') as string || 'Não sei';
      const temperamento = formData.get('temperamento') as string || 'Não informado';
      const fotoFile = formData.get('foto') as File;

      if (!nome || !especie || !fase_vida || isNaN(peso) || peso <= 0 || !localizacao || !fotoFile.size) {
        showStatus('Por favor, preencha todos os campos e adicione uma foto.', 'error');
        return;
      }

      try {
        // UX: Loading
        submitBtn.disabled = true;
        if(submitText) submitText.textContent = isPublic ? 'Enviando...' : 'Salvando...';
        spinner?.classList.remove('hidden');

        // 1. Comprimir e Upload da foto
        const fotoComprimida = await comprimirImagem(fotoFile);
        console.log(`[Hub Takanil] 📸 Foto original: ${(fotoFile.size / 1024).toFixed(1)} KB -> Comprimida: ${(fotoComprimida.size / 1024).toFixed(1)} KB`);
        const fileName = `${Date.now()}-${Math.random().toString(36).substring(7)}.jpg`;

        const { error: uploadError } = await supabase.storage
          .from('animais')
          .upload(fileName, fotoComprimida, {
            cacheControl: '3600',
            upsert: true
          });

        if (uploadError) throw new Error('Erro ao fazer upload da foto: ' + uploadError.message);

        // 2. Pegar URL pública
        const { data: publicUrlData } = supabase.storage
          .from('animais')
          .getPublicUrl(fileName);

        const imagem_url = publicUrlData.publicUrl;

        // 3. Salvar no banco (Admins aprovam direto, Público fica pendente)
        const status_moderacao = isPublic ? 'pendente' : 'aprovado';
        
        const { error: dbError } = await supabase
          .from('animais')
          .insert([
            {
              nome,
              especie,
              fase_vida,
              peso,
              localizacao,
              quantidade,
              situacao_urgencia,
              vacinado,
              castrado,
              temperamento,
              imagem_url,
              status_moderacao
            }
          ]);

        if (dbError) throw new Error('Erro ao salvar no banco: ' + dbError.message);

        // Sucesso!
        showStatus(
          isPublic 
            ? '💖 Muito obrigado por ajudar a Takanil! Sua sugestão foi enviada e será avaliada com carinho pela nossa equipe em breve.' 
            : 'Animal cadastrado com sucesso!', 
          'success'
        );
        form.reset();
        
        // Limpar preview
        fotoPreview.src = '';
        fotoContainer?.classList.remove('hidden');
        fotoPreviewContainer?.classList.add('hidden');

        // Voltar pra home após 2s
        setTimeout(() => {
          window.location.href = '/';
        }, 2000);

      } catch (err: any) {
        console.error(err);
        showStatus(err.message || 'Ocorreu um erro inesperado.', 'error');
      } finally {
        // Restaurar botão
        submitBtn.disabled = false;
        if(submitText) submitText.textContent = isPublic ? 'Enviar Sugestão' : 'Salvar Animal';
        spinner?.classList.add('hidden');
      }
    });
  }
</script>
