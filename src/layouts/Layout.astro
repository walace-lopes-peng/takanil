---
interface Props {
  title: string;
}

const { title } = Astro.props;

// Lógica para detectar a rota ativa (Navegação Inferior)
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content="App para gestão e transparência da ONG Takanil" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Takanil" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans min-h-screen antialiased flex flex-col">
    <!-- Navbar simples provisória -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
      <div class="max-w-md mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/" class="font-bold text-lg text-gray-800 hover:text-blue-600 transition-colors">Hub Takanil</a>
        <div id="authContainer" class="text-sm font-medium">
          <!-- Inserido via JS -->
        </div>
      </div>
    </header>

    <!-- Conteúdo principal -->
    <main class="flex-1 w-full max-w-md mx-auto p-4 flex flex-col pb-24">
      <slot />
    </main>

    <!-- Menu de Navegação Inferior (Bottom Tab Bar) -->
    <nav id="bottomNav" style="display: none;" class="fixed bottom-0 w-full bg-white border-t border-gray-200 z-40 pb-safe">
      <div class="max-w-md mx-auto h-16 flex justify-around items-center">
        <!-- Tab: Animais (Home) -->
        <a href="/" class={`flex flex-col items-center justify-center w-full h-full gap-1 transition-colors ${currentPath === '/' ? 'text-blue-600' : 'text-gray-400 hover:text-gray-600'}`}>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={currentPath === '/' ? "2.5" : "2"}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span class="text-[10px] font-medium">Animais</span>
        </a>

        <!-- Tab: Finanças -->
        <a href="/financas" id="financasTab" style="display: none;" class={`flex flex-col items-center justify-center w-full h-full gap-1 transition-colors ${currentPath.startsWith('/financas') ? 'text-blue-600' : 'text-gray-400 hover:text-gray-600'}`}>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={currentPath.startsWith('/financas') ? "2.5" : "2"}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-[10px] font-medium">Finanças</span>
        </a>
      </div>
    </nav>

    <script>
      import { supabase, getUserRole } from '../lib/supabaseClient';

      const authContainer = document.getElementById('authContainer');
      const financasTab = document.getElementById('financasTab');
      const bottomNav = document.getElementById('bottomNav');

      async function renderAuthStatus() {
        const { data: { session } } = await supabase.auth.getSession();
        
        if (session) {
          const role = await getUserRole();
          if (role === 'adm' || role === 'dev') {
            if (bottomNav) bottomNav.style.display = 'block';
            if (financasTab) financasTab.style.display = 'flex';
          }

          if (authContainer) {
            authContainer.innerHTML = `
            <button id="logoutBtn" class="text-gray-500 hover:text-red-600 transition-colors flex items-center gap-1">
              <span>Sair</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
            </button>
          `;
          
          document.getElementById('logoutBtn')?.addEventListener('click', async () => {
            await supabase.auth.signOut();
            window.location.href = '/login';
          });
          }
        } else {
          if (authContainer) {
            authContainer.innerHTML = `
              <a href="/login" class="text-blue-600 hover:text-blue-800 transition-colors flex items-center gap-1">
                <span>Entrar</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                </svg>
              </a>
            `;
          }
          if (financasTab) financasTab.style.display = 'none';
          if (bottomNav) bottomNav.style.display = 'none';
        }
      }

      // Check on load
      renderAuthStatus();
      
      // Update if auth state changes
      supabase.auth.onAuthStateChange(() => {
        renderAuthStatus();
      });
    </script>
  </body>
</html>

<style is:global>
  /* Variáveis e resets adicionais, se necessário */
  :root {
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
  }
</style>
