---
import BannerInstalar from '../components/BannerInstalar.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Lógica para detectar a rota ativa (Navegação Inferior)
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content="App para gestão e transparência da ONG Takanil" />
    <link rel="icon" type="image/jpeg" href="/assets/takanil-icon-png.jpg" />
    <link rel="manifest" href="/manifest.json" />
    
    <!-- Google Fonts: Fredoka -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&display=swap" rel="stylesheet">
    
    <meta name="theme-color" content="#37b08d" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Takanil" />
    <title>{title}</title>
  </head>
  <body class="bg-taka-green-50 text-gray-900 font-sans min-h-screen antialiased flex flex-col">
    <!-- Navbar simples provisória -->
    <header class="bg-taka-green-600 text-white shadow-sm sticky top-0 z-50">
      <div class="max-w-md mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/" class="font-bold text-lg hover:text-taka-green-100 transition-colors flex items-center gap-2">
          <img src="/assets/takanil-icon-png.jpg" alt="Logo Takanil" class="w-8 h-8 rounded-full object-cover border-2 border-white/20" />
          Hub Takanil
        </a>
        <div class="flex items-center gap-3">
          <!-- Botão Cãotribuição -->
          <button id="btnOpenPixDrawer" class="rounded-full border border-taka-green-300 hover:scale-105 active:scale-95 transition-transform flex items-center justify-center bg-white text-taka-orange-500 shadow-sm px-3 py-1.5 gap-1.5" title="Fazer uma doação">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
            </svg>
            <span class="text-[11px] font-bold uppercase tracking-wider">Cãotribuição</span>
          </button>
          
          <div id="authContainer" class="text-sm font-medium">
            <!-- Inserido via JS -->
          </div>
        </div>
      </div>
    </header>

    <!-- Top Drawer: Cãotribuição -->
    <div id="caotribuicaoDrawer" class="fixed inset-0 z-40 pointer-events-none transition-all duration-300">
      <!-- Overlay escuro -->
      <div id="drawerOverlay" class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-300 pointer-events-none"></div>
      
      <!-- Painel Retrátil -->
      <div id="drawerPanel" class="absolute top-14 w-full max-w-md left-1/2 -translate-x-1/2 bg-white/95 backdrop-blur-xl rounded-b-3xl shadow-2xl -translate-y-[150%] transition-transform duration-300 pointer-events-none border-b border-taka-green-100">
        <div class="p-6 flex flex-col gap-4">
          <!-- Fechar -->
          <button id="btnCloseDrawer" class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 transition-colors p-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>

          <!-- Títulos -->
          <div class="text-center mt-2">
            <h2 class="text-xl font-bold text-taka-orange-500 mb-1">💛 Cãotribuição</h2>
            <p class="text-sm text-gray-600">Sua doação salva vidas! Apoie os animais.</p>
          </div>

          <!-- Ações -->
          <div class="flex flex-col gap-3 mt-3">
            <!-- Copiar Pix -->
            <button id="btnCopyPix" class="w-full bg-taka-green-50 hover:bg-taka-green-100 border border-taka-green-200 text-taka-green-800 rounded-xl px-4 py-3 font-semibold flex items-center justify-between transition-colors shadow-sm active:scale-[0.98]">
              <div class="flex items-center gap-3">
                <img src="/assets/pix-icon-png.png" alt="Pix" class="w-5 h-5 object-contain" />
                <span id="pixKeyText" class="tracking-widest">35998687395</span>
              </div>
              <svg id="copyIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-taka-green-600 transition-transform hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
              <span id="copySuccessLabel" class="text-sm text-taka-green-600 hidden font-bold">Copiado!</span>
            </button>

            <!-- Enviar Comprovante -->
            <a href="https://wa.me/5535998687395" target="_blank" rel="noopener noreferrer" class="w-full bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 rounded-xl px-4 py-3 font-medium flex items-center justify-center gap-1 transition-colors shadow-sm active:scale-[0.98]">
              <img src="/assets/whatspp-icon-png.png" alt="WhatsApp" class="w-10 h-10 object-contain scale-[1.8]" />
              <span>Enviar comprovante</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Banner de instalacao PWA (aparece apenas em mobile nao instalado) -->
    <BannerInstalar />

    <!-- Conteúdo principal -->
    <main class="flex-1 w-full max-w-md mx-auto p-4 flex flex-col pb-24">
      <slot />
    </main>

    <!-- Menu de Navegação Inferior (Bottom Tab Bar) -->
    <nav id="bottomNav" style="display: none;" class="fixed bottom-0 w-full bg-white/80 backdrop-blur-md border-t border-gray-200 z-40 pb-safe">
      <div class="max-w-md mx-auto h-16 flex justify-around items-center">
        <!-- Tab: Animais (Home) -->
        <a href="/" class={`flex flex-col items-center justify-center w-full h-full gap-1 transition-colors ${currentPath === '/' ? 'text-taka-green-600' : 'text-gray-400 hover:text-gray-600'}`}>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={currentPath === '/' ? "2.5" : "2"}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span class="text-[10px] font-medium">Animais</span>
        </a>

        <!-- Tab: Finanças -->
        <a href="/financas" id="financasTab" style="display: none;" class={`flex flex-col items-center justify-center w-full h-full gap-1 transition-colors ${currentPath.startsWith('/financas') ? 'text-taka-green-600' : 'text-gray-400 hover:text-gray-600'}`}>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={currentPath.startsWith('/financas') ? "2.5" : "2"}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-[10px] font-medium">Finanças</span>
        </a>
      </div>
    </nav>

    <script>
      import { supabase, getUserRole } from '../lib/supabaseClient';

      const authContainer = document.getElementById('authContainer');
      const financasTab = document.getElementById('financasTab');
      const bottomNav = document.getElementById('bottomNav');

      // Lógica do Painel Cãotribuição
      const btnOpenPix = document.getElementById('btnOpenPixDrawer');
      const btnClosePix = document.getElementById('btnCloseDrawer');
      const drawerContainer = document.getElementById('caotribuicaoDrawer');
      const drawerOverlay = document.getElementById('drawerOverlay');
      const drawerPanel = document.getElementById('drawerPanel');
      const btnCopyPix = document.getElementById('btnCopyPix');
      
      const toggleDrawer = (open: boolean) => {
        if (!drawerContainer || !drawerOverlay || !drawerPanel) return;
        if (open) {
          drawerContainer.classList.remove('pointer-events-none');
          drawerOverlay.classList.remove('opacity-0', 'pointer-events-none');
          drawerOverlay.classList.add('opacity-100', 'pointer-events-auto');
          drawerPanel.classList.remove('-translate-y-[150%]', 'pointer-events-none');
          drawerPanel.classList.add('translate-y-0', 'pointer-events-auto');
        } else {
          drawerOverlay.classList.remove('opacity-100', 'pointer-events-auto');
          drawerOverlay.classList.add('opacity-0', 'pointer-events-none');
          drawerPanel.classList.remove('translate-y-0', 'pointer-events-auto');
          drawerPanel.classList.add('-translate-y-[150%]', 'pointer-events-none');
          setTimeout(() => {
            drawerContainer.classList.add('pointer-events-none');
          }, 300);
        }
      };

      if (btnOpenPix) btnOpenPix.addEventListener('click', () => toggleDrawer(true));
      if (btnClosePix) btnClosePix.addEventListener('click', () => toggleDrawer(false));
      if (drawerOverlay) drawerOverlay.addEventListener('click', () => toggleDrawer(false));

      if (btnCopyPix) {
        btnCopyPix.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText('35998687395');
            const icon = document.getElementById('copyIcon');
            const label = document.getElementById('copySuccessLabel');
            if (icon && label) {
              icon.classList.add('hidden');
              label.classList.remove('hidden');
              setTimeout(() => {
                icon.classList.remove('hidden');
                label.classList.add('hidden');
              }, 2000);
            }
          } catch (err) {
            console.error('Falha ao copiar:', err);
            alert('Falha ao copiar. Chave: 35998687395');
          }
        });
      }

      async function renderAuthStatus() {
        const { data: { session } } = await supabase.auth.getSession();
        
        if (session) {
          const role = await getUserRole();
          if (role === 'adm' || role === 'dev') {
            if (bottomNav) bottomNav.style.display = 'block';
            if (financasTab) financasTab.style.display = 'flex';
          }

          if (authContainer) {
            authContainer.innerHTML = `
            <button id="logoutBtn" class="text-white/80 hover:text-white transition-colors flex items-center gap-1">
              <span>Sair</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
            </button>
          `;
          
          document.getElementById('logoutBtn')?.addEventListener('click', async () => {
            await supabase.auth.signOut();
            window.location.href = '/login';
          });
          }
        } else {
          if (authContainer) {
            authContainer.innerHTML = `
              <a href="/login" class="text-white hover:text-taka-green-100 transition-colors flex items-center gap-1">
                <span>Entrar</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                </svg>
              </a>
            `;
          }
          if (financasTab) financasTab.style.display = 'none';
          if (bottomNav) bottomNav.style.display = 'none';
        }
      }

      // Check on load
      renderAuthStatus();
      
      // Update if auth state changes
      supabase.auth.onAuthStateChange(() => {
        renderAuthStatus();
      });
    </script>
  </body>
</html>

<style is:global>
  /* Variáveis e resets adicionais, se necessário */
  :root {
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
  }
</style>
